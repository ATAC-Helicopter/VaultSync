<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VaultSync.Core\VaultSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Namotion.Reflection" Version="3.4.3" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Tool packaging metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vaultsync</ToolCommandName>
    <PackageId>vaultsync.cli</PackageId>

    <!-- Version info -->
    <Version>0.8.1</Version>
    <PackageVersion>0.8.1</PackageVersion>
    <AssemblyVersion>0.8.1.0</AssemblyVersion>
    <FileVersion>0.8.1.0</FileVersion>
    <AssemblyInformationalVersion>0.8.1</AssemblyInformationalVersion>
    <!-- Package info -->
    <Authors>Flavio Giacchetti</Authors>
    <Company>Flavio Giacchetti</Company>
    <Copyright>Copyright (c) 2025-2026 Flavio Giacchetti</Copyright>
    <Description>VaultSync CLI — snapshot, sync, and verify project folders with rsync-backed mirroring.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>bin/ToolPackages</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/ATAC-Helicopter/VaultSync</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ATAC-Helicopter/VaultSync</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensure README is included in the package -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\presets\*.vaultsyncignore">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
