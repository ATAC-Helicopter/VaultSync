<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VaultSync.Core\VaultSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.53.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Tool packaging metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vaultsync</ToolCommandName>
    <PackageId>vaultsync.cli</PackageId>

    <!-- Version info -->
    <Version>0.8.1</Version>
    <PackageVersion>0.8.1</PackageVersion>
    <AssemblyVersion>0.8.1.0</AssemblyVersion>
    <FileVersion>0.8.1.0</FileVersion>
    <AssemblyInformationalVersion>0.8.1</AssemblyInformationalVersion>
    <!-- Package info -->
    <Authors>VaultSync</Authors>
    <Company>VaultSync</Company>
    <Description>VaultSync CLI — snapshot, sync, and verify project folders with rsync-backed mirroring.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>bin/ToolPackages</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

