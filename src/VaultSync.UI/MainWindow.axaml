<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:viewsControls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.MainWindow"
    x:DataType="vm:AppViewModel"
    Width="1200" Height="800"
    Title="{infra:LocalizedString Key=Shell.Title}">

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*">

    <Border Grid.RowSpan="2" Grid.Column="0" Classes="sidebar" Padding="16,18,16,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,10,4,16">
        <Border Classes="shell-banner">
          <StackPanel Spacing="4">
            <TextBlock Text="{infra:LocalizedString Key=Shell.Title}"
                       Foreground="{DynamicResource ShellHeaderTextBrush}"
                         FontSize="20"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{infra:LocalizedString Key=Shell.Tagline}"
                         Foreground="{DynamicResource ShellHeaderTextBrush}"
                         FontSize="12"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{infra:LocalizedString Key=Shell.Navigation}"
                     Foreground="{StaticResource TextSecondary}"
                     Margin="2,2,0,0"
                     FontSize="12" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12,14,12,10"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0">
          <StackPanel Spacing="2">
            <TextBlock Text="{CompiledBinding FooterProductDisplay}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock Text="{CompiledBinding FooterCopyrightDisplay}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="4" Margin="0,0,0,10">
          <Button Classes="nav" Command="{CompiledBinding NavigateDashboard}">
            <TextBlock Text="{infra:LocalizedString Key=Nav.Dashboard}"/>
          </Button>

          <Button Classes="nav" Command="{CompiledBinding NavigateProjects}">
            <TextBlock Text="{infra:LocalizedString Key=Nav.Projects}"/>
          </Button>

          <Button Classes="nav" Command="{CompiledBinding NavigateBackups}">
            <TextBlock Text="{infra:LocalizedString Key=Nav.Backups}"/>
          </Button>

          <Button Classes="nav" Command="{CompiledBinding NavigateSettings}">
            <TextBlock Text="{infra:LocalizedString Key=Nav.Settings}"/>
          </Button>
        </StackPanel>

      </DockPanel>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Classes="header" Padding="18,14">
      <StackPanel Spacing="8">
        <StackPanel>
          <TextBlock Text="{CompiledBinding HeaderTitle}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="{CompiledBinding HeaderKicker}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Margin="0,4,0,0"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                IsVisible="{CompiledBinding ShowUpdateBanner}">
          <Grid ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="6">
            <StackPanel Grid.RowSpan="2" Spacing="4">
              <TextBlock Text="{CompiledBinding UpdateBannerMessage}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{CompiledBinding UpdateTooltip}" />
              <TextBlock Text="{CompiledBinding PatchStatusMessage}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="12"
                         IsVisible="{CompiledBinding ShowPatchStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
              <Button Command="{CompiledBinding InstallPatchCommand}"
                      Content="{CompiledBinding InstallButtonText}"
                      MinWidth="130"
                      HorizontalAlignment="Right"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="{DynamicResource TextOnPillBrush}"
                      BorderBrush="{DynamicResource AccentBrush}"
                      IsVisible="{CompiledBinding ShowPatchButton}" />
              <Button Command="{CompiledBinding OpenReleasePageCommand}"
                      Content="{CompiledBinding ReleaseActionText}"
                      MinWidth="130"
                      HorizontalAlignment="Right"
                      IsEnabled="{CompiledBinding IsReleaseActionEnabled}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}"
                      IsVisible="{CompiledBinding ShowInstallerFallback}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <Button Command="{CompiledBinding SkipUpdateCommand}"
                      Content="{infra:LocalizedString Key=Update.SkipVersion}"
                      IsEnabled="{CompiledBinding CanSkipUpdate}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}" />
              <Button Command="{CompiledBinding DismissUpdateBannerCommand}"
                      Content="{infra:LocalizedString Key=Update.CloseBanner}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Padding="16">
      <ContentControl x:Name="MainContent" Content="{CompiledBinding CurrentView}"/>
    </Border>

    <!-- Global bottom-right toast notifications covering the whole window -->
    <viewsControls:ToastHost Grid.RowSpan="2" Grid.ColumnSpan="2" />

  </Grid>
</Window>
