<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:views="clr-namespace:VaultSync.UI.Views"
    xmlns:viewsControls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
    xmlns:ui="clr-namespace:VaultSync.UI"
    x:Class="VaultSync.UI.MainWindow"
    x:DataType="vm:AppViewModel"
    Width="1200" Height="800"
    MinWidth="600" MinHeight="500"
    Title="{infra:LocalizedString Key=Shell.Title}">

  <Window.Styles>
    <Style Selector="Border.pulse-ring">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*" ColumnDefinitions="260,*">

    <Border x:Name="SidebarRoot" Grid.RowSpan="2" Grid.Column="0" Classes="sidebar" Padding="16,18,16,14">
      <DockPanel>
        <StackPanel x:Name="SidebarTopSection"
                    DockPanel.Dock="Top"
                    Spacing="8"
                    Margin="4,10,4,16">
          <Button x:Name="SidebarToggleButton"
                  Classes="sidebar-toggle"
                  Click="OnToggleSidebar"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,0,0,2"
                  ToolTip.Tip="{infra:LocalizedString Key=Shell.SidebarCollapse}">
            <Viewbox Width="13" Height="13" Stretch="Uniform">
              <shapes:Path x:Name="SidebarToggleGlyph"
                           Data="M9.5 2 L4.5 7 L9.5 12"
                           Stroke="{DynamicResource TextPrimaryBrush}"
                           StrokeThickness="1.8"
                           StrokeLineCap="Round"
                           Fill="Transparent" />
            </Viewbox>
          </Button>

        <Border x:Name="ShellCompactBadge"
                Classes="shell-monogram"
                IsVisible="False"
                ToolTip.Tip="{infra:LocalizedString Key=Shell.SidebarCompactHint}">
          <Grid>
            <TextBlock Text="{infra:LocalizedString Key=Shell.SidebarCompactLabel}"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Width="8"
                    Height="8"
                    CornerRadius="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Background="{DynamicResource AccentBrush}" />
          </Grid>
        </Border>

        <Border x:Name="ShellBanner" Classes="shell-banner">
          <StackPanel Spacing="4">
            <TextBlock Text="{infra:LocalizedString Key=Shell.Title}"
                       Foreground="{DynamicResource ShellHeaderTextBrush}"
                         FontSize="20"
                         FontWeight="SemiBold"/>
              <TextBlock Text="{infra:LocalizedString Key=Shell.Tagline}"
                         Foreground="{DynamicResource ShellHeaderTextBrush}"
                         FontSize="12"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="NavigationHeader"
                     Text="{infra:LocalizedString Key=Shell.Navigation}"
                     Foreground="{StaticResource TextSecondary}"
                     Margin="2,2,0,0"
                     FontSize="12" />
        </StackPanel>

        <Border x:Name="SidebarFooter"
                DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12,14,12,10"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,1,0,0">
          <StackPanel Spacing="2">
            <TextBlock Text="{CompiledBinding FooterProductDisplay}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock Text="{CompiledBinding FooterCopyrightDisplay}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border x:Name="SidebarDestinations"
                DockPanel.Dock="Bottom"
                Margin="0,8,0,4"
                Padding="6"
                CornerRadius="12"
                Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Tray.Destinations.Title}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="10"
                       FontWeight="SemiBold" />
            <TextBlock Text="{infra:LocalizedString Key=Tray.Destinations.None}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="9"
                       IsVisible="{Binding BackupsViewModel.HasActiveDestinationStatuses, Converter={StaticResource BoolInvertConverter}}" />
            <ItemsControl ItemsSource="{CompiledBinding BackupsViewModel.ActiveDestinationStatuses}"
                          IsVisible="{CompiledBinding BackupsViewModel.HasActiveDestinationStatuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <viewsControls:DestinationStatusCard Classes="compact" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel x:Name="NavButtonsPanel" Spacing="4" Margin="0,0,0,10">
          <Button x:Name="NavDashboardButton" Classes="nav" Command="{CompiledBinding NavigateDashboard}" ToolTip.Tip="{infra:LocalizedString Key=Nav.Dashboard}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border x:Name="NavDashboardIconBadge" Classes="nav-icon-badge">
                <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <shapes:Path Data="M10,2.5 L17.5,9 V17 H12.75 V12 H7.25 V17 H2.5 V9 Z"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               StrokeThickness="1.6"
                               Fill="Transparent" />
                </Viewbox>
              </Border>
              <TextBlock x:Name="NavDashboardText" Text="{infra:LocalizedString Key=Nav.Dashboard}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="NavProjectsButton" Classes="nav" Command="{CompiledBinding NavigateProjects}" ToolTip.Tip="{infra:LocalizedString Key=Nav.Projects}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border x:Name="NavProjectsIconBadge" Classes="nav-icon-badge">
                <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <shapes:Path Data="M2.5,6.5 H8 L10,8.5 H17.5 V15.5 C17.5,16.33 16.83,17 16,17 H4 C3.17,17 2.5,16.33 2.5,15.5 Z M2.5,6.5 C2.5,5.67 3.17,5 4,5 H7.25 C7.65,5 8.03,5.16 8.31,5.44 L9.56,6.69"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               StrokeThickness="1.6"
                               Fill="Transparent" />
                </Viewbox>
              </Border>
              <TextBlock x:Name="NavProjectsText" Text="{infra:LocalizedString Key=Nav.Projects}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="NavBackupsButton" Classes="nav" Command="{CompiledBinding NavigateBackups}" ToolTip.Tip="{infra:LocalizedString Key=Nav.Backups}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border x:Name="NavBackupsIconBadge" Classes="nav-icon-badge">
                <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <shapes:Path Data="M3 5C3 3.89543 3.89543 3 5 3H13.3787C13.9091 3 14.4178 3.21071 14.7929 3.58579L16.4142 5.20711C16.7893 5.58218 17 6.09089 17 6.62132V15C17 16.1046 16.1046 17 15 17H5C3.89543 17 3 16.1046 3 15V5ZM5 4C4.44772 4 4 4.44772 4 5V15C4 15.5523 4.44772 16 5 16V11.5C5 10.6716 5.67157 10 6.5 10H13.5C14.3284 10 15 10.6716 15 11.5V16C15.5523 16 16 15.5523 16 15V6.62132C16 6.3561 15.8946 6.10175 15.7071 5.91421L14.0858 4.29289C13.8983 4.10536 13.6439 4 13.3787 4H13V6.5C13 7.32843 12.3284 8 11.5 8H7.5C6.67157 8 6 7.32843 6 6.5V4H5ZM7 4V6.5C7 6.77614 7.22386 7 7.5 7H11.5C11.7761 7 12 6.77614 12 6.5V4H7ZM8.5 12.5H11.5V13.5H8.5V12.5Z"
                               Fill="{DynamicResource TextPrimaryBrush}" />
                </Viewbox>
              </Border>
              <TextBlock x:Name="NavBackupsText" Text="{infra:LocalizedString Key=Nav.Backups}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button x:Name="NavSettingsButton" Classes="nav" Command="{CompiledBinding NavigateSettings}" ToolTip.Tip="{infra:LocalizedString Key=Nav.Settings}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border x:Name="NavSettingsIconBadge" Classes="nav-icon-badge">
                <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <shapes:Path Data="M19.14,12.94A7.43,7.43 0 0,0 19.19,12A7.43,7.43 0 0,0 19.14,11.06L21.19,9.47C21.37,9.33 21.42,9.07 21.3,8.87L19.3,5.4C19.18,5.18 18.92,5.1 18.69,5.17L16.27,6.14C15.74,5.74 15.16,5.41 14.53,5.17L14.16,2.57C14.12,2.33 13.91,2.15 13.67,2.15H10.67C10.43,2.15 10.22,2.33 10.18,2.57L9.81,5.17C9.18,5.41 8.6,5.74 8.07,6.14L5.65,5.17C5.42,5.1 5.16,5.18 5.04,5.4L3.04,8.87C2.92,9.07 2.97,9.33 3.15,9.47L5.2,11.06C5.15,11.37 5.12,11.69 5.12,12A7.43,7.43 0 0,0 5.2,12.94L3.15,14.53C2.97,14.67 2.92,14.93 3.04,15.13L5.04,18.6C5.16,18.82 5.42,18.9 5.65,18.83L8.07,17.86C8.6,18.26 9.18,18.59 9.81,18.83L10.18,21.43C10.22,21.67 10.43,21.85 10.67,21.85H13.67C13.91,21.85 14.12,21.67 14.16,21.43L14.53,18.83C15.16,18.59 15.74,18.26 16.27,17.86L18.69,18.83C18.92,18.9 19.18,18.82 19.3,18.6L21.3,15.13C21.42,14.93 21.37,14.67 21.19,14.53L19.14,12.94 M12.17,15.5A3.5,3.5 0 0,1 8.67,12A3.5,3.5 0 0,1 12.17,8.5A3.5,3.5 0 0,1 15.67,12A3.5,3.5 0 0,1 12.17,15.5Z"
                               Stroke="{DynamicResource TextPrimaryBrush}"
                               StrokeThickness="1.4"
                               StrokeLineCap="Round"
                               Fill="Transparent" />
                </Viewbox>
              </Border>
              <TextBlock x:Name="NavSettingsText" Text="{infra:LocalizedString Key=Nav.Settings}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

      </DockPanel>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Classes="header" Padding="18,14">
      <StackPanel Spacing="8">
        <StackPanel>
          <TextBlock Text="{CompiledBinding HeaderTitle}" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="{CompiledBinding HeaderKicker}" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Margin="0,4,0,0"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                IsVisible="{CompiledBinding ShowUpdateBanner}">
          <Grid ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="6">
            <StackPanel Grid.RowSpan="2" Spacing="4">
              <TextBlock Text="{CompiledBinding UpdateBannerMessage}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{CompiledBinding UpdateTooltip}" />
              <TextBlock Text="{CompiledBinding PatchStatusMessage}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="12"
                         IsVisible="{CompiledBinding ShowPatchStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
              <Button Command="{CompiledBinding InstallPatchCommand}"
                      Content="{CompiledBinding InstallButtonText}"
                      MinWidth="130"
                      HorizontalAlignment="Right"
                      Background="{DynamicResource AccentBrush}"
                      Foreground="{DynamicResource TextOnPillBrush}"
                      BorderBrush="{DynamicResource AccentBrush}"
                      IsVisible="{CompiledBinding ShowPatchButton}" />
              <Button Command="{CompiledBinding OpenReleasePageCommand}"
                      Content="{CompiledBinding ReleaseActionText}"
                      MinWidth="130"
                      HorizontalAlignment="Right"
                      IsEnabled="{CompiledBinding IsReleaseActionEnabled}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}"
                      IsVisible="{CompiledBinding ShowInstallerFallback}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <Button Command="{CompiledBinding SkipUpdateCommand}"
                      Content="{infra:LocalizedString Key=Update.SkipVersion}"
                      IsEnabled="{CompiledBinding CanSkipUpdate}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}" />
              <Button Command="{CompiledBinding DismissUpdateBannerCommand}"
                      Content="{infra:LocalizedString Key=Update.CloseBanner}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,6,0,0"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="1"
                IsVisible="{CompiledBinding ShowSoftCrashBanner}">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <TextBlock Text="{CompiledBinding SoftCrashBannerMessage}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Command="{CompiledBinding CopySoftCrashLogCommand}"
                      Content="{CompiledBinding SoftCrashCopyLabel}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}"
                      IsVisible="{CompiledBinding CanCopySoftCrashLog}" />
              <Button Command="{CompiledBinding DismissSoftCrashBannerCommand}"
                      Content="{CompiledBinding SoftCrashDismissLabel}"
                      Background="{DynamicResource Surface1}"
                      BorderBrush="{DynamicResource BorderSoft}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Padding="16">
      <Grid>
        <Panel IsVisible="{Binding IsDashboardActive}">
          <views:DashboardView DataContext="{Binding DashboardViewModel}" />
        </Panel>
        <Panel IsVisible="{Binding IsProjectsViewActive}">
          <views:ProjectsView DataContext="{Binding ProjectsViewModel}" />
        </Panel>
        <Panel IsVisible="{Binding IsBackupsViewActive}">
          <views:BackupsView DataContext="{Binding BackupsViewModel}" />
        </Panel>
        <Panel IsVisible="{Binding IsSettingsActive}">
          <ui:SettingsView DataContext="{Binding SettingsViewModel}" />
        </Panel>
      </Grid>
    </Border>

    <!-- Global bottom-right toast notifications covering the whole window -->
    <viewsControls:ToastHost Grid.RowSpan="2" Grid.ColumnSpan="2" />

    <viewsControls:OnboardingTourOverlay Grid.RowSpan="2"
                                         Grid.ColumnSpan="2"
                                         DataContext="{CompiledBinding OnboardingTour}" />

  </Grid>
</Window>
