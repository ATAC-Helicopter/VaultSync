<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:local="using:VaultSync.UI"
    x:Class="VaultSync.UI.App"
    RequestedThemeVariant="Default">

    <!-- Global resources -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Single source of truth for brushes (Dark + Light inside) -->
                <ResourceInclude Source="avares://VaultSync.UI/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout tokens (toggled by compact mode) -->
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardMargin">8</Thickness>
            <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
            <Thickness x:Key="NavButtonPadding">12,10</Thickness>
            <Thickness x:Key="NavButtonMargin">0,6,0,0</Thickness>
            <Thickness x:Key="MetricMargin">0,6,0,2</Thickness>
            <Thickness x:Key="MetricHintMargin">0,2,0,0</Thickness>
            <x:Double x:Key="MetricFontSize">36</x:Double>
            <x:Double x:Key="SectionTitleFontSize">16</x:Double>
            <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
            <Thickness x:Key="PageStackMargin">24</Thickness>
            <Thickness x:Key="SectionMarginBottom">0,0,0,12</Thickness>
            <Thickness x:Key="ListItemMargin">0,8,0,0</Thickness>
            <Thickness x:Key="ListItemMarginTight">0,3,0,3</Thickness>
            <Thickness x:Key="ListItemPadding">16</Thickness>
            <Thickness x:Key="CardPaddingLarge">24</Thickness>
            <Thickness x:Key="CardPaddingMedium">16</Thickness>
            <Thickness x:Key="CardPaddingSmall">12</Thickness>
            <Thickness x:Key="InputPadding">10,8</Thickness>
            <Thickness x:Key="ButtonTightPadding">10,6</Thickness>
            <Thickness x:Key="ButtonPillPadding">10,4</Thickness>
            <Thickness x:Key="SmallButtonPadding">8,4</Thickness>
            <Thickness x:Key="SmallPillPadding">10,4</Thickness>
            <Thickness x:Key="StatPillPadding">8,2</Thickness>
            <Thickness x:Key="BackupTagPadding">6,2</Thickness>
            <Thickness x:Key="BackupTagMargin">4,0,0,0</Thickness>
            <Thickness x:Key="SummaryStatPadding">10,8</Thickness>
            <Thickness x:Key="ChartItemMargin">6,0</Thickness>
            <Thickness x:Key="ChartLabelMargin">10,4,10,0</Thickness>
            <x:Double x:Key="PageRowSpacing">16</x:Double>
            <x:Double x:Key="ListRowSpacing">4</x:Double>
            <x:Double x:Key="ProjectIconSize">28</x:Double>
            <x:Double x:Key="ProjectIconRadius">14</x:Double>
            <Thickness x:Key="ProjectIconMargin">0,0,8,0</Thickness>
            <x:Double x:Key="PageTitleFontSize">22</x:Double>
            <x:Double x:Key="PageSubtitleFontSize">12</x:Double>
            <x:Double x:Key="SectionHeaderFontSize">14</x:Double>
            <FontFamily x:Key="AppFontFamily">Inter, Noto Sans, Segoe UI, SF Pro Text, Helvetica Neue, Nirmala UI, Microsoft YaHei UI, Microsoft JhengHei UI, Meiryo, Malgun Gothic, Geeza Pro, Al Nile, Al Bayan, Kohinoor Arabic, Noto Sans Arabic, Noto Naskh Arabic, Arial Unicode MS, Arial, Tahoma</FontFamily>
            <infra:BooleanInvertConverter x:Key="BoolInvertConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <!-- View-model -> view wiring -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>

        <!-- Core Fluent theme (actual control templates). Base = Light, we override via RequestedThemeVariant -->
        <fluent:FluentTheme />

        <!-- Window background uses our brush from Colors.axaml -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        </Style>

        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <!-- Card surface -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
            <Setter Property="Margin" Value="{DynamicResource CardMargin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>

        <!-- Sidebar + header -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style Selector="Border.header">
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- Navigation buttons -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="{DynamicResource NavButtonPadding}" />
            <Setter Property="Margin" Value="{DynamicResource NavButtonMargin}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>

        <!-- Action buttons -->
        <Style Selector="Button.action-ghost">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.action-ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="Button.action-ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>

        <Style Selector="Button.action-primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.action-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.action-primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <!-- Shared pills/tags -->
        <Style Selector="Border.stat-pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource StatPillPadding}" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <Style Selector="Border.stat-pill.sm">
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.stat-pill.md">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.stat-pill.info">
            <Setter Property="Background" Value="#1F3559" />
            <Setter Property="BorderBrush" Value="#345F96" />
        </Style>
        <Style Selector="Border.stat-pill.success">
            <Setter Property="Background" Value="#1E4C3D" />
            <Setter Property="BorderBrush" Value="#2F8D70" />
        </Style>
        <Style Selector="Border.stat-pill.warning">
            <Setter Property="Background" Value="#5C4420" />
            <Setter Property="BorderBrush" Value="#B98833" />
        </Style>
        <Style Selector="Border.stat-pill.danger">
            <Setter Property="Background" Value="#5A2A2A" />
            <Setter Property="BorderBrush" Value="#A54A4A" />
        </Style>
        <Style Selector="Border.stat-pill TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="Border.backup-tag">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource BackupTagPadding}" />
            <Setter Property="Margin" Value="{DynamicResource BackupTagMargin}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <Style Selector="Border.backup-tag.sm">
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.backup-tag.md">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.backup-tag.info">
            <Setter Property="Background" Value="#1F3559" />
            <Setter Property="BorderBrush" Value="#345F96" />
        </Style>
        <Style Selector="Border.backup-tag.success">
            <Setter Property="Background" Value="#1E4C3D" />
            <Setter Property="BorderBrush" Value="#2F8D70" />
        </Style>
        <Style Selector="Border.backup-tag.warning">
            <Setter Property="Background" Value="#5C4420" />
            <Setter Property="BorderBrush" Value="#B98833" />
        </Style>
        <Style Selector="Border.backup-tag.danger">
            <Setter Property="Background" Value="#5A2A2A" />
            <Setter Property="BorderBrush" Value="#A54A4A" />
        </Style>
        <Style Selector="Border.backup-tag TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="Button.small-pill, ToggleButton.small-pill">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource SmallPillPadding}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.small-pill:pointerover, ToggleButton.small-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="Button.small-pill:pressed, ToggleButton.small-pill:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="ToggleButton.small-pill:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.pill-icon">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Shell brand banner -->
        <Style Selector="Border.shell-banner">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- ListBox cleanup -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Typography -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="{DynamicResource MetricFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="{DynamicResource MetricMargin}" />
        </Style>

        <Style Selector="TextBlock.metric-hint">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="{DynamicResource MetricHintMargin}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Application.Styles>

</Application>
