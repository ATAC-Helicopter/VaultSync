<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:local="using:VaultSync.UI"
    xmlns:viewControls="using:VaultSync.UI.Views.Controls"
    x:Class="VaultSync.UI.App"
    RequestedThemeVariant="Default">

    <!-- Global resources -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Single source of truth for brushes (Dark + Light inside) -->
                <ResourceInclude Source="avares://VaultSync.UI/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout tokens (toggled by compact mode) -->
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardMargin">8</Thickness>
            <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
            <Thickness x:Key="NavButtonPadding">12,10</Thickness>
            <Thickness x:Key="NavButtonMargin">0,6,0,0</Thickness>
            <Thickness x:Key="MetricMargin">0,6,0,2</Thickness>
            <Thickness x:Key="MetricHintMargin">0,2,0,0</Thickness>
            <x:Double x:Key="MetricFontSize">36</x:Double>
            <x:Double x:Key="SectionTitleFontSize">16</x:Double>
            <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
            <Thickness x:Key="PageStackMargin">24</Thickness>
            <Thickness x:Key="SectionMarginBottom">0,0,0,12</Thickness>
            <Thickness x:Key="ListItemMargin">0,8,0,0</Thickness>
            <Thickness x:Key="ListItemMarginTight">0,3,0,3</Thickness>
            <Thickness x:Key="ListItemPadding">16</Thickness>
            <Thickness x:Key="CardPaddingLarge">24</Thickness>
            <Thickness x:Key="CardPaddingMedium">16</Thickness>
            <Thickness x:Key="CardPaddingSmall">12</Thickness>
            <Thickness x:Key="InputPadding">10,8</Thickness>
            <Thickness x:Key="ButtonTightPadding">10,6</Thickness>
            <Thickness x:Key="ButtonPillPadding">10,4</Thickness>
            <Thickness x:Key="SmallButtonPadding">8,4</Thickness>
            <Thickness x:Key="SmallPillPadding">10,4</Thickness>
            <Thickness x:Key="StatPillPadding">8,2</Thickness>
            <Thickness x:Key="BackupTagPadding">6,2</Thickness>
            <Thickness x:Key="BackupTagMargin">4,0,0,0</Thickness>
            <Thickness x:Key="SummaryStatPadding">10,8</Thickness>
            <Thickness x:Key="ChartItemMargin">6,0</Thickness>
            <Thickness x:Key="ChartLabelMargin">10,4,10,0</Thickness>
            <x:Double x:Key="PageRowSpacing">16</x:Double>
            <x:Double x:Key="ListRowSpacing">4</x:Double>
            <x:Double x:Key="ProjectIconSize">28</x:Double>
            <x:Double x:Key="ProjectIconRadius">14</x:Double>
            <Thickness x:Key="ProjectIconMargin">0,0,8,0</Thickness>
            <x:Double x:Key="PageTitleFontSize">22</x:Double>
            <x:Double x:Key="PageSubtitleFontSize">12</x:Double>
            <x:Double x:Key="SectionHeaderFontSize">14</x:Double>
            <FontFamily x:Key="AppFontFamily">Inter, Noto Sans, Segoe UI, SF Pro Text, Helvetica Neue, Nirmala UI, Microsoft YaHei UI, Microsoft JhengHei UI, Meiryo, Malgun Gothic, Geeza Pro, Al Nile, Al Bayan, Kohinoor Arabic, Noto Sans Arabic, Noto Naskh Arabic, Arial Unicode MS, Arial, Tahoma</FontFamily>
            <infra:BooleanInvertConverter x:Key="BoolInvertConverter" />
            <viewControls:ContrastForegroundConverter x:Key="ContrastForegroundConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <!-- View-model -> view wiring -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>

        <!-- Core Fluent theme (actual control templates). Base = Light, we override via RequestedThemeVariant -->
        <fluent:FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- Window background uses our brush from Colors.axaml -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        </Style>

        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <!-- Pointer focus must not leave Fluent's blue focus rectangle behind.
             Keyboard navigation still receives an explicit :focus-visible treatment. -->
        <Style Selector="Button, ToggleButton, ComboBox">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="Button:focus-visible, ToggleButton:focus-visible, ComboBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Window.linux-performance Border.pulse-ring">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Card surface -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface1}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
            <Setter Property="Margin" Value="{DynamicResource CardMargin}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>

        <!-- Sidebar + header -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource ShellNavigationBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BoxShadow" Value="12 0 36 0 #18000000" />
        </Style>

        <Style Selector="Border.sidebar.compact">
            <Setter Property="Background" Value="{DynamicResource ShellNavigationBrush}" />
        </Style>

        <Style Selector="Border.header">
            <Setter Property="Background" Value="{DynamicResource ShellToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #12000000" />
        </Style>

        <!-- Navigation buttons -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="48" />
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        </Style>

        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav.active Border.nav-icon-badge">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.nav:pointerover Border.nav-icon-badge">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.nav:pressed Border.nav-icon-badge">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.nav.compact">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Surface1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.sidebar-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        </Style>

        <Style Selector="Button.sidebar-toggle:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Border.nav-icon-badge">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.nav-icon-badge.compact">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.nav.compact:pointerover Border.nav-icon-badge.compact">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.nav.compact:pressed Border.nav-icon-badge.compact">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Action buttons -->
        <Style Selector="Button.action-ghost">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="Button.action-ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="Button.action-ghost TextBlock, Button.action-primary TextBlock, Button.action-danger TextBlock, Button.small-button TextBlock, Button.primary-button TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.action-primary, Button.primary-button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-primary:pointerover, Button.primary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.action-primary:pressed, Button.primary-button:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.action-danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.action-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>
        <Style Selector="Button.action-danger:pressed">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>

        <Style Selector="Button.small-button">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="{DynamicResource SmallButtonPadding}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.small-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        </Style>
        <Style Selector="Button.small-button:pressed">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        </Style>

        <!-- Shared pills/tags -->
        <Style Selector="Border.stat-pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource StatPillPadding}" />
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MaxWidth" Value="280" />
        </Style>
        <Style Selector="Border.stat-pill.sm">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="Border.stat-pill.md">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Border.stat-pill.info">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.stat-pill.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.stat-pill.warning">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.stat-pill.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.stat-pill TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.backup-tag">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource BackupTagPadding}" />
            <Setter Property="Margin" Value="{DynamicResource BackupTagMargin}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MaxWidth" Value="280" />
        </Style>
        <Style Selector="Border.backup-tag.sm">
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="Border.backup-tag.md">
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.backup-tag.info">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.backup-tag.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.backup-tag.warning">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.backup-tag.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Border.backup-tag TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.small-pill, ToggleButton.small-pill">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="{DynamicResource SmallPillPadding}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.small-pill TextBlock, ToggleButton.small-pill TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.small-pill:pointerover, ToggleButton.small-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="Button.small-pill:pressed, ToggleButton.small-pill:pressed">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="ToggleButton.small-pill:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.color-swatch-button, ToggleButton.color-swatch-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.color-swatch-button:checked">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="ToggleButton.color-swatch-button:pointerover">
            <Setter Property="Opacity" Value="0.96" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Shared application inputs. Apply these classes to search/filter rows so
             Fluent's platform defaults never leak into product workspaces. -->
        <Style Selector="TextBox.app-search">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.app-search:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
        </Style>
        <Style Selector="ComboBox.app-filter">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.app-filter:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>

        <!-- Flat, theme-aware disclosure used instead of the native Expander chrome. -->
        <Style Selector="Expander.app-section">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Expander">
                    <Grid RowDefinitions="Auto,Auto">
                        <ToggleButton x:Name="PART_Header"
                                      Background="{DynamicResource Surface2}"
                                      BorderBrush="{DynamicResource BorderSoft}"
                                      BorderThickness="1"
                                      CornerRadius="10"
                                      Padding="12,10"
                                      HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Classes="app-section-chevron"
                                           Text="⌄"
                                           FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="50%,50%" />
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_ContentHost"
                                          Grid.Row="1"
                                          Content="{TemplateBinding Content}"
                                          Margin="0,10,0,0"
                                          IsVisible="{TemplateBinding IsExpanded}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Expander.app-section ToggleButton#PART_Header">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Expander.app-section ToggleButton#PART_Header:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
        </Style>
        <Style Selector="Expander.app-section:expanded ToggleButton#PART_Header">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Expander.app-section:expanded TextBlock.app-section-chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="Expander.app-section /template/ ContentPresenter#PART_ContentHost">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Expander.app-section:expanded /template/ ContentPresenter#PART_ContentHost">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Global ComboBox popup readability -->
        <Style Selector="ComboBox /template/ Popup Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Surface1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBox /template/ Popup ListBox">
            <Setter Property="Background" Value="{DynamicResource Surface1}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="ComboBox /template/ Popup ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox /template/ Popup ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
        </Style>
        <Style Selector="ComboBox /template/ Popup ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.pill-icon">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Shell brand banner -->
        <Style Selector="Border.shell-banner">
            <Setter Property="Background" Value="{DynamicResource GlassFloatingBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassRimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #18000000" />
        </Style>

        <Style Selector="Border.shell-monogram">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,12" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="White" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        </Style>

        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ToggleSwitch /template/ Border#SwitchKnob">
            <Setter Property="Background" Value="{DynamicResource Surface0}" />
        </Style>

        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnob">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- ListBox cleanup -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="BringIntoViewOnFocusChange" Value="False" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Typography -->
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="{DynamicResource MetricFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="{DynamicResource MetricMargin}" />
        </Style>

        <Style Selector="TextBlock.metric-hint">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="{DynamicResource MetricHintMargin}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Application.Styles>

</Application>
