<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.8.7</Version>
    <Product>VaultSync</Product>
    <Company>Flavio Giacchetti</Company>
    <ApplicationIcon>Assets\vaultsync.ico</ApplicationIcon>

    <!-- Multi-target: generic .NET 10 + Windows-specific TFM -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>

    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Disable Avalonia telemetry task (skip UsedAvaloniaProducts) to avoid build log write failures -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <!-- Avoid shared compiler server to sidestep temp permission issues -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <!-- Enable WINDOWS constant for the Windows TFM so #if WINDOWS blocks compile -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Allow building the Windows TFM on non-Windows agents (e.g., macOS CI/local) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Release builds default to win-x64, so solution restore must include that target graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Default Release publishes to win-x64 self-contained to avoid missing runtime prompts -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
  </PropertyGroup>

  <!-- Base Avalonia + dependencies -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <!-- Keep native packages pinned directly so every RID resolves the same Skia/HarfBuzz ABI. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
  </ItemGroup>

  <!-- Reference to core project -->
  <ItemGroup>
    <ProjectReference Include="..\VaultSync.Core\VaultSync.Core.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>TargetFramework=net10.0</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy presets into output -->
  <ItemGroup>
    <Content Include="..\presets\*.vaultsyncignore">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\docs\WHATS_NEW.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WHATS_NEW.md</Link>
    </Content>
  </ItemGroup>

  <!-- Optional bundled rsync for Windows delta sync -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0' And (Exists('..\..\tools\rsync\bin\rsync.exe') Or Exists('..\..\tools\rsync\rsync.exe'))">
    <Content Include="..\..\tools\rsync\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Optional bundled rsync for macOS delta sync -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And Exists('..\..\tools\rsync-macos\arm64\bin\rsync')">
    <Content Include="..\..\tools\rsync-macos\arm64\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' And Exists('..\..\tools\rsync-macos\x64\bin\rsync')">
    <Content Include="..\..\tools\rsync-macos\x64\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\..\tools\rsync-macos\LICENSES')">
    <Content Include="..\..\tools\rsync-macos\LICENSES\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\LICENSES\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Tray/Menu bar icon -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/vaultsync-tray.png" />
    <AvaloniaResource Include="Assets/Fonts/NotoSans[wdth,wght].ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic[wdth,wght].ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic-Regular.ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets/vaultsync-tray.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Windows notifications -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <!-- Keep the toolkit's legacy System.Drawing transitively resolved to the serviced runtime line. -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Localization\strings.*.json">
      <Link>Localization\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
