<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.7.4-Beta.3</Version>
    <Product>VaultSync</Product>
    <Company>Flavio Giacchetti</Company>
    <ApplicationIcon>Assets\vaultsync.ico</ApplicationIcon>

    <!-- Multi-target: generic .NET 10 + Windows-specific TFM -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Disable Avalonia telemetry task (skip UsedAvaloniaProducts) to avoid build log write failures -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <!-- Avoid shared compiler server to sidestep temp permission issues -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <!-- Enable WINDOWS constant for the Windows TFM so #if WINDOWS blocks compile -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- Allow building the Windows TFM on non-Windows agents (e.g., macOS CI/local) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Ensure Windows TFM restore generates packaged Windows output assets without requesting the invalid "any" RID. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Default Release publishes to win-x64 self-contained to avoid missing runtime prompts -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
  </PropertyGroup>

  <!-- Base Avalonia + dependencies -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.15" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.15" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.15" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.93.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.15">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4-preview.1.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.4" />
    <PackageReference Include="ReactiveUI" Version="23.2.27" />
  </ItemGroup>

  <!-- Reference to core project -->
  <ItemGroup>
    <ProjectReference Include="..\VaultSync.Core\VaultSync.Core.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy presets into output -->
  <ItemGroup>
    <Content Include="..\presets\*.vaultsyncignore">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>presets\%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\docs\WHATS_NEW.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>WHATS_NEW.md</Link>
    </Content>
  </ItemGroup>

  <!-- Optional bundled rsync for Windows delta sync -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0' And (Exists('..\..\tools\rsync\bin\rsync.exe') Or Exists('..\..\tools\rsync\rsync.exe'))">
    <Content Include="..\..\tools\rsync\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Optional bundled rsync for macOS delta sync -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And Exists('..\..\tools\rsync-macos\arm64\bin\rsync')">
    <Content Include="..\..\tools\rsync-macos\arm64\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' And Exists('..\..\tools\rsync-macos\x64\bin\rsync')">
    <Content Include="..\..\tools\rsync-macos\x64\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="('$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64') And Exists('..\..\tools\rsync-macos\LICENSES')">
    <Content Include="..\..\tools\rsync-macos\LICENSES\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rsync\LICENSES\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Tray/Menu bar icon -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/vaultsync-tray.png" />
    <AvaloniaResource Include="Assets/Fonts/NotoSans[wdth,wght].ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic[wdth,wght].ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic-Regular.ttf" />
    <AvaloniaResource Include="Assets/Fonts/NotoSansArabic-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets/vaultsync-tray.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Windows notifications -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
  </ItemGroup>

    <ItemGroup>
      <None Include="..\..\Localization\strings.en.json">
        <Link>Localization\strings.en.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.it.json">
        <Link>Localization\strings.it.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.es.json">
        <Link>Localization\strings.es.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.fr.json">
        <Link>Localization\strings.fr.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.de.json">
        <Link>Localization\strings.de.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.pt.json">
        <Link>Localization\strings.pt.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.zh.json">
        <Link>Localization\strings.zh.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.hi.json">
        <Link>Localization\strings.hi.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.ar.json">
        <Link>Localization\strings.ar.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.bn.json">
        <Link>Localization\strings.bn.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\..\Localization\strings.ru.json">
        <Link>Localization\strings.ru.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
