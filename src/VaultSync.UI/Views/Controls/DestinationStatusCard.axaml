<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="VaultSync.UI.Views.Controls.DestinationStatusCard"
    x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="UserControl.tray Border#Card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="UserControl.tray Grid#LayoutGrid">
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector="UserControl.tray Border#Pill">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="UserControl.compact Border#Card">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Surface3}" />
    </Style>
    <Style Selector="UserControl.compact Grid#LayoutGrid">
      <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style Selector="UserControl.compact Border#Pill">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.alias">
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.path">
      <Setter Property="FontSize" Value="8" />
    </Style>
    <Style Selector="UserControl.compact TextBlock.status">
      <Setter Property="FontSize" Value="8.5" />
    </Style>
    <Style Selector="UserControl.compact Grid#StatusDot">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="UserControl.compact Border#StatusDotCore">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card"
          Margin="0,2,0,0"
          Padding="8"
          CornerRadius="12"
          Background="{DynamicResource Surface2}"
          BorderBrush="{DynamicResource BorderSoft}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid x:Name="LayoutGrid"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="10"
          VerticalAlignment="Center">
      <Border x:Name="Pill"
              Grid.Column="0"
              Width="6"
              Height="26"
              CornerRadius="3"
              Background="{Binding DotBrush}"
              Opacity="1"
              VerticalAlignment="Center"
              Margin="0" />
      <StackPanel Grid.Column="1"
                  Spacing="2"
                  VerticalAlignment="Center">
        <TextBlock Classes="alias"
                   Text="{Binding Alias}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Path}" />
        <TextBlock Classes="path"
                   Text="{Binding Path}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <TextBlock Classes="status"
                   Text="{Binding Status}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="0,0,2,0" />
        <Grid x:Name="StatusDot"
              Width="20"
              Height="20"
              ClipToBounds="False"
              ToolTip.Tip="{Binding Status}">
          <Border Classes="pulse-ring"
                  CornerRadius="5"
                  Background="{Binding ReachabilityBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsChecking}" />
          <Border x:Name="StatusDotCore"
                  Width="8"
                  Height="8"
                  CornerRadius="4"
                  Background="{Binding ReachabilityBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
