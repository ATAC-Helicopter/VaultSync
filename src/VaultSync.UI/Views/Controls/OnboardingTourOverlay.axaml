<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    x:Class="VaultSync.UI.Views.Controls.OnboardingTourOverlay"
    x:DataType="vm:OnboardingTourViewModel"
    IsVisible="{CompiledBinding IsActive}"
    AutomationProperties.Name="{CompiledBinding Title}">

  <Canvas x:Name="OverlayCanvas">
    <Border x:Name="TargetHighlight"
            IsHitTestVisible="False"
            IsVisible="False"
            CornerRadius="10"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            Background="#144C8DFF" />

    <Border x:Name="TourCard"
            Width="300"
            BoxShadow="0 12 32 0 #80000000"
            Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">

      <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="8">

          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
              <TextBlock Text="{CompiledBinding StepCounter}"
                         FontSize="12"
                         HorizontalAlignment="Left"
                         Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}"
                         FontWeight="SemiBold" />
            <Button Content="{CompiledBinding SkipLabel}"
                    Command="{CompiledBinding SkipCommand}"
                    Classes="action-ghost"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="8,4" />
          </Grid>

          <ProgressBar Grid.Row="1"
                       Minimum="0"
                       Maximum="1"
                       Height="3"
                       Value="{CompiledBinding ProgressValue}" />

          <StackPanel Grid.Row="2"
                      Spacing="7">
            <TextBlock Text="{CompiledBinding Title}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{CompiledBinding Body}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="17" />
          </StackPanel>

          <Border Grid.Row="3"
                  Background="{DynamicResource Surface2}"
                  BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8"
                  IsVisible="{CompiledBinding HasActionText}">
            <StackPanel Spacing="5">
              <TextBlock Text="{CompiledBinding ActionHeadingText}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{CompiledBinding ActionText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"
                         LineHeight="19" />
            </StackPanel>
          </Border>
        </Grid>
      <Grid Grid.Row="1"
            Margin="0,8,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="8">
        <Button Content="{CompiledBinding BackLabel}"
                Command="{CompiledBinding PreviousCommand}"
                IsVisible="{CompiledBinding CanGoBack}"
                Classes="action-ghost"
                Padding="8,4" />
        <Button Content="{CompiledBinding PrimaryLabel}"
                Grid.Column="3"
                Command="{CompiledBinding PrimaryCommand}"
                Classes="action-primary"
                Padding="10,6" />
      </Grid>
    </Grid>
  </Border>
  </Canvas>
</UserControl>
