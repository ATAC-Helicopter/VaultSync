<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.Controls.OnboardingTourOverlay"
    x:DataType="vm:OnboardingTourViewModel"
    IsVisible="{CompiledBinding IsActive}">

  <Grid>
    <Canvas x:Name="OverlayCanvas"
            IsHitTestVisible="False">
      <Border x:Name="OverlayTop"
              Background="#A0000000" />
      <Border x:Name="OverlayLeft"
              Background="#A0000000" />
      <Border x:Name="OverlayRight"
              Background="#A0000000" />
      <Border x:Name="OverlayBottom"
              Background="#A0000000" />
      <Border x:Name="HighlightBorder"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="3"
              CornerRadius="14"
              Background="#22FFFFFF"
              Width="10"
              Height="10"
              IsHitTestVisible="False" />

    </Canvas>

    <Popup x:Name="CalloutPopup"
           IsOpen="{CompiledBinding IsActive}"
           Placement="Top"
           IsLightDismissEnabled="False">
      <Border x:Name="CalloutCard"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource BorderSoft}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="18"
              Width="370">
        <StackPanel Spacing="14">
          <TextBlock Text="{CompiledBinding StepCounter}"
                     FontSize="12"
                     Foreground="{DynamicResource AccentBrush}"
                     FontWeight="SemiBold" />

          <StackPanel Spacing="7">
            <TextBlock Text="{CompiledBinding Title}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{CompiledBinding Body}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="21" />
          </StackPanel>

          <Border IsVisible="{CompiledBinding HasActionText}"
                  Background="{DynamicResource Surface2}"
                  BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{CompiledBinding ActionHeadingText}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{CompiledBinding ActionText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"
                         LineHeight="19" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Content="{CompiledBinding BackLabel}"
                    Command="{CompiledBinding PreviousCommand}"
                    IsVisible="{CompiledBinding CanGoBack}"
                    Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="10"
                    Padding="10,6" />
            <Button Content="{CompiledBinding SkipLabel}"
                    Grid.Column="2"
                    Command="{CompiledBinding SkipCommand}"
                    Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="10"
                    Padding="10,6" />
            <Button Content="{CompiledBinding PrimaryLabel}"
                    Grid.Column="3"
                    Command="{CompiledBinding PrimaryCommand}"
                    IsEnabled="{CompiledBinding IsPrimaryEnabled}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnPillBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    CornerRadius="10"
                    Padding="10,6" />
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
