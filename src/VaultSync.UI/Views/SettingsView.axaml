<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI"
             xmlns:colorpicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             x:Class="VaultSync.UI.SettingsView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- Inputs -->
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
    </Style>

    <!-- Ghost button -->
    <Style Selector="Button.settings-ghost">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settings-ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Button.settings-ghost TextBlock">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style Selector="Button.theme-preset-card">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="178" />
      <Setter Property="MaxWidth" Value="202" />
    </Style>
    <Style Selector="Button.theme-preset-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.theme-editor-toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.theme-editor-toggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="ToggleButton.theme-editor-toggle:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

  </UserControl.Styles>

    <UserControl.Resources>
      <controls:StatusToBrushConverter x:Key="StatusToBrushConverter" />
      <infra:BooleanToCharConverter x:Key="BoolToCharConverter" />
      <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    </UserControl.Resources>

  <Grid>
  <ScrollViewer x:Name="SettingsScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">

    <!-- Allow the form to stretch across the viewport while capping width for readability. -->
    <Grid MaxWidth="2200"
          HorizontalAlignment="Stretch"
          MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
          RowDefinitions="Auto,Auto"
          RowSpacing="{DynamicResource PageRowSpacing}"
          Margin="0,0,0,40">

        <!-- Header -->
        <Border Grid.Row="0"
                Classes="card"
                CornerRadius="18"
                Padding="{DynamicResource CardPaddingLarge}"
                Margin="0,0,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="section-title"
                       Text="{infra:LocalizedString Key=Settings.General.Title}" />
            <TextBlock Text="{infra:LocalizedString Key=Settings.General.Description}"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1"
              ColumnDefinitions="1.35*,0.85*"
              RowDefinitions="Auto"
              ColumnSpacing="{DynamicResource PageRowSpacing}"
              RowSpacing="{DynamicResource PageRowSpacing}"
              Margin="0,0,0,28">

          <!-- LEFT COLUMN -->
          <StackPanel Grid.Column="0"
                      Spacing="{DynamicResource PageRowSpacing}">

            <!-- General -->
            <Border x:Name="SettingsGeneralCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.General.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.General.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <!-- Projects root -->
                <Grid x:Name="ProjectsRootRow"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      ColumnSpacing="8">
                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ProjectsRoot}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ProjectsRootDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>

                  <TextBox x:Name="ProjectsRootInput"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,2,0,0"
                           Text="{Binding ProjectsRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="{infra:LocalizedString Key=Settings.General.ProjectsRootWatermark}" />

                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,2,0,0"
                          Classes="settings-ghost"
                          Command="{Binding BrowseProjectsRootCommand}">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Browse}" />
                  </Button>
                </Grid>

                <!-- Resume last session -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ResumeSession}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ResumeSessionDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ResumeLastSession, Mode=TwoWay}" />
                </Grid>

                <!-- Launch on login -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.LaunchOnLogin}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.LaunchOnLoginDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding LaunchOnLogin, Mode=TwoWay}" />
                </Grid>

                <!-- Show tray icon -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowTrayIcon}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowTrayIconDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                </Grid>

                <!-- Run in background when closing -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.RunInBackground}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.RunInBackgroundDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding RunInBackground, Mode=TwoWay}" />
                </Grid>

                <!-- Show main window on tray actions -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowWindowOnTray}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowWindowOnTrayDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowWindowOnTrayActions, Mode=TwoWay}" />
                </Grid>

                <!-- Show mini backup widget when starting from tray -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowMiniWidget}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.General.ShowMiniWidgetDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowTrayBackupWidget, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Backups -->
            <Border x:Name="SettingsBackupsCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <!-- Enable auto backups -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.EnableAuto}" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.EnableAutoDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableAutoBackups, Mode=TwoWay}" />
                </Grid>

                <!-- Interval -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Interval}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.IntervalDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding AutoBackupIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Right" />
                </Grid>

                <!-- Max snapshots per project -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.KeepSnapshots}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.KeepSnapshotsDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding MaxSnapshotsPerProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Spacing="6"
                            Margin="0,6,0,0">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">
                    <StackPanel Grid.Column="0"
                                Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RetentionSimulationLabel}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RetentionSimulationDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="settings-ghost"
                            Command="{Binding RunRetentionSimulationCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RetentionSimulationRun}" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding RetentionSimulationSummary}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             IsVisible="{Binding RetentionSimulationSummary, Converter={StaticResource StringNotEmptyConverter}}" />
                  <Border Padding="10"
                          CornerRadius="10"
                          Background="{DynamicResource VsCardHighlightBrush}"
                          IsVisible="{Binding RetentionSimulationDetails, Converter={StaticResource StringNotEmptyConverter}}">
                    <ScrollViewer MaxHeight="140"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <TextBlock Text="{Binding RetentionSimulationDetails}"
                                 FontFamily="Cascadia Code, Consolas, monospace"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Border>
                </StackPanel>

                <!-- Confirm before deleting backups -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ConfirmDelete}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ConfirmDeleteDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ConfirmDeleteBackups, Mode=TwoWay}" />
                </Grid>

                <!-- History sync -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,6,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.HistorySync}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.HistorySyncDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableMetadataSync, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AutoImportMetadata}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AutoImportMetadataDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AutoImportMetadata, Mode=TwoWay}"
                                IsEnabled="{Binding EnableMetadataSync}" />
                </Grid>

                <Grid x:Name="SettingsPromptRestoreRow"
                      ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.PromptRestore}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.PromptRestoreDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PromptRestoreAfterImport, Mode=TwoWay}"
                                IsEnabled="{Binding EnableMetadataSync}" />
                </Grid>

                <Grid x:Name="SettingsBandwidthLimitRow"
                      ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding BandwidthLimitLabel}" />
                    <TextBlock Text="{Binding BandwidthLimitDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableBandwidthLimit, Mode=TwoWay}" />
                </Grid>

                <Grid x:Name="SettingsQuietHoursToggleRow"
                      ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0"
                              Spacing="2">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding BandwidthLimitValueLabel}" />
                    <TextBlock Text="{Binding BandwidthLimitValueDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="80"
                           HorizontalContentAlignment="Center"
                           HorizontalAlignment="Right"
                           Text="{Binding MaxBandwidthMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           IsEnabled="{Binding EnableBandwidthLimit}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding QuietHoursLabel}" />
                    <TextBlock Text="{Binding QuietHoursDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableQuietHours, Mode=TwoWay}" />
                </Grid>

                <Border x:Name="SettingsQuietHoursWindowCard"
                        Classes="card"
                        Margin="0,6,0,0"
                        Padding="12"
                        IsEnabled="{Binding EnableQuietHours}">
                  <Grid RowDefinitions="Auto,Auto"
                        RowSpacing="10">
                    <WrapPanel Grid.Row="0"
                               ItemSpacing="8"
                               LineSpacing="6"
                               VerticalAlignment="Center">
                      <Border Classes="stat-pill sm info">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="pill-icon" Text="◴" />
                          <TextBlock Text="{Binding QuietHoursWindowLabel}" />
                        </StackPanel>
                      </Border>
                      <Border Classes="stat-pill sm warning">
                        <TextBlock Text="{Binding QuietHoursWindowPreview}"
                                   ToolTip.Tip="{Binding QuietHoursWindowPreview}" />
                      </Border>
                    </WrapPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          HorizontalAlignment="Center">
                      <StackPanel Grid.Column="0"
                                  Spacing="4">
                        <TextBlock Text="{Binding QuietHoursStartLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Width="110"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 PlaceholderText="HH:mm"
                                 Text="{Binding QuietHoursStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding EnableQuietHours}" />
                      </StackPanel>

                      <TextBlock Grid.Column="1"
                                 Text="→"
                                 FontSize="16"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondary}" />

                      <StackPanel Grid.Column="2"
                                  Spacing="4"
                                  HorizontalAlignment="Center">
                        <TextBlock Text="{Binding QuietHoursEndLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Width="110"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 PlaceholderText="HH:mm"
                                 Text="{Binding QuietHoursEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding EnableQuietHours}" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RefreshHistory}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RefreshHistoryDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="settings-ghost"
                          Command="{Binding RefreshHistoryCommand}"
                          IsEnabled="{Binding EnableMetadataSync}">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RefreshHistory}" />
                  </Button>
                </Grid>

                <!-- Backup location (legacy fallback) -->
                <Grid x:Name="BackupLocationRow"
                      ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      Margin="0,6,0,0"
                      ColumnSpacing="8"
                      IsVisible="{Binding ShowLegacyBackupLocation}">
                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.FallbackLocation}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.FallbackLocationDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                    <Border Background="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=bg}"
                            BorderBrush="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,4,0,0"
                            IsVisible="{Binding BackupLocationStatus, Converter={StaticResource StringNotEmptyConverter}}">
                      <TextBlock Text="{Binding BackupLocationStatus}"
                                 Foreground="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>

                  <TextBox x:Name="BackupLocationInput"
                           Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding BackupLocationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip.Tip="{infra:LocalizedString Key=Settings.Backups.FallbackLocationTooltip}"
                           PlaceholderText="{infra:LocalizedString Key=Settings.Backups.FallbackLocationWatermark}" />

                  <StackPanel Grid.Row="1"
                              Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                    <Button Classes="settings-ghost"
                            Command="{Binding BrowseBackupLocationCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Browse}" />
                    </Button>
                    <Button Classes="settings-ghost"
                            Command="{Binding TestBackupLocationCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Recheck}" />
                    </Button>
                  </StackPanel>
                </Grid>

                <Border x:Name="DestinationsModeCard"
                        Classes="card"
                        Margin="0,6,0,0"
                        Padding="12"
                        Background="{DynamicResource Surface2}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        CornerRadius="14">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.DestinationsMode.Title}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.DestinationsMode.Description}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DestinationsModeToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding UseAdvancedDestinations, Mode=TwoWay}"
                                  ToolTip.Tip="{infra:LocalizedString Key=Settings.DestinationsMode.Tooltip}" />
                  </Grid>
                </Border>

                <Border x:Name="SettingsEncryptionCard"
                        Classes="card"
                        Margin="0,6,0,0"
                        Padding="12"
                        Background="{DynamicResource Surface2}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        CornerRadius="14">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.Title}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.Description}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.Enable}" />
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.EnableDescription}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" />
                      </StackPanel>
                      <ToggleSwitch x:Name="SettingsEncryptionEnableToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding BackupEncryptionEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.AllowSessionFallback}" />
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.AllowSessionFallbackDescription}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding BackupEncryptionAllowSessionFallback, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,2,0,0">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding EncryptionOpenTimeoutLabel}" />
                        <TextBlock Text="{Binding EncryptionOpenTimeoutDescription}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBox Grid.Column="1"
                               Width="70"
                               HorizontalContentAlignment="Center"
                               Text="{Binding BackupEncryptionOpenUnlockTimeoutMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="{Binding BackupEncryptionSecretStatus}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="8">
                      <TextBox x:Name="SettingsEncryptionPasswordInput"
                               Grid.Column="0"
                               Text="{Binding BackupEncryptionPasswordInput, Mode=TwoWay}"
                               PasswordChar="{Binding BackupEncryptionShowPassword, Converter={StaticResource BoolToCharConverter}, ConverterParameter=*}"
                               PlaceholderText="{infra:LocalizedString Key=Settings.Encryption.PasswordWatermark}" />
                      <Button Grid.Column="1"
                              Classes="settings-ghost"
                              Command="{Binding SetBackupEncryptionPasswordCommand}">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.SetPassword}" />
                      </Button>
                      <Button Grid.Column="2"
                              Classes="settings-ghost"
                              Command="{Binding ClearBackupEncryptionPasswordCommand}">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.ClearPassword}" />
                      </Button>
                    </Grid>

                    <CheckBox IsChecked="{Binding BackupEncryptionShowPassword, Mode=TwoWay}"
                              Content="{infra:LocalizedString Key=Settings.Credentials.ShowPassword}" />

                    <Button Classes="settings-ghost"
                            HorizontalAlignment="Left"
                            Command="{Binding EnrollProjectEncryptionPasswordCommand}">
                      <TextBlock Text="{Binding EnrollProjectEncryptionPasswordLabel}" />
                    </Button>

                    <Button x:Name="SettingsEncryptionRotateButton"
                            Classes="settings-ghost"
                            HorizontalAlignment="Left"
                            Command="{Binding RotateEncryptedBackupsCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Encryption.RotateBackups}" />
                    </Button>

                    <Button Classes="settings-ghost"
                            HorizontalAlignment="Left"
                            Command="{Binding LockEncryptedOpenWorkspacesCommand}">
                      <TextBlock Text="{Binding LockEncryptedOpenNowLabel}" />
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Compression -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Compress}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.CompressDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseBackupCompression, Mode=TwoWay}" />
                </Grid>

                <!-- rsync delta -->
                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RsyncDelta}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RsyncDeltaDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.RsyncDeltaDisabledHint}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding UseIncrementalBackups}" />
                      <TextBlock Text="{Binding RsyncStatusHint}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding ShowRsyncStatusHint}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding UseRsyncDelta, Mode=TwoWay}"
                                  IsEnabled="{Binding IsRsyncDeltaAvailable}" />
                  </Grid>

                  <!-- Incremental backups -->
                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Incremental}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.IncrementalDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding UseIncrementalBackups, Mode=TwoWay}" />
                  </Grid>

                  <!-- Archive upload auto-tune -->
                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AutoTuneArchive}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AutoTuneArchiveDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding EnableArchiveUploadAutoTune, Mode=TwoWay}" />
                  </Grid>

                  <!-- Parallel archive uploads -->
                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ParallelArchiveUploads}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ParallelArchiveUploadsDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding EnableParallelArchiveUpload, Mode=TwoWay}" />
                  </Grid>

                  <!-- Verify backups -->
                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Verify}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.VerifyDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{infra:LocalizedString Key=Settings.Backups.Verify}"
                                AutomationProperties.HelpText="{infra:LocalizedString Key=Settings.Backups.VerifyDescription}"
                                IsChecked="{Binding VerifyBackupsAfterCreate, Mode=TwoWay}" />
                </Grid>

                <!-- Full snapshot hashing -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.FullHash}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.FullHashDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseFullSnapshotHash, Mode=TwoWay}" />
                </Grid>

                <!-- Scan cache -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ScanCache}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.ScanCacheDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableScanCache, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AggressiveScanCache}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.AggressiveScanCacheDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AggressiveScanCache, Mode=TwoWay}"
                                IsEnabled="{Binding EnableScanCache}" />
                </Grid>

                <!-- Pause on battery -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.PauseBattery}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.PauseBatteryDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PauseBackupsOnBattery, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Storage -->
            <Border x:Name="SettingsStorageCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.PreferExternal}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.PreferExternalDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PreferExternalDrives, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.ShowDriveWarnings}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.ShowDriveWarningsDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowDriveHealthWarnings, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.ReserveFreeSpace}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Storage.ReserveFreeSpaceDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding MinimumFreeSpacePercent, Mode=TwoWay}"
                           HorizontalAlignment="Right" />
                </Grid>

                <!-- Backup destinations + credentials -->
                <Border x:Name="DestinationsSection"
                        Margin="0,10,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource VsCardHighlightBrush}"
                        IsVisible="{Binding UseAdvancedDestinations}">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Description}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                      <Button Classes="settings-ghost"
                              HorizontalAlignment="Left"
                              Command="{Binding OpenHelpCommand}">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.OpenHelp}" />
                      </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Destinations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="8"
                                  Margin="0,4,0,0"
                                  CornerRadius="10"
                                  Background="{DynamicResource CardBackgroundBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                              <Grid x:Name="DestinationBasicsRow"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="0"
                                    ColumnDefinitions="Auto,Auto,Auto"
                                    ColumnSpacing="10"
                                    VerticalAlignment="Center">
                                <TextBox Width="170"
                                         MaxWidth="220"
                                         HorizontalAlignment="Left"
                                         PlaceholderText="{infra:LocalizedString Key=Settings.Destinations.AliasWatermark}"
                                         Text="{Binding Alias, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1"
                                           Text="{infra:LocalizedString Key=Settings.Destinations.ActiveToggle}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding Active, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.ActiveTooltip}" />
                              </Grid>
                              <Button Grid.Column="2" Grid.Row="0"
                                      Classes="settings-ghost"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Command="{Binding DataContext.RemoveDestinationCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Remove}" />
                              </Button>

                              <Grid x:Name="DestinationPathRow"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Grid.Row="1"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">
                                <TextBox Grid.Column="0"
                                         PlaceholderText="{infra:LocalizedString Key=Settings.Destinations.PathWatermark}"
                                         Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                  <Button Classes="settings-ghost"
                                          Command="{Binding DataContext.BrowseDestinationCommand, ElementName=Root}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Select}" />
                                  </Button>
                                  <Button Classes="settings-ghost"
                                          Command="{Binding DataContext.TestDestinationCommand, ElementName=Root}"
                                          CommandParameter="{Binding}"
                                          ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.TestTooltip}">
                                    <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Test}" />
                                  </Button>
                                </StackPanel>
                              </Grid>

                              <ComboBox x:Name="DestinationCredentialRow"
                                        Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                                        MinWidth="160"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DataContext.CredentialNames, ElementName=Root}"
                                        SelectedItem="{Binding SelectedCredentialName, Mode=TwoWay}"
                                        ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.CredentialTooltip}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding .}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Grid Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Grid.Row="3"
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="16">
                                <StackPanel x:Name="DestinationMountOptionsRow"
                                            Grid.Column="0"
                                            Spacing="4">
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.PreMounted}"
                                            ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.PreMountedTooltip}"
                                            IsChecked="{Binding PreMounted, Mode=TwoWay}" />
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.AutoMount}"
                                            ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.AutoMountTooltip}"
                                            IsChecked="{Binding AutoMount, Mode=TwoWay}" />
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.AutoUnmount}"
                                            ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.AutoUnmountTooltip}"
                                            IsChecked="{Binding AutoUnmount, Mode=TwoWay}" />
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.Offsite}"
                                            ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.OffsiteTooltip}"
                                            IsChecked="{Binding IsOffsite, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel x:Name="DestinationHistoryOptionsRow"
                                            Grid.Column="1"
                                            Spacing="4">
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.SyncHistory}"
                                            IsChecked="{Binding EnableMetadataSync, Mode=TwoWay}" />
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.AutoImportHistory}"
                                            IsChecked="{Binding AutoImportMetadata, Mode=TwoWay}"
                                            IsEnabled="{Binding EnableMetadataSync}" />
                                  <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.ForceHistoryExport}"
                                            ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.ForceHistoryExportDescription}"
                                            IsChecked="{Binding ForceMetadataBackfill, Mode=TwoWay}"
                                            IsEnabled="{Binding EnableMetadataSync}" />
                                </StackPanel>
                              </Grid>

                              <Grid Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Grid.Row="4"
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="8"
                                    Margin="0,2,0,0">
                                <StackPanel Grid.Column="0"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.RetryPolicyLabel}" />
                                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.RetryPolicyDescription}"
                                             Foreground="{DynamicResource TextSecondary}"
                                             FontSize="11"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Width="60"
                                         HorizontalContentAlignment="Center"
                                         ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.RetryAttemptsTooltip}"
                                         Text="{Binding RetryMaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2"
                                         Width="70"
                                         HorizontalContentAlignment="Center"
                                         ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.RetryBackoffTooltip}"
                                         Text="{Binding RetryBackoffSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                              </Grid>

                              <Grid Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Grid.Row="5"
                                    ColumnDefinitions="*"
                                    Margin="0,2,0,0">
                                <CheckBox Content="{infra:LocalizedString Key=Settings.Destinations.CheckpointResumeLabel}"
                                          ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.CheckpointResumeDescription}"
                                          IsChecked="{Binding EnableCheckpointResume, Mode=TwoWay}" />
                              </Grid>

                              <Grid Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Grid.Row="6"
                                    ColumnDefinitions="*,Auto,Auto"
                                    ColumnSpacing="8"
                                    Margin="0,2,0,0">
                                <StackPanel Grid.Column="0"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.QuotaPolicyLabel}" />
                                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.QuotaPolicyDescription}"
                                             Foreground="{DynamicResource TextSecondary}"
                                             FontSize="11"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Width="80"
                                         HorizontalContentAlignment="Center"
                                         ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.QuotaGbTooltip}"
                                         Text="{Binding SoftQuotaGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2"
                                         Width="70"
                                         HorizontalContentAlignment="Center"
                                         ToolTip.Tip="{infra:LocalizedString Key=Settings.Destinations.QuotaWarningTooltip}"
                                         Text="{Binding QuotaWarningPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                              </Grid>

                              <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="7" Orientation="Vertical" Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.CredentialWarning}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding NeedsCredentialWarning}" />
                                  <TextBlock Text="{Binding LastTestStatus}"
                                             Foreground="{DynamicResource TextSecondary}"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             ToolTip.Tip="{Binding LastTestStatus}"
                                             IsVisible="{Binding LastTestStatus, Converter={StaticResource StringNotEmptyConverter}}" />
                              </StackPanel>

                              <Border Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Grid.Row="8"
                                      Padding="12"
                                      Margin="0,4,0,0"
                                      CornerRadius="10"
                                      Background="{DynamicResource VsCardHighlightBrush}"
                                      BorderBrush="{DynamicResource BorderSoft}"
                                      BorderThickness="1"
                                      IsVisible="{Binding EnableMetadataSync}">
                                <StackPanel Spacing="9">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.Title}"
                                                 FontWeight="SemiBold" />
                                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.Description}"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource TextSecondary}"
                                                 TextWrapping="Wrap" />
                                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.CompatibilityWarning}"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource WarningTextBrush}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Classes="stat-pill sm info"
                                            VerticalAlignment="Center">
                                      <TextBlock Text="{Binding RepositoryWriterStatus}" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Classes="settings-ghost"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding !IsRepositoryWriterBusy}"
                                            Command="{Binding DataContext.InspectRepositoryWriterCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                      <TextBlock Text="{infra:LocalizedString Key=Common.Refresh}" />
                                    </Button>
                                  </Grid>

                                  <TextBlock Text="{Binding RepositoryWriterDetails}"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextSecondary}"
                                             TextWrapping="Wrap" />

                                  <Button Classes="settings-ghost"
                                          HorizontalAlignment="Left"
                                          IsVisible="{Binding CanReviewStaleWriter}"
                                          IsEnabled="{Binding !IsRepositoryWriterBusy}"
                                          Command="{Binding DataContext.ReviewStaleWriterCommand, ElementName=Root}"
                                          CommandParameter="{Binding}">
                                    <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.Review}" />
                                  </Button>

                                  <Border Padding="12"
                                          CornerRadius="8"
                                          Background="{DynamicResource DangerSoftBrush}"
                                          BorderBrush="{DynamicResource DangerBrush}"
                                          BorderThickness="1"
                                          IsVisible="{Binding IsWriterTakeoverConfirmationVisible}">
                                    <StackPanel Spacing="10">
                                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.TakeoverWarning}"
                                                 Foreground="{DynamicResource DangerTextBrush}"
                                                 TextWrapping="Wrap" />
                                      <StackPanel Orientation="Horizontal"
                                                  HorizontalAlignment="Right"
                                                  Spacing="8">
                                        <Button Classes="action-ghost"
                                                Command="{Binding DataContext.CancelStaleWriterTakeoverCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                          <TextBlock Text="{infra:LocalizedString Key=Common.Cancel}" />
                                        </Button>
                                        <Button Classes="action-danger"
                                                Command="{Binding DataContext.ConfirmStaleWriterTakeoverCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Writer.TakeOver}" />
                                        </Button>
                                      </StackPanel>
                                    </StackPanel>
                                  </Border>
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                       </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="AddDestinationButton"
                            Classes="settings-ghost"
                            Command="{Binding AddDestinationCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.AddDestination}" />
                    </Button>

                    <Separator />

                    <StackPanel x:Name="CredentialProfilesSection"
                                Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.Description}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                    </StackPanel>

                      <ItemsControl ItemsSource="{Binding CredentialProfiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="12"
                                  Margin="0,4,0,0"
                                  CornerRadius="10"
                                  Background="{DynamicResource CardBackgroundBrush}">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                              <Grid Grid.Row="0" ColumnDefinitions="140,*" ColumnSpacing="12">
                                <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.NameLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         PlaceholderText="{infra:LocalizedString Key=Settings.Credentials.Watermark.Name}" />
                              </Grid>

                              <CheckBox Grid.Row="1"
                                        Content="{infra:LocalizedString Key=Settings.Credentials.UseKeychain}"
                                        IsChecked="{Binding UseKeychain, Mode=TwoWay}" />

                              <Grid Grid.Row="2" ColumnDefinitions="140,*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.UsernameLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding Username, Mode=TwoWay}"
                                         PlaceholderText="{infra:LocalizedString Key=Settings.Credentials.Watermark.Username}" />
                                <Button Grid.Column="2"
                                        Classes="settings-ghost"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveCredentialCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Remove}" />
                                </Button>
                              </Grid>

                              <Grid Grid.Row="3" ColumnDefinitions="140,*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.PasswordLabel}"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                  <TextBox Grid.Column="0"
                                           HorizontalAlignment="Stretch"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           PlaceholderText="{infra:LocalizedString Key=Settings.Credentials.Watermark.Password}"
                                             PasswordChar="{Binding ShowPassword, Converter={StaticResource BoolToCharConverter}, ConverterParameter=*}" />
                                </Grid>
                                <CheckBox Grid.Column="2"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowPassword, Mode=TwoWay}"
                                          Content="{infra:LocalizedString Key=Settings.Credentials.ShowPassword}" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="settings-ghost"
                            Command="{Binding AddCredentialCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Credentials.AddProfile}" />
                    </Button>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>

          </StackPanel>

          <!-- RIGHT COLUMN -->
          <StackPanel Grid.Column="1"
                      Spacing="{DynamicResource PageRowSpacing}"
                      Margin="0,0,0,28">

            <!-- Appearance -->
            <Border x:Name="SettingsAppearanceCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.Theme}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.ThemeDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>

                  <ComboBox Grid.Column="1"
                            Width="160"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </Grid>

                <Border IsVisible="{Binding IsCustomThemeSelected}"
                        Background="{DynamicResource ItemBg}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="0"
                        Margin="0,6,0,0">
                  <StackPanel>
                    <ToggleButton Classes="theme-editor-toggle"
                                  IsChecked="{Binding IsThemeEditorExpanded, Mode=TwoWay}"
                                  Padding="12"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                          <PathIcon Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Data="M12,2 L14.4,8.1 L21,10.5 L14.4,12.9 L12,19 L9.6,12.9 L3,10.5 L9.6,8.1 Z" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding ThemeEditorLabel}"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="{Binding CustomThemeName}"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <PathIcon Grid.Column="2"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  Data="M4,7 L8,11 L12,7" />
                      </Grid>
                    </ToggleButton>

                    <StackPanel IsVisible="{Binding IsThemeEditorExpanded}"
                                Spacing="14"
                                Margin="12,8,12,12">
                      <TextBlock Text="{Binding ThemeEditorDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="1.35*,0.65*,Auto"
                          ColumnSpacing="10">
                      <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding ThemeNameLabel}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" />
                        <TextBox Text="{Binding CustomThemeName, Mode=TwoWay}"
                                 PlaceholderText="{Binding ThemeNameLabel}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding ThemeBaseLabel}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" />
                        <ComboBox ItemsSource="{Binding CustomThemeBaseOptions}"
                                  SelectedItem="{Binding CustomThemeBase, Mode=TwoWay}" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="settings-ghost"
                              Command="{Binding ResetCustomThemeCommand}">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.TagColors.Reset}" />
                      </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding ThemePresetsLabel}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                      <ItemsControl ItemsSource="{Binding ThemePresets}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="theme-preset-card"
                                    Command="{Binding DataContext.ApplyThemePresetCommand, ElementName=Root}"
                                    CommandParameter="{Binding}">
                              <StackPanel Width="178"
                                          Spacing="7">
                                <Border Height="52"
                                        CornerRadius="9"
                                        Background="{Binding PreviewBackground}"
                                        BorderBrush="{DynamicResource BorderSoft}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                  <Grid Margin="8">
                                    <Border Width="72"
                                            Height="28"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="7"
                                            Background="{Binding PreviewSurface}" />
                                    <Border Width="18"
                                            Height="18"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="9"
                                            Background="{Binding PreviewAccent}" />
                                  </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                            </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal"
                               ItemSpacing="12"
                               LineSpacing="12">
                      <Border MinWidth="320"
                              MaxWidth="540"
                              Background="{DynamicResource Surface2}"
                              BorderBrush="{DynamicResource DividerBrush}"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="12">
                        <StackPanel Spacing="12">
                          <StackPanel Spacing="6">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding ThemePaletteLabel}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11" />
                              <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.ThemeEditor.PaletteDescription}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="10"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ThemePaletteSwatches}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Classes="color-swatch-button"
                                          Width="46"
                                          Height="34"
                                          Command="{Binding DataContext.ApplyThemePaletteSwatchCommand, ElementName=Root}"
                                          CommandParameter="{Binding}">
                                    <Border Width="40"
                                            Height="28"
                                            CornerRadius="10"
                                            Background="{Binding SwatchBrush}"
                                            BorderBrush="{Binding OutlineBrush}"
                                            BorderThickness="1.5" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ThemePaletteHint}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ThemePickerLabel}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" />
                            <ItemsControl ItemsSource="{Binding ThemeColorSlots}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <ToggleButton Classes="small-pill"
                                                Command="{Binding DataContext.SelectThemeColorSlotCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <Border Width="14"
                                              Height="14"
                                              CornerRadius="7"
                                              Background="{Binding SwatchBrush}"
                                              BorderBrush="{DynamicResource BorderSoft}"
                                              BorderThickness="1" />
                                      <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                  </ToggleButton>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <Border Background="{DynamicResource Surface1}"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="1"
                                  CornerRadius="12"
                                  Padding="10">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">
                              <Border Width="34"
                                      Height="34"
                                      CornerRadius="17"
                                      Background="{Binding SelectedThemeColorHex}"
                                      BorderBrush="{DynamicResource BorderSoft}"
                                      BorderThickness="1" />
                              <StackPanel Grid.Column="1"
                                          Spacing="2">
                                <TextBlock Text="{Binding SelectedThemeColorSlot.Label}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedThemeColorHex}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <Border Background="{DynamicResource Surface1}"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="1"
                                  CornerRadius="12"
                                  Padding="10">
                            <Border ClipToBounds="True"
                                    Background="Transparent">
                              <colorpicker:ColorView Color="{Binding SelectedThemeColor, Mode=TwoWay}"
                                                     Margin="6,-48,6,6"
                                                     MaxWidth="320"
                                                     HorizontalAlignment="Left"
                                                     ClipToBounds="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaVisible="False"
                                                     IsColorComponentsVisible="False"
                                                     IsColorModelVisible="False"
                                                     IsColorPaletteVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsComponentTextInputVisible="False"
                                                     IsColorPreviewVisible="False"
                                                     IsColorSpectrumVisible="True"
                                                     IsColorSpectrumSliderVisible="True"
                                                     IsComponentSliderVisible="False"
                                                     SelectedIndex="0"
                                                     ColorSpectrumShape="Ring" />
                            </Border>
                          </Border>
                        </StackPanel>
                      </Border>

                      <Border MinWidth="280"
                              MaxWidth="360"
                              Background="{DynamicResource Surface2}"
                              BorderBrush="{DynamicResource DividerBrush}"
                              BorderThickness="1"
                              CornerRadius="12"
                              Padding="12"
                              VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                          <TextBlock Text="{Binding ThemePreviewLabel}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11" />
                          <Border Background="{Binding ThemePreviewBackground}"
                                  BorderBrush="{Binding ThemePreviewSurfaceAlt}"
                                  BorderThickness="1"
                                  CornerRadius="16"
                                  Padding="14">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="10">
                              <Border Background="{Binding ThemePreviewSurface}"
                                      BorderBrush="{Binding ThemePreviewSurfaceAlt}"
                                      BorderThickness="1"
                                      CornerRadius="12"
                                      Padding="12">
                                <StackPanel Spacing="6">
                                  <TextBlock Text="{Binding CustomThemeName}"
                                             FontWeight="SemiBold"
                                             Foreground="{Binding ThemePreviewTextPrimary}" />
                                  <TextBlock Text="{Binding SelectedThemeColorSlot.Label}"
                                             Foreground="{Binding ThemePreviewTextSecondary}"
                                             FontSize="11" />
                                </StackPanel>
                              </Border>
                              <Border Grid.Row="1"
                                      Background="{Binding ThemePreviewSurfaceAlt}"
                                      CornerRadius="12"
                                      Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Border Background="{Binding ThemePreviewAccent}"
                                          CornerRadius="999"
                                          Padding="10,4">
                                    <TextBlock Text="{Binding DataContext.ThemePreviewAccentLabel, ElementName=Root}"
                                               Foreground="{Binding ThemePreviewAccent, Converter={StaticResource ContrastForegroundConverter}}"
                                               FontWeight="SemiBold" />
                                  </Border>
                                  <Border Background="{Binding ThemePreviewSurface}"
                                          BorderBrush="{Binding ThemePreviewSurfaceAlt}"
                                          BorderThickness="1"
                                          CornerRadius="999"
                                          Padding="10,4">
                                    <TextBlock Text="{Binding DataContext.ThemePreviewSurfaceLabel, ElementName=Root}"
                                               Foreground="{Binding ThemePreviewTextPrimary}" />
                                  </Border>
                                </StackPanel>
                              </Border>
                              <StackPanel Grid.Row="2"
                                          Spacing="4">
                                <TextBlock Text="{Binding DataContext.ThemePreviewPrimaryLabel, ElementName=Root}"
                                           Foreground="{Binding ThemePreviewTextPrimary}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DataContext.ThemePreviewSecondaryLabel, ElementName=Root}"
                                           Foreground="{Binding ThemePreviewTextSecondary}"
                                           FontSize="11" />
                              </StackPanel>
                            </Grid>
                          </Border>

                          <Border Background="{DynamicResource Surface1}"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="1"
                                  CornerRadius="12"
                                  Padding="12">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding ThemeBaseLabel}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11" />
                              <TextBlock Text="{Binding CustomThemeBase}"
                                         FontWeight="SemiBold" />
                              <TextBlock Text="{Binding SelectedThemeColorHex}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11" />
                            </StackPanel>
                          </Border>

                          <Expander Classes="app-section"
                                    Header="{Binding ThemeAdvancedLabel}">
                            <StackPanel Spacing="8"
                                        Margin="0,8,0,0">
                              <TextBlock Text="{Binding ThemeAdvancedDescription}"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11"
                                         TextWrapping="Wrap" />
                              <Border ClipToBounds="True"
                                      Background="Transparent">
                                <colorpicker:ColorView Color="{Binding SelectedThemeColor, Mode=TwoWay}"
                                                       Margin="6,-48,6,6"
                                                       ClipToBounds="False"
                                                       IsAlphaEnabled="False"
                                                       IsAlphaVisible="False"
                                                       IsColorComponentsVisible="True"
                                                       IsColorModelVisible="False"
                                                       IsColorPaletteVisible="False"
                                                       IsHexInputVisible="False"
                                                       IsComponentTextInputVisible="False"
                                                       IsColorPreviewVisible="False"
                                                       IsColorSpectrumVisible="False"
                                                       IsColorSpectrumSliderVisible="False"
                                                       IsComponentSliderVisible="True"
                                                       SelectedIndex="2" />
                              </Border>
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.Compact}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.CompactDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseCompactLayout, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.Avatars}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Appearance.AvatarsDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowProjectAvatars, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border x:Name="SettingsNotificationsCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.Enable}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.EnableDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnSuccess}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnSuccessDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnBackupSuccess, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnFailure}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnFailureDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnBackupFailure, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnLowDisk}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Notifications.OnLowDiskDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnLowDiskSpace, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border x:Name="SettingsAdvancedCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Border Classes="subtle-card"
                        Padding="12"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BuildInformationTitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BuildInformationDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                    </StackPanel>
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="{infra:LocalizedString Key=Settings.Advanced.BuildInformationCopy}"
                            Classes="action-ghost"
                            Command="{Binding CopyBuildInformationCommand}" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               Text="{Binding BuildInformationText}"
                               FontFamily="monospace"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Margin="0,6,0,0"
                               Text="{Binding BuildInformationCopyStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               IsVisible="{Binding HasBuildInformationCopyStatus}" />
                  </Grid>
                </Border>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.VerboseLogging}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.VerboseLoggingDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding EnableVerboseLogging, Mode=TwoWay}" />
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.SaveVerboseLogs}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.SaveVerboseLogsDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SaveVerboseLogs, Mode=TwoWay}"
                                  IsEnabled="{Binding EnableVerboseLogging}" />
                  </Grid>

                  <Grid ColumnDefinitions="*"
                        RowDefinitions="Auto,Auto"
                        Margin="0,6,0,0">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.LogConsole}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.LogConsoleDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1"
                               Margin="0,8,0,0"
                               Orientation="Horizontal"
                               ItemSpacing="8"
                               LineSpacing="8"
                               VerticalAlignment="Center">
                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.LogConsoleOpen}"
                              Classes="action-primary"
                              Command="{Binding OpenLogConsoleCommand}" />
                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.LogConsoleExport}"
                              Classes="action-ghost"
                              Command="{Binding ExportLogConsoleCommand}"
                              IsEnabled="{Binding EnableVerboseLogging}" />
                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.SupportBundleExport}"
                              Classes="action-ghost"
                              Command="{Binding ExportSupportBundleCommand}" />
                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.SupportBundleImport}"
                              Classes="action-ghost"
                              Command="{Binding ImportSupportBundleCommand}" />
                    </WrapPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto"
                        Margin="0,8,0,0">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CrashReportAssistance}" />
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CrashReportAssistanceDescription}"
                                 Foreground="{DynamicResource TextSecondary}"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CrashReportAssistanceEnabled, Mode=TwoWay}" />
                  </Grid>

                  <Border Classes="subtle-card"
                          Margin="0,8,0,0"
                          Padding="12"
                          CornerRadius="14">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.DoctorTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.DoctorDescription}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Border Classes="subtle-card"
                              Padding="12"
                              CornerRadius="12">
                        <StackPanel Spacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding MaintenanceWindowLabel}" />
                            <TextBlock Text="{Binding MaintenanceWindowDescription}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="8">
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="2">
                              <TextBlock Text="{Binding MaintenanceWindowStartLabel}" />
                              <TextBox Text="{Binding MaintenanceWindowStart}"
                                       PlaceholderText="01:00" />
                            </StackPanel>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="2">
                              <TextBlock Text="{Binding MaintenanceWindowEndLabel}" />
                              <TextBox Text="{Binding MaintenanceWindowEnd}"
                                       PlaceholderText="05:00" />
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding MaintenanceWindowPreviewLabel}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11" />
                              <Border Background="{DynamicResource AccentBrush}"
                                      CornerRadius="999"
                                      Padding="10,4"
                                      Opacity="0.14">
                                <TextBlock Text="{Binding MaintenanceWindowPreview}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" />
                              </Border>
                              <ToggleSwitch IsChecked="{Binding EnableMaintenanceWindow}"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>

                          <Grid ColumnDefinitions="*,Auto"
                                Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding MaintenanceWindowConsistencyLabel}" />
                              <TextBlock Text="{Binding MaintenanceWindowConsistencyDescription}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding MaintenanceRunConsistencyScan}" />
                          </Grid>

                          <Grid ColumnDefinitions="*,Auto"
                                Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding MaintenanceWindowRepairLabel}" />
                              <TextBlock Text="{Binding MaintenanceWindowRepairDescription}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding MaintenanceRunRepairDryRun}" />
                          </Grid>

                          <Grid ColumnDefinitions="*,Auto"
                                Margin="0,6,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding MaintenanceWindowMetadataLabel}" />
                              <TextBlock Text="{Binding MaintenanceWindowMetadataDescription}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding MaintenanceRunMetadataRefresh}" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Classes="subtle-card"
                              Padding="12"
                              CornerRadius="12">
                        <StackPanel Spacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BackupRepairTitle}" />
                            <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BackupRepairDescription}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <WrapPanel Orientation="Horizontal"
                                     ItemSpacing="8"
                                     LineSpacing="8">
                            <Button Content="{infra:LocalizedString Key=Settings.Advanced.BackupRepairScan}"
                                    Classes="action-ghost"
                                    Command="{Binding ScanBackupIndexRepairPlanCommand}" />
                            <Button Content="{infra:LocalizedString Key=Settings.Advanced.BackupRepairApply}"
                                    Classes="action-primary"
                                    Command="{Binding ApplyBackupIndexRepairPlanCommand}"
                                    IsEnabled="{Binding HasBackupIndexRepairActions}" />
                          </WrapPanel>
                          <TextBlock Text="{Binding BackupIndexRepairSummary}"
                                     FontWeight="SemiBold"
                                     IsVisible="{Binding HasBackupIndexRepairPlan}" />
                          <TextBlock Text="{Binding BackupIndexRepairDetails}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasBackupIndexRepairPlan}" />
                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.DoctorFixNowHint}"
                                     Foreground="{DynamicResource WarningTextBrush}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasBackupIndexRepairFindings}" />
                          <TextBlock Text="{Binding BackupIndexRepairStatus}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Classes="subtle-card"
                              Padding="12"
                              CornerRadius="12">
                        <StackPanel Spacing="8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsTitle}" />
                            <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsDescription}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Text="{Binding ProjectMetadataConflictStatus}"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                          <ItemsControl ItemsSource="{Binding ProjectMetadataConflicts}"
                                        IsVisible="{Binding HasProjectMetadataConflicts}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="subtle-card"
                                        Padding="10"
                                        CornerRadius="10"
                                        Margin="0,4,0,0">
                                  <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding ProjectName}"
                                                 FontWeight="SemiBold" />
                                      <TextBlock Foreground="{DynamicResource TextSecondary}"
                                                 FontSize="11"
                                                 TextWrapping="Wrap">
                                        <Run Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsSourceLabel}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding SourceMachineId}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SourceUpdatedUtc}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding RevisionSummary}" />
                                      </TextBlock>
                                      <TextBlock Text="{Binding ConflictingFields}"
                                                 Foreground="{DynamicResource WarningTextBrush}"
                                                 FontSize="11"
                                                 TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding ProvenanceSummary}"
                                                 Foreground="{DynamicResource TextSecondary}"
                                                 FontSize="10"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="MetadataConflictComparison"
                                                Spacing="8">
                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsAvatarColor}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="8"
                                              RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseAvatarColor}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalAvatarColor}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedAvatarColor}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.EncryptionPolicy}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseEncryptionPolicy}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalEncryptionPolicy}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedEncryptionPolicy}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.DestinationLabel}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BasePreferredDestinationId}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalPreferredDestinationId}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedPreferredDestinationId}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Backups.Restore.Mode.Label}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseRestoreMode}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalRestoreMode}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedRestoreMode}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Backups.Verification.Policy.Label}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseVerificationPolicy}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalVerificationPolicy}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedVerificationPolicy}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.AutoBackups}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseAutoBackupEnabled}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalAutoBackupEnabled}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedAutoBackupEnabled}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>

                                      <StackPanel Spacing="4">
                                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Label}"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                          <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsBaseLabel}" />
                                          <TextBlock Grid.Column="1" Text="{Binding BaseTags}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="1" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsLocalLabel}" />
                                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalTags}" TextWrapping="Wrap" />
                                          <TextBlock Grid.Row="2" Text="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsImportedLabel}" />
                                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImportedTags}" TextWrapping="Wrap" />
                                        </Grid>
                                      </StackPanel>
                                    </StackPanel>

                                    <WrapPanel Orientation="Horizontal"
                                               ItemSpacing="8"
                                               LineSpacing="8">
                                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsKeepLocal}"
                                              Classes="action-ghost"
                                              Command="{Binding #Root.DataContext.KeepLocalProjectMetadataConflictCommand}"
                                              CommandParameter="{Binding}" />
                                      <Button Content="{infra:LocalizedString Key=Settings.Advanced.MetadataConflictsAcceptImported}"
                                              Classes="action-primary"
                                              Command="{Binding #Root.DataContext.AcceptProjectMetadataConflictCommand}"
                                              CommandParameter="{Binding}" />
                                    </WrapPanel>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border Classes="subtle-card"
                                  Padding="10"
                                  IsVisible="{Binding HasUndoableProjectMetadataResolution}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <TextBlock Text="{Binding ProjectMetadataUndoStatus}"
                                         Foreground="{DynamicResource TextSecondary}"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="{infra:LocalizedString Key=Settings.Advanced.MetadataUndoAction}"
                                      Classes="action-ghost"
                                      Command="{Binding UndoProjectMetadataResolutionCommand}" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                <Border Classes="subtle-card"
                        Padding="12"
                        CornerRadius="12"
                        Margin="0,4,0,0"
                        IsVisible="{Binding IsStoreDistribution}">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateManagedByStoreTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateManagedByStoreDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextSecondary}">
                      <Run Text="{infra:LocalizedString Key=Settings.Advanced.UpdateChannelLabel}" />
                      <Run Text=": " />
                      <Run Text="{Binding DistributionChannelLabel}" />
                    </TextBlock>
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Classes="action-primary"
                            Command="{Binding OpenMicrosoftStoreCommand}">
                      <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateManagedByStoreOpen}" />
                    </Button>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0"
                      IsVisible="{Binding CanUseSelfUpdate}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CheckUpdates}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CheckUpdatesDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0"
                      IsVisible="{Binding CanUseSelfUpdate}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateInterval}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateIntervalDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding UpdateCheckIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Right"
                           IsEnabled="{Binding CheckForUpdatesOnStartup}" />
                </Grid>

                <Grid ColumnDefinitions="*"
                      RowDefinitions="Auto,Auto"
                      Margin="0,4,0,0"
                      IsVisible="{Binding CanUseSelfUpdate}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CheckUpdatesNow}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CheckUpdatesNowDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Row="1"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          Classes="action-primary"
                          Command="{Binding CheckUpdatesNowCommand}">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.CheckUpdatesNow}" />
                  </Button>
                </Grid>

                <StackPanel Margin="0,4,0,0" Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.UpdateStatusLabel}" />
                  <TextBlock Text="{Binding UpdateCheckStatusText}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" />
                  <Border Background="{DynamicResource Surface0}"
                          BorderBrush="{DynamicResource BorderSoft}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Margin="0,6,0,0"
                          Padding="10,8">
                    <ScrollViewer MaxHeight="180"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding UpdateDiagnosticsText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StartupDiagnosticsText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CheckpointResumeDiagnosticsText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                  <TextBlock Text="{Binding UpdateCheckErrorText}"
                             Foreground="{DynamicResource WarningTextBrush}"
                             FontSize="11"
                             IsVisible="{Binding HasUpdateCheckError}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0"
                      IsVisible="{Binding CanUseSelfUpdate}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BetaChannel}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BetaChannelDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding BetaChannelEnabled, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.BetaChannelWarning}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           FontSize="11"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           IsVisible="{Binding CanUseSelfUpdate}" />

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.LanguageLabel}" />
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.LanguageDescription}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ComboBox x:Name="LanguageSelectCombo"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Width="160"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Spacing="8">
                  <Button Command="{Binding ResetToDefaultsCommand}"
                          Classes="settings-ghost">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Advanced.ResetToDefaults}" />
                  </Button>
                </StackPanel>

              </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Border x:Name="SettingsDangerCard"
                    Classes="card"
                    CornerRadius="18"
                    Padding="16"
                    Margin="0,0,0,12">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.Title}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource DangerBrush}" />
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.Description}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Button Command="{Binding ClearLocalCacheCommand}"
                          Classes="settings-ghost">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.ClearCache}" />
                  </Button>
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.ClearCacheDescription}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" />
                </StackPanel>

                <StackPanel Spacing="6"
                            Margin="0,4,0,0">
                  <Button Command="{Binding ForgetAllProjectsCommand}"
                          Classes="settings-ghost">
                    <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.ForgetProjects}" />
                  </Button>
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Danger.ForgetProjectsDescription}"
                             Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" />
                </StackPanel>

              </StackPanel>
            </Border>

          </StackPanel>

        </Grid>

      </Grid>

  </ScrollViewer>

    <Border IsVisible="{Binding IsDestructivePreviewOpen}"
            Background="{DynamicResource OverlayScrimBrush}"
            Padding="24"
            AutomationProperties.LiveSetting="Polite">
      <Border Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource DangerBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="20"
              MaxWidth="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding DestructivePreviewTitle}"
                     FontSize="19"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding DestructivePreviewActionLabel}"
                     Foreground="{DynamicResource DangerTextBrush}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding DestructivePreviewDetail}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
            <Button Classes="settings-ghost"
                    Content="{infra:LocalizedString Key=Common.Cancel}"
                    Command="{Binding CancelDestructivePreviewCommand}" />
            <Button Classes="action-danger"
                    Content="{Binding DestructivePreviewActionLabel}"
                    Command="{Binding ConfirmDestructivePreviewCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>

</UserControl>
