<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VaultSync.UI.Views.SettingsView">
  <StackPanel Margin="16">
    <TextBlock Text="Settings" Classes="title" />
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="Application Settings Placeholder" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>