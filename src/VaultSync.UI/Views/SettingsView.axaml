<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             x:Class="VaultSync.UI.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusedBrush}" />
    </Style>

    <!-- Ghost button -->
    <Style Selector="Button.settings-ghost">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.settings-ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
  </UserControl.Styles>

    <UserControl.Resources>
      <controls:StatusToBrushConverter x:Key="StatusToBrushConverter" />
      <infra:BooleanToCharConverter x:Key="BoolToCharConverter" />
      <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="12">

    <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly">
      <Grid Width="1220"
            RowDefinitions="Auto,*"
            RowSpacing="12">

        <!-- Header -->
        <Border Grid.Row="0"
                Classes="card"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="section-title"
                       Text="Settings" />
            <TextBlock Text="Tune how VaultSync behaves across projects, backups, and storage."
                       Foreground="{StaticResource TextSecondary}" />
          </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="16">

          <!-- LEFT COLUMN -->
          <StackPanel Grid.Column="0"
                      Spacing="12">

            <!-- General -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="General" FontWeight="SemiBold" />
                  <TextBlock Text="Project discovery, startup behaviour, and layout."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <!-- Projects root -->
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      ColumnSpacing="8">
                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Spacing="2">
                    <TextBlock Text="Projects root" />
                    <TextBlock Text="Default folder where VaultSync looks for Unity projects."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>

                  <TextBox Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,2,0,0"
                           Text="{Binding ProjectsRootPath, Mode=TwoWay}"
                           Watermark="Leave empty to use OS default" />

                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,2,0,0"
                          Classes="settings-ghost"
                          Command="{Binding BrowseProjectsRootCommand}">
                    Browse
                  </Button>
                </Grid>

                <!-- Resume last session -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Resume where you left off" />
                    <TextBlock Text="Open VaultSync to the last page you were using."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ResumeLastSession, Mode=TwoWay}" />
                </Grid>

                <!-- Launch on login -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Launch at system startup" />
                    <TextBlock Text="Start VaultSync automatically when you sign in."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding LaunchOnLogin, Mode=TwoWay}" />
                </Grid>

                <!-- Show tray icon -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show tray icon" />
                    <TextBlock Text="Keep a tray/menu icon for quick actions." Foreground="{StaticResource TextSecondary}" FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                </Grid>

                <!-- Run in background when closing -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Run in background when closing" />
                    <TextBlock Text="Hide to tray instead of quitting when closing the window." Foreground="{StaticResource TextSecondary}" FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding RunInBackground, Mode=TwoWay}" />
                </Grid>

                <!-- Show main window on tray actions -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show main window for tray actions" />
                    <TextBlock Text="Bring VaultSync to front when starting backups or snapshots from the tray."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowWindowOnTrayActions, Mode=TwoWay}" />
                </Grid>

                <!-- Show mini backup widget when starting from tray -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show mini backup widget for tray backups" />
                    <TextBlock Text="Display a small draggable widget when a tray backup starts."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowTrayBackupWidget, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Backups -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Backups" FontWeight="SemiBold" />
                  <TextBlock Text="Automatic snapshots, retention, and backup location."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <!-- Enable auto backups -->
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Enable automatic backups" />
                    <TextBlock Text="VaultSync will take snapshots in the background while you work."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableAutoBackups, Mode=TwoWay}" />
                </Grid>

                <!-- Interval -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Backup interval (minutes)" />
                    <TextBlock Text="How often automatic snapshots are created."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding AutoBackupIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Right" />
                </Grid>

                <!-- Max snapshots per project -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Keep last N snapshots per project" />
                    <TextBlock Text="Older snapshots will be pruned once this limit is reached."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding MaxSnapshotsPerProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           HorizontalAlignment="Right" />
                </Grid>

                <!-- Backup location (legacy fallback) -->
                <Grid ColumnDefinitions="*,Auto,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      Margin="0,6,0,0"
                      ColumnSpacing="8"
                      IsVisible="{Binding ShowLegacyBackupLocation}">
                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Spacing="2">
                    <TextBlock Text="Fallback backup location" />
                    <TextBlock Text="Used only if no backup destinations are configured."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                    <Border Background="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=bg}"
                            BorderBrush="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="0,4,0,0">
                      <TextBlock Text="{Binding BackupLocationStatus}"
                                 Foreground="{Binding BackupLocationStatus, Converter={StaticResource StatusToBrushConverter}}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>

                  <TextBox Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,2,0,0"
                           Text="{Binding BackupLocationPath, Mode=TwoWay}"
                           Watermark="Leave empty to store backups next to projects" />

                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Margin="8,2,0,0"
                          Classes="settings-ghost"
                          Command="{Binding BrowseBackupLocationCommand}">
                    Browse
                  </Button>

                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Margin="8,2,0,0"
                          Classes="settings-ghost"
                          Command="{Binding TestBackupLocationCommand}">
                    Recheck
                  </Button>
                </Grid>

                <!-- Compression -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Compress backups" />
                    <TextBlock Text="Smaller backups at the cost of slightly longer backup times."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseBackupCompression, Mode=TwoWay}" />
                </Grid>

                <!-- Verify backups -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Verify backups after creation" />
                    <TextBlock Text="Run a quick integrity check after each snapshot."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding VerifyBackupsAfterCreate, Mode=TwoWay}" />
                </Grid>

                <!-- Full snapshot hashing -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Full snapshot hashing" />
                    <TextBlock Text="Hash all files on every snapshot (safer, but slower on large projects)."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseFullSnapshotHash, Mode=TwoWay}" />
                </Grid>

                <!-- Pause on battery -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Pause auto-backups on battery" />
                    <TextBlock Text="Avoid heavy disk operations while running on battery power."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PauseBackupsOnBattery, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Storage" FontWeight="SemiBold" />
                  <TextBlock Text="NAS awareness, free space, and drive health."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Prefer NAS / external volumes" />
                    <TextBlock Text="Use network or external drives as primary backup targets when available."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding PreferExternalDrives, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show drive health warnings" />
                    <TextBlock Text="Surface SMART / health warnings when VaultSync detects issues."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowDriveHealthWarnings, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Reserve free space (%)" />
                    <TextBlock Text="Stop creating new backups once a disk is below this threshold."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <TextBox Grid.Column="1"
                           Width="60"
                           HorizontalContentAlignment="Center"
                           Text="{Binding MinimumFreeSpacePercent, Mode=TwoWay}"
                           HorizontalAlignment="Right" />
                </Grid>

                <!-- Backup destinations + credentials -->
                <Border Margin="0,10,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource VsCardHighlightBrush}"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Backup destinations" FontWeight="SemiBold" />
                      <TextBlock Text="Configure multiple targets (local, external, or network)."
                                 Foreground="{StaticResource TextSecondary}"
                                 FontSize="11" />
                      <Button Classes="settings-ghost"
                              HorizontalAlignment="Left"
                              Command="{Binding OpenHelpCommand}">
                        Open help
                      </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Destinations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="8"
                                  Margin="0,4,0,0"
                                  CornerRadius="10"
                                  Background="{DynamicResource CardBackgroundBrush}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                              <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                <TextBox Width="120"
                                         MaxWidth="160"
                                         HorizontalAlignment="Left"
                                         Watermark="Alias"
                                         Text="{Binding Alias, Mode=TwoWay}" />
                                <ToggleSwitch IsChecked="{Binding Active, Mode=TwoWay}"
                                              Content="Active" />
                              </StackPanel>
                              <Grid Grid.Column="0" Grid.Row="1" ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="10">
                                <TextBox Grid.Column="0"
                                         MaxWidth="320"
                                         Watermark="Path (\\server\\share or /Volumes/Backup)"
                                         Text="{Binding Path, Mode=TwoWay}" />
                                <Button Grid.Column="1"
                                        Classes="settings-ghost"
                                        Command="{Binding DataContext.BrowseDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                  Select…
                                </Button>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DataContext.CredentialProfiles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedCredential, Mode=TwoWay}">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding LastTestStatus}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           IsVisible="{Binding LastTestStatus, Converter={StaticResource StringNotEmptyConverter}}" />
                              </Grid>
                              <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                <CheckBox Content="Pre-mounted/guest"
                                          ToolTip.Tip="Use if the share is already mounted or is guest-accessible."
                                          IsChecked="{Binding PreMounted, Mode=TwoWay}" />
                                <CheckBox Content="Auto-mount"
                                          ToolTip.Tip="Attempt to mount if unreachable using the selected credential."
                                          IsChecked="{Binding AutoMount, Mode=TwoWay}" />
                                <CheckBox Content="Auto-unmount"
                                          ToolTip.Tip="Unmount after backup if we mounted it."
                                          IsChecked="{Binding AutoUnmount, Mode=TwoWay}" />
                              </StackPanel>
                              <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Vertical" Spacing="4" Margin="0,8,0,0">
                                <TextBlock Text="Credential required for auto-mount"
                                           Foreground="#FF6B6B"
                                           FontSize="11"
                                           IsVisible="{Binding NeedsCredentialWarning}" />
                              </StackPanel>

                              <StackPanel Grid.Column="1" Grid.RowSpan="3"
                                          Orientation="Vertical"
                                          Spacing="6">
                                <TextBlock Text="{Binding LastTestStatus}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           IsVisible="{Binding LastTestStatus, Converter={StaticResource StringNotEmptyConverter}}" />
                                <Button Classes="settings-ghost"
                                        Content="Remove"
                                        Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="settings-ghost"
                            Command="{Binding AddDestinationCommand}">
                      Add destination
                    </Button>

                    <Separator />

                    <StackPanel Spacing="2">
                      <TextBlock Text="Credential profiles" FontWeight="SemiBold" />
                      <TextBlock Text="Saved accounts for NAS/SMB shares (stored in keychain/credential manager when possible)."
                                 Foreground="{StaticResource TextSecondary}"
                                 FontSize="11" />
                    </StackPanel>

                      <ItemsControl ItemsSource="{Binding CredentialProfiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="8"
                                  Margin="0,4,0,0"
                                  CornerRadius="10"
                                  Background="{DynamicResource CardBackgroundBrush}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                              <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Name" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Width="200"
                                         Text="{Binding Name, Mode=TwoWay}"
                                         Watermark="Profile name" />
                              </Grid>

                              <Grid Grid.Column="0" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Username" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Width="200"
                                         Text="{Binding Username, Mode=TwoWay}"
                                         Watermark="user or DOMAIN\\user" />
                              </Grid>

                              <Grid Grid.Column="0" Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="Password" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" ColumnDefinitions="200,Auto,Auto" ColumnSpacing="12">
                                  <TextBox Grid.Column="0"
                                           Width="200"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           Watermark="Stored locally"
                                           PasswordChar="{Binding ShowPassword, Converter={StaticResource BoolToCharConverter}, ConverterParameter=•}" />
                                  <ToggleSwitch Grid.Column="1"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding ShowPassword, Mode=TwoWay}"
                                                Content="Show" />
                                  <Button Grid.Column="2"
                                          Classes="settings-ghost"
                                          Content="Remove"
                                          Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                                </Grid>
                              </Grid>

                              <CheckBox Grid.Column="1" Grid.Row="0"
                                        Content="Use keychain/credman"
                                        IsChecked="{Binding UseKeychain, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="settings-ghost"
                            Command="{Binding AddCredentialCommand}">
                      Add credential
                    </Button>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>

          </StackPanel>

          <!-- RIGHT COLUMN -->
          <StackPanel Grid.Column="1"
                      Spacing="12">

            <!-- Appearance -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Appearance" FontWeight="SemiBold" />
                  <TextBlock Text="Control theme, density, and small visual tweaks."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Theme" />
                    <TextBlock Text="Follow system, or force light/dark."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>

                  <ComboBox Grid.Column="1"
                            Width="160"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Compact mode" />
                    <TextBlock Text="Use tighter spacing for dense project lists."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding UseCompactLayout, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Show project avatars" />
                    <TextBlock Text="Use icons or initials next to project names where available."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding ShowProjectAvatars, Mode=TwoWay}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Notifications" FontWeight="SemiBold" />
                  <TextBlock Text="Control when VaultSync grabs your attention."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Enable notifications" />
                    <TextBlock Text="Turn all VaultSync notifications on or off."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="On backup success" />
                    <TextBlock Text="Show a notification when a backup completes successfully."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnBackupSuccess, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="On backup failure" />
                    <TextBlock Text="Always notify when a backup fails."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnBackupFailure, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="On low disk space" />
                    <TextBlock Text="Warn when a backup target is nearly full."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding NotifyOnLowDiskSpace, Mode=TwoWay}"
                                IsEnabled="{Binding NotificationsEnabled}" />
                </Grid>

              </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Advanced" FontWeight="SemiBold" />
                  <TextBlock Text="Diagnostics, updates, and telemetry."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Enable verbose logging" />
                    <TextBlock Text="Write more detailed logs to help when debugging issues."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableVerboseLogging, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Check for updates on startup" />
                    <TextBlock Text="Track the GitHub Releases for the stable branch so you can grab the latest installer."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,4,0,0">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Send anonymous usage stats" />
                    <TextBlock Text="Help improve VaultSync by sharing basic, anonymised metrics."
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding SendAnonymousUsageStats, Mode=TwoWay}" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Spacing="8">
                  <Button Command="{Binding ResetToDefaultsCommand}"
                          Classes="settings-ghost">
                    Reset to defaults
                  </Button>
                </StackPanel>

              </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="16">
              <StackPanel Spacing="10">

                <StackPanel Spacing="2">
                  <TextBlock Text="Danger zone"
                             FontWeight="SemiBold"
                             Foreground="Tomato" />
                  <TextBlock Text="Destructive actions. These cannot be undone."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Button Command="{Binding ClearLocalCacheCommand}"
                          Classes="settings-ghost">
                    Clear local cache
                  </Button>
                  <TextBlock Text="Removes cached metadata and state. Project data is not deleted."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="11" />
                </StackPanel>

                <StackPanel Spacing="6"
                            Margin="0,4,0,0">
                  <Button Command="{Binding ForgetAllProjectsCommand}"
                          Classes="settings-ghost">
                    Forget all projects
                  </Button>
                  <TextBlock Text="Resets VaultSync's internal database (projects, snapshots, backups). No files on disk or NAS are removed."
                             Foreground="{StaticResource TextSecondary}"
                             FontSize="11" />
                </StackPanel>

              </StackPanel>
            </Border>

          </StackPanel>

        </Grid>

      </Grid>
    </Viewbox>

  </ScrollViewer>

</UserControl>
