<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
             xmlns:views="clr-namespace:VaultSync.UI.Views"
             x:Class="VaultSync.UI.Views.DiskCloningView"
             x:DataType="vm:DiskCloningViewModel"
             Background="{DynamicResource VS.WindowBackground}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <views:DiskRecoveryView DataContext="{Binding DiskRecovery}" />
  </ScrollViewer>
</UserControl>
