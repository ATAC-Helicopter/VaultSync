<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.ScheduleView"
    x:DataType="vm:ScheduleViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid MaxWidth="1200"
          HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="16">

      <Border Grid.Row="0" Classes="card" Padding="20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Schedule.Overview.Title}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding DelayExplanation}"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Classes="stat-pill lg info" VerticalAlignment="Center">
            <StackPanel Spacing="2">
              <TextBlock Text="{infra:LocalizedString Key=Schedule.NextRun.Label}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Text="{CompiledBinding NextRunText}"
                         FontSize="16"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Grid.Column="0" Classes="card" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{infra:LocalizedString Key=Schedule.Mode.Title}"
                         FontSize="17"
                         FontWeight="SemiBold" />
              <TextBlock Text="{infra:LocalizedString Key=Schedule.Mode.Description}"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <RadioButton GroupName="ScheduleMode"
                         IsChecked="{CompiledBinding IsAutomaticMode, Mode=TwoWay}"
                         Command="{CompiledBinding UseAutomaticModeCommand}"
                         Content="{infra:LocalizedString Key=Schedule.Mode.Automatic}" />
            <RadioButton GroupName="ScheduleMode"
                         IsChecked="{CompiledBinding IsManualMode, Mode=TwoWay}"
                         Command="{CompiledBinding UseManualModeCommand}"
                         Content="{infra:LocalizedString Key=Schedule.Mode.Manual}" />

            <Grid ColumnDefinitions="*,120" ColumnSpacing="16" IsEnabled="{CompiledBinding IsAutomaticMode}">
              <StackPanel Spacing="3">
                <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.Interval}" />
                <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.IntervalDescription}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
              </StackPanel>
              <NumericUpDown Grid.Column="1"
                             Minimum="1"
                             Maximum="10080"
                             Increment="5"
                             Value="{CompiledBinding IntervalMinutes, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="20">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.QuietHours}"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="{CompiledBinding QuietHoursSummary}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{CompiledBinding EnableQuietHours, Mode=TwoWay}"
                            IsEnabled="{CompiledBinding IsAutomaticMode}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12"
                  IsEnabled="{CompiledBinding CanEditQuietHours}">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.QuietHoursStart}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{CompiledBinding QuietHoursStart, Mode=TwoWay}"
                         HorizontalContentAlignment="Center"
                         PlaceholderText="HH:mm" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Settings.Backups.QuietHoursEnd}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{CompiledBinding QuietHoursEnd, Mode=TwoWay}"
                         HorizontalContentAlignment="Center"
                         PlaceholderText="HH:mm" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Classes="card" Padding="18" Background="{DynamicResource Surface2}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Text="ⓘ" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Grid.Column="1"
                     Text="{infra:LocalizedString Key=Schedule.SaveHint}"
                     Foreground="{DynamicResource TextSecondary}"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
