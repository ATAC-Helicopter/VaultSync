<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    x:Class="VaultSync.UI.Views.GuideView"
    x:DataType="vm:GuideViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <StackPanel Spacing="18" MaxWidth="1040" HorizontalAlignment="Center">
      <Grid x:Name="GuideHeaderGrid" ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="{CompiledBinding PageTitle}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding PageDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{CompiledBinding ProgressSummary}"
                     Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel x:Name="GuideHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Classes="action-ghost" Content="{CompiledBinding RestartSetupLabel}"
                  Command="{CompiledBinding RestartSetupCommand}" />
          <Button Classes="action-ghost" Content="{CompiledBinding DocumentationLabel}"
                  Command="{CompiledBinding OpenDocumentationCommand}" />
        </StackPanel>
      </Grid>

      <Border Classes="card" Padding="20">
        <StackPanel Spacing="8">
          <TextBlock Text="{CompiledBinding RecoveryRuleTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding RecoveryRuleBody}"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <ItemsControl x:Name="GuideTopicsItems" ItemsSource="{CompiledBinding Topics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GuideTopicViewModel">
            <Border Classes="card" Margin="0,0,12,12" Padding="20" MinHeight="205">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Width="34" Height="34" CornerRadius="17"
                          Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{CompiledBinding Number}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{CompiledBinding Title}"
                             FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{CompiledBinding Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Row="2" Classes="action-primary" HorizontalAlignment="Left"
                        Content="{CompiledBinding ActionLabel}" Command="{CompiledBinding ActionCommand}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Padding="20">
        <StackPanel Spacing="6">
          <TextBlock Text="{CompiledBinding TerminologyTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding TerminologyDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl x:Name="GuideTermsItems" ItemsSource="{CompiledBinding Terms}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GuideTermViewModel">
            <Border Classes="card" Margin="0,0,12,12" Padding="16" MinHeight="142">
              <StackPanel Spacing="7">
                <TextBlock Text="{CompiledBinding Title}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="{CompiledBinding Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
