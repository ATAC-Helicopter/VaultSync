<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
        xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
        xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
        x:Class="VaultSync.UI.Views.SnapshotExplorerView"
        x:DataType="vm:SnapshotExplorerViewModel"
        Width="980"
        Height="680"
        MinWidth="780"
        MinHeight="520"
        Title="{Binding Title}">
  <Window.Styles>
    <Style Selector="#SnapshotEntryList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="0">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="#SnapshotEntryList ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    </Style>
    <Style Selector="#SnapshotEntryList ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentPathDisplay}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="{infra:LocalizedString Key=SnapshotExplorer.Action.Up}"
                Classes="small-button"
                Command="{Binding GoUpCommand}" />
        <Button Content="{infra:LocalizedString Key=Common.Refresh}"
                Classes="small-button"
                Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox PlaceholderText="{infra:LocalizedString Key=SnapshotExplorer.Search.Watermark}"
               Text="{Binding SearchText, Mode=TwoWay}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="{infra:LocalizedString Key=SnapshotExplorer.Action.Search}"
                Classes="small-button"
                Command="{Binding RefreshCommand}" />
        <Button Content="{infra:LocalizedString Key=Common.Clear}"
                Classes="small-button"
                Command="{Binding ClearSearchCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="14">
      <Border Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0"
                     Margin="12,10,12,6"
                     Text="{infra:LocalizedString Key=SnapshotExplorer.Section.Contents}"
                     FontWeight="SemiBold" />
          <ListBox x:Name="SnapshotEntryList"
                   Grid.Row="1"
                   SelectionMode="Single"
                   ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SnapshotExplorerEntryViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="8,6">
                  <Border Grid.Row="0"
                          Grid.RowSpan="2"
                          Grid.Column="0"
                          Width="{Binding Indent}" />
                  <TextBlock Grid.Row="0"
                             Grid.RowSpan="2"
                             Grid.Column="1"
                             Text="{Binding ToggleGlyph}"
                             Width="18"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="0"
                             Grid.Column="2"
                             Text="{Binding Name}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="0"
                             Grid.Column="3"
                             Text="{Binding KindLabel}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="10,0,0,0" />
                  <StackPanel Grid.Row="1"
                              Grid.Column="2"
                              Grid.ColumnSpan="2"
                              Orientation="Horizontal"
                              Spacing="10">
                    <TextBlock Text="{Binding SizeLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ModifiedLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,12,6">
            <TextBlock Text="{infra:LocalizedString Key=SnapshotExplorer.Section.Preview}"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="{infra:LocalizedString Key=Common.Open}"
                      Classes="small-button"
                      Command="{Binding OpenSelectedCommand}" />
              <Button Content="{infra:LocalizedString Key=SnapshotExplorer.Action.Preview}"
                      Classes="small-button"
                      Command="{Binding PreviewSelectedCommand}" />
              <Button Content="{infra:LocalizedString Key=SnapshotExplorer.Action.Restore}"
                      Classes="small-button"
                      Command="{Binding RestoreSelectedCommand}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <Border Margin="12"
                    Padding="16"
                    CornerRadius="8"
                    Background="{DynamicResource Surface3}"
                    IsVisible="{Binding IsEncryptedBackup}">
              <TextBlock Text="{Binding EncryptedBackupMessage}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Margin="12"
                    Padding="12"
                    CornerRadius="6"
                    Background="#101722"
                    IsVisible="{Binding !IsEncryptedBackup}">
              <ScrollViewer
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <controls:CodePreviewBlock CodeText="{Binding PreviewText}"
                                           FileName="{Binding PreviewFileName}"
                                           Foreground="#E8EEF7" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3"
               Text="{Binding StatusText}"
               Foreground="{DynamicResource TextSecondaryBrush}"
               TextWrapping="Wrap" />
  </Grid>
</Window>
