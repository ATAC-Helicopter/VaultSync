<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.OnboardingWindow"
    x:DataType="vm:OnboardingViewModel"
    Width="560"
    Height="520"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Title="{infra:LocalizedString Key=Onboarding.Title}">

  <Border Padding="20" Background="{DynamicResource Surface0}">
    <Border Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="18">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock Text="{CompiledBinding Title}"
                     FontSize="22"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Subtitle}"
                     Foreground="{DynamicResource TextSecondary}"
                     FontSize="13" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{CompiledBinding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OnboardingStep">
              <Border Background="{DynamicResource Surface2}"
                      BorderBrush="{DynamicResource BorderSoft}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="14"
                      Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Width="30"
                          Height="30"
                          CornerRadius="15"
                          Background="{DynamicResource AccentBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <TextBlock Text="{CompiledBinding Number}"
                               Foreground="{DynamicResource TextOnPillBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{CompiledBinding Text}"
                             TextWrapping="Wrap"
                             LineHeight="22"
                             Foreground="{DynamicResource TextSecondary}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
          <Button Content="{infra:LocalizedString Key=Onboarding.OpenProjects}"
                  Command="{CompiledBinding OpenProjectsCommand}"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource TextOnPillBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  CornerRadius="10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{infra:LocalizedString Key=Onboarding.Close}"
                  Command="{CompiledBinding CloseCommand}"
                  Background="{DynamicResource Surface2}"
                  Foreground="{DynamicResource TextPrimary}"
                  BorderBrush="{DynamicResource BorderSoft}"
                  CornerRadius="10"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>
