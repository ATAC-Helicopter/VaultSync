<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
        xmlns:svc="clr-namespace:VaultSync.UI.Services"
        xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
        x:Class="VaultSync.UI.Views.LogConsoleWindow"
        x:DataType="vm:LogConsoleViewModel"
        Width="900"
        Height="600"
        Title="{infra:LocalizedString Key=LogConsole.WindowTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource PagePadding}" RowSpacing="{DynamicResource PageRowSpacing}">
    <Border Classes="card"
            Margin="0"
            Padding="{DynamicResource CardPaddingSmall}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
        <StackPanel Grid.Row="0" Spacing="2">
          <TextBlock Text="{infra:LocalizedString Key=LogConsole.Header}"
                     FontSize="18"
                     FontWeight="SemiBold" />
          <TextBlock Text="{infra:LocalizedString Key=LogConsole.Description}"
                     Foreground="{StaticResource TextSecondary}"
                     FontSize="11"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <CheckBox Content="{infra:LocalizedString Key=LogConsole.AutoScroll}"
                    IsChecked="{Binding AutoScrollEnabled, Mode=TwoWay}"
                    VerticalAlignment="Center" />
          <Button Content="{infra:LocalizedString Key=LogConsole.CopySelected}"
                  Classes="action-ghost"
                  Click="OnCopySelectionClicked" />
          <Button Content="{infra:LocalizedString Key=LogConsole.OpenFolder}"
                  Classes="action-ghost"
                  Command="{Binding OpenFolderCommand}" />
          <Button Content="{infra:LocalizedString Key=LogConsole.Clear}"
                  Classes="action-ghost"
                  Command="{Binding ClearCommand}" />
          <Button Content="{infra:LocalizedString Key=LogConsole.Export}"
                  Classes="action-primary"
                  Command="{Binding ExportCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Classes="card"
            Margin="0"
            Padding="{DynamicResource CardPaddingSmall}">
      <ListBox x:Name="LogList"
               ItemsSource="{Binding Lines}"
               SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
               SelectionMode="Multiple"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="svc:LogLine">
            <Border Padding="6,4"
                    CornerRadius="4"
                    ToolTip.Tip="{Binding RawDisplay}">
              <Grid ColumnDefinitions="72,64,*"
                    ColumnSpacing="8">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Top"
                           Margin="0,3,0,0" />
                <Border Grid.Column="1"
                        Width="52"
                        Height="24"
                        Background="{Binding SourceBackground}"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                  <TextBlock Text="{Binding SourceText}"
                             FontFamily="Consolas"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{Binding SourceForeground}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding MessageText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Top"
                           LineHeight="18" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
