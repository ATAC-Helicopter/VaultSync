<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    x:Class="VaultSync.UI.Views.DashboardView"
    x:CompileBindings="False"
    Background="{DynamicResource VS.WindowBackground}">

  <!-- Vertical scroll for short windows. The whole page scales uniformly inside. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">

    <!-- Scale EVERYTHING uniformly from this design width -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
      <Grid Width="1220">
        <!-- 5 rows: 0 Header, 1 KPIs, 2 Actions, 3 Charts, 4 Activity -->
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Classes="header" Padding="16" Grid.Row="0" Margin="4">
          <StackPanel Spacing="6">
            <TextBlock Text="Dashboard" Classes="section-title" FontSize="28"/>
            <TextBlock Text="Overview of projects, backups and latest activity" Classes="kicker" FontSize="18"/>
          </StackPanel>
        </Border>

        <!-- KPI row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="4,8,4,0">
          <Border Classes="card" Padding="20" Grid.Column="0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="Projects" Classes="kicker"/>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding ProjectCount}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProjectsHint}" Classes="metric-hint"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="20" Grid.Column="1">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="Snapshots" Classes="kicker"/>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding SnapshotCount}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SnapshotsHint}" Classes="metric-hint"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="20" Grid.Column="2">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="Storage" Classes="kicker"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding StorageUsed}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StorageHint}" Classes="metric-hint" VerticalAlignment="Bottom"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,12,4,0">
          <TextBox Watermark="Search projects…" Text="{Binding SearchText}" />
          <Button Grid.Column="1" Command="{Binding RefreshCommand}">Refresh</Button>
          <Button Grid.Column="2" Command="{Binding NewSnapshotCommand}">New Snapshot</Button>
        </Grid>

        <!-- Charts row -->
        <Grid Grid.Row="3" ColumnDefinitions="2*,1*" ColumnSpacing="16" Margin="4,12,4,0">
          <!-- Trend -->
          <Border Classes="card" Padding="14" Grid.Column="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0">
                <TextBlock Text="Snapshots this week" Classes="section-title"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="8,4"
                        Background="{DynamicResource ItemBg}">
                  <TextBlock Text="{Binding TotalSnapshotsWeek, StringFormat='{}{0} this week'}" FontWeight="SemiBold"/>
                </Border>
              </Grid>
              <lvc:CartesianChart Grid.Row="1"
                                  Series="{Binding SnapshotSeries}"
                                  XAxes="{Binding SnapshotXAxes}"
                                  YAxes="{Binding SnapshotYAxes}"
                                  Background="{Binding $parent[Border].Background}"
                                  LegendPosition="Hidden"
                                  Height="360"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
            </Grid>
          </Border>

          <!-- Donut -->
          <Border Classes="card" Padding="14" Grid.Column="1">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Text="Storage usage" Classes="section-title" Margin="0,0,0,8"/>

              <Grid Grid.Row="1">
                <lvc:PieChart
                    Series="{Binding StorageSeries}"
                    Background="{Binding $parent[Border].Background}"
                    LegendPosition="Hidden"
                    Height="360"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

                <!-- Center label -->
                <StackPanel IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2">
                  <TextBlock Text="{Binding StorageUsed}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="used" Classes="metric-hint" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Legend -->
              <ItemsControl Grid.Row="2" ItemsSource="{Binding StorageLegend}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                      <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}"/>
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>

        <!-- Recent activity -->
        <Border Classes="card" Padding="14" Margin="4,12,4,0" Grid.Row="4">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="Recent activity" Classes="section-title" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActivityItems}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ItemBg}" CornerRadius="12" Margin="0,6,0,6" Padding="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Title}" Classes="kicker"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </ScrollViewer>
</UserControl>