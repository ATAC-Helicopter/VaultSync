<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VaultSync.UI.Views.DashboardView">
  <StackPanel Margin="16">
    <TextBlock Text="Dashboard" Classes="title" />
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="Welcome to VaultSync!" />
        <TextBlock Text="Use the sidebar to navigate between sections." Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>