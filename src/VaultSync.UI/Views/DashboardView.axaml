<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:vm="using:VaultSync.UI.ViewModels"
    xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
    x:Class="VaultSync.UI.Views.DashboardView"
    x:DataType="vm:DashboardViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid MaxWidth="2200"
          HorizontalAlignment="Stretch"
          MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="{DynamicResource PageRowSpacing}">

      <WrapPanel Grid.Row="0"
                 Margin="4,8,4,0"
                 Orientation="Horizontal"
                 ItemSpacing="16"
                 LineSpacing="16"
                 HorizontalAlignment="Left">
        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="176" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Dashboard.Kpi.RestoreReadiness}" Classes="kicker"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding RestoreReadinessHeadline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
            <TextBlock Grid.Row="2" Text="{Binding RestoreReadinessDetail}" Classes="metric-hint" TextWrapping="Wrap" MaxLines="2"/>
            <Button Grid.Row="3" Classes="small-pill" Content="{infra:LocalizedString Key=Dashboard.Workflow.Recovery}" Command="{Binding OpenRecoveryCommand}" HorizontalAlignment="Left"/>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="176" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=RestoreReadiness.ReviewTitle}" Classes="kicker"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding RequiredActionTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
            <TextBlock Grid.Row="2" Text="{Binding RequiredActionDetail}" Classes="metric-hint" TextWrapping="Wrap" MaxLines="3"/>
            <Button Grid.Row="3" Classes="small-pill" Content="{infra:LocalizedString Key=RestoreReadiness.Review}" Command="{Binding OpenRecoveryCommand}" HorizontalAlignment="Left"/>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="176" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Schedule.NextRun.Label}" Classes="kicker"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding NextRunText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
            <TextBlock Grid.Row="2" Text="{Binding NextRunDetail}" Classes="metric-hint" TextWrapping="Wrap" MaxLines="3"/>
            <Button Grid.Row="3" Classes="small-pill" Content="{infra:LocalizedString Key=Shell.Nav.Schedule}" Command="{Binding OpenScheduleCommand}" HorizontalAlignment="Left"/>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="176" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=History.Status.KnownGood}" Classes="kicker"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding LatestKnownGoodTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
            <TextBlock Grid.Row="2" Text="{Binding LatestKnownGoodDetail}" Classes="metric-hint" TextWrapping="Wrap" MaxLines="3"/>
            <Button Grid.Row="3" Classes="small-pill" Content="{infra:LocalizedString Key=Dashboard.Workflow.History}" Command="{Binding OpenHistoryCommand}" HorizontalAlignment="Left"/>
          </Grid>
        </Border>
      </WrapPanel>

      <WrapPanel Grid.Row="1"
                 Margin="4,8,4,0"
                 Orientation="Horizontal"
                 ItemSpacing="16"
                 LineSpacing="16"
                 HorizontalAlignment="Left">
        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="192" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Dashboard.Kpi.Projects}" Classes="kicker" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding ProjectCount}"
                       FontSize="40"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2"
                       Text="{Binding ProjectsHint}"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2"/>
            <Border Grid.Row="3"
                    Background="{DynamicResource ItemBg}"
                    CornerRadius="12"
                    Padding="12,10">
              <TextBlock Text="{Binding ProjectsHint}"
                         Classes="metric-hint"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="1"/>
            </Border>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="192" Padding="18">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Dashboard.Kpi.Backups}" Classes="kicker" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding SnapshotCount}"
                       FontSize="40"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2"
                       Text="{Binding SnapshotsHint}"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2"/>
            <Border Grid.Row="3"
                    Background="{DynamicResource ItemBg}"
                    CornerRadius="12"
                    Padding="12,10"
                    HorizontalAlignment="Left">
              <TextBlock Text="{Binding TotalSnapshotsWeekLabel}"
                         FontSize="12"
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="336" MinHeight="192" Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Dashboard.Kpi.Storage}" Classes="kicker" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding StorageUsed}"
                       FontSize="40"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2"
                       Text="{Binding StorageUsedLocal}"
                       FontSize="16"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2"/>
            <Border Grid.Row="3"
                    Background="{DynamicResource ItemBg}"
                    CornerRadius="12"
                    Padding="12,10">
              <TextBlock Text="{Binding StorageHint}"
                         Classes="metric-hint"
                         TextWrapping="Wrap"
                         MaxLines="2"/>
            </Border>
          </Grid>
        </Border>

        <Border Classes="card" Background="{DynamicResource Surface2}" Width="500" MinHeight="224" Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{infra:LocalizedString Key=Dashboard.Kpi.RestoreReadiness}" Classes="kicker" VerticalAlignment="Center"/>
              <Button Grid.Column="2"
                      Classes="small-pill"
                      Content="{infra:LocalizedString Key=RestoreReadiness.Review}"
                      Command="{Binding ToggleRestoreReadinessIssuesCommand}"
                      IsVisible="{Binding HasRestoreReadinessIssues}" />
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding RestoreReadinessHeadline}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxLines="3"/>
            <TextBlock Grid.Row="2"
                       Text="{Binding RestoreReadinessDetail}"
                       FontSize="15"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2"/>
            <Border Grid.Row="3"
                    Background="{DynamicResource ItemBg}"
                    CornerRadius="12"
                    Padding="12,10">
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Border Classes="stat-pill sm success">
                  <TextBlock Text="{Binding RestoreReadinessReadyLabel}" FontSize="10" FontWeight="SemiBold" MaxWidth="96" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Border Classes="stat-pill sm warning">
                  <TextBlock Text="{Binding RestoreReadinessAttentionLabel}" FontSize="10" FontWeight="SemiBold" MaxWidth="96" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Border Classes="stat-pill sm danger">
                  <TextBlock Text="{Binding RestoreReadinessRiskLabel}" FontSize="10" FontWeight="SemiBold" MaxWidth="96" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Border Classes="stat-pill sm info">
                  <TextBlock Text="{Binding RestoreReadinessUnavailableLabel}" FontSize="10" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                </Border>
              </WrapPanel>
            </Border>
            <StackPanel Grid.Row="4" Spacing="7">
              <TextBlock Text="{Binding RecoveryCoverageDetail}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         MaxLines="2" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Border Classes="stat-pill sm info"><TextBlock Text="{Binding RecoveryCoverage24Label}" FontSize="10"/></Border>
                <Border Classes="stat-pill sm info"><TextBlock Text="{Binding RecoveryCoverage7Label}" FontSize="10"/></Border>
                <Border Classes="stat-pill sm info"><TextBlock Text="{Binding RecoveryCoverage30Label}" FontSize="10"/></Border>
                <Border Classes="stat-pill sm info"><TextBlock Text="{Binding RecoveryCoverage90Label}" FontSize="10"/></Border>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </WrapPanel>

      <Border Grid.Row="2"
              Classes="card"
              IsVisible="{Binding ShowRestoreReadinessIssues}"
              Padding="{DynamicResource CardPaddingSmall}"
              Margin="4,8,4,0"
              Background="{DynamicResource Surface2}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{infra:LocalizedString Key=RestoreReadiness.ReviewTitle}" Classes="section-title"/>
              <TextBlock Text="{Binding RestoreReadinessDetail}" Classes="metric-hint" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="small-pill"
                    Content="{infra:LocalizedString Key=RestoreReadiness.ReviewOpenBackups}"
                    Command="{Binding OpenBackupsCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
            <Button Grid.Column="2"
                    Classes="small-pill"
                    Content="{infra:LocalizedString Key=RestoreReadiness.Review}"
                    Command="{Binding ToggleRestoreReadinessIssuesCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
          </Grid>

          <ItemsControl ItemsSource="{Binding RestoreReadinessIssues}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="320"
                        MinHeight="96"
                        CornerRadius="14"
                        Background="{DynamicResource ItemBg}"
                        BorderBrush="{DynamicResource BorderSoft}"
                        BorderThickness="1"
                        Padding="12">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="10"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="6">
                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{Binding StateBrush}"
                            Margin="0,5,0,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProjectName}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2"
                            Classes="stat-pill sm"
                            Background="{Binding StateBrush}"
                            BorderBrush="{Binding StateBrush}">
                      <TextBlock Text="{Binding StateLabel}"
                                 FontSize="10"
                                 Foreground="{Binding StateBrush, Converter={StaticResource ContrastForegroundConverter}}" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Reason}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid x:Name="ActivitySectionsGrid"
            Grid.Row="3"
            ColumnDefinitions="1.65*,0.85*"
            ColumnSpacing="16"
            Margin="4,12,4,0">
        <Border x:Name="WeeklyActivityCard"
                Grid.Column="0"
                Classes="card"
                Background="{DynamicResource Surface2}"
                Padding="{DynamicResource CardPaddingSmall}">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.BackupsThisWeek}" Classes="section-title"/>
              <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="10,5" Background="{DynamicResource ItemBg}">
                <TextBlock Text="{Binding TotalSnapshotsWeekLabel}" FontWeight="SemiBold"/>
              </Border>
            </Grid>

            <Grid x:Name="WeeklyActivityContentGrid"
                  Grid.Row="1"
                  ColumnDefinitions="4.4*,7.6*"
                  ColumnSpacing="12">
              <Border x:Name="WeeklyActivitySummary"
                      Grid.Column="0"
                      Background="{DynamicResource Surface2}"
                      CornerRadius="12"
                      Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                  <WrapPanel Grid.Row="0" ItemSpacing="10" LineSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAuto}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterManual}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Snapshot.Type.Imported}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </WrapPanel>

                  <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource ItemBg}" Padding="10,8">
                    <TextBlock Text="{Binding SnapshotActivitySummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  </Border>

                  <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource ItemBg}" Padding="10,8">
                    <TextBlock Text="{Binding SnapshotsSummaryLine}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                  </Border>

                  <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding WeeklyAverageLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border Grid.Row="1" Height="6" CornerRadius="3" Background="{DynamicResource DividerBrush}" Opacity="0.25"/>
                  </Grid>
                </Grid>
              </Border>

              <Border x:Name="WeeklyActivityChart"
                      Grid.Column="1"
                      Background="{DynamicResource Surface1}"
                      CornerRadius="12"
                      Padding="12"
                      MinHeight="320"
                      VerticalAlignment="Stretch">
                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">
                  <Grid Grid.Row="0">
                    <Canvas VerticalAlignment="Bottom">
                      <shapes:Path Data="M0,0 L1,0"
                                   Stretch="Fill"
                                   Stroke="{DynamicResource TextSecondaryBrush}"
                                   StrokeDashArray="2,4"
                                   StrokeThickness="1"
                                   Opacity="0.65"
                                   Height="1"
                                   Canvas.Left="0"
                                   Canvas.Right="0"
                                   Canvas.Bottom="{Binding WeeklyAverageLineOffset}"/>
                    </Canvas>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DividerBrush}" Opacity="0.25"/>
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource DividerBrush}" Opacity="0.12"/>
                    <ItemsControl ItemsSource="{Binding WeeklySnapshotActivity}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="2,0" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding TooltipText}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                              <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource DividerBrush}" Opacity="0.2" Margin="0,6,0,6" CornerRadius="1"/>
                              <StackPanel Width="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="3">
                                <Border Height="{Binding ImportedHeight}" Width="24" HorizontalAlignment="Center" Background="{Binding ImportedBrush}" CornerRadius="12" IsVisible="{Binding HasImported}"/>
                                <Border Height="{Binding ManualHeight}" Width="24" HorizontalAlignment="Center" Background="{Binding ManualBrush}" CornerRadius="12" IsVisible="{Binding HasManual}"/>
                                <Border Height="{Binding AutoHeight}" Width="24" HorizontalAlignment="Center" Background="{Binding AutoBrush}" CornerRadius="12" IsVisible="{Binding HasAuto}"/>
                                <Border Height="{Binding EmptyHeight}" Width="24" HorizontalAlignment="Center" MinHeight="8" Background="{Binding EmptyBrush}" CornerRadius="12" IsVisible="{Binding IsEmpty}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>

                  <ItemsControl Grid.Row="1" ItemsSource="{Binding WeeklySnapshotActivity}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DayLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Grid.Row="2" Margin="0,2,0,0" Padding="10,8" CornerRadius="10" Background="{DynamicResource ItemBg}">
                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                      <TextBlock Text="{Binding SnapshotActivitySummary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip.Tip="{Binding SnapshotActivitySummary}"/>
                      <TextBlock Text="{Binding SnapshotsSummaryLine}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" ToolTip.Tip="{Binding SnapshotsSummaryLine}"/>
                    </WrapPanel>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="RecentActivityCard"
                Grid.Column="1"
                Classes="card"
                Padding="{DynamicResource CardPaddingSmall}">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.RecentActivity}" Classes="section-title"/>
              <TextBlock Text="{Binding SnapshotsSummaryLine}" Classes="metric-hint" TextWrapping="Wrap"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
              <Button Classes="small-pill"
                      Content="{infra:LocalizedString Key=Dashboard.Workflow.History}"
                      Command="{Binding OpenHistoryCommand}"/>
              <Button Classes="small-pill"
                      Content="{infra:LocalizedString Key=Dashboard.Workflow.Recovery}"
                      Command="{Binding OpenRecoveryCommand}"/>
              <Button Classes="small-pill"
                      Content="{infra:LocalizedString Key=Dashboard.Workflow.Backups}"
                      Command="{Binding OpenBackupsCommand}"/>
            </WrapPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360">
              <ItemsControl ItemsSource="{Binding ActivityItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource ItemBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="10">
                      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                          <TextBlock Text="{Binding Title}" Classes="kicker"/>
                          <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}"/>
                          <ItemsControl ItemsSource="{Binding ProjectTagChips}" IsVisible="{Binding HasProjectTags}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border CornerRadius="999"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding Border}"
                                        BorderThickness="1"
                                        Padding="8,3">
                                  <TextBlock Text="{Binding Value}"
                                             FontSize="10"
                                             FontWeight="SemiBold"
                                             Foreground="{Binding Foreground}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="StorageSectionsGrid"
            Grid.Row="4"
            ColumnDefinitions="1.15*,0.85*"
            ColumnSpacing="16"
            Margin="4,12,4,0">
        <Border x:Name="StorageUsageCard"
                Grid.Column="0"
                Classes="card"
                Padding="{DynamicResource CardPaddingSmall}"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid x:Name="StorageHeaderGrid"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.StorageUsage}"
                         Classes="section-title"
                         Margin="0,0,0,2"/>
              <ComboBox x:Name="StorageSortSelector"
                        Grid.Column="1"
                        ItemsSource="{Binding StorageSortOptions}"
                        SelectedItem="{Binding SelectedStorageSortOption}"
                        MinWidth="150"
                        HorizontalAlignment="Right">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Grid x:Name="StorageBreakdownGrid"
                  Grid.Row="1"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  VerticalAlignment="Top">
              <Grid x:Name="StorageDonutHost"
                    Grid.Column="0"
                    Width="300"
                    Height="300"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Border x:Name="StorageDonutTrack"
                        Width="290"
                        Height="290"
                        CornerRadius="145"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="14"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Opacity="0.35"/>

                <lvc:PieChart x:Name="StorageDonutChart"
                              Series="{Binding StorageSeries}"
                              Background="{Binding $parent[Border].Background}"
                              LegendPosition="Hidden"
                              ClipToBounds="True"
                              Width="290"
                              Height="290"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"/>

                <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding StorageUsed}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.StorageUsageLabel}" Classes="metric-hint" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <ItemsControl x:Name="StorageLegendList"
                            Grid.Column="1"
                            ItemsSource="{Binding StorageLegend}"
                            VerticalAlignment="Center"
                            Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4" VerticalAlignment="Center">
                      <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Tooltip}" MaxWidth="320" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource ItemBg}" Padding="10,8">
              <StackPanel Spacing="6">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding BackupDiskUsedPercent}" Height="8" Foreground="{DynamicResource VS.Primary}" Background="{DynamicResource Surface2}"/>
                <TextBlock Text="{Binding BackupDiskFreeText}" Classes="metric-hint"/>
                <TextBlock Text="{Binding BackupDiskThresholdText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="BackupStorageCard"
                Grid.Column="1"
                Classes="card"
                Padding="{DynamicResource CardPaddingSmall}">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.BackupStorage}" Classes="section-title"/>
              <TextBlock Text="{Binding BackupDiskFreeText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding BackupDiskRiskReason}"
                         Classes="metric-hint"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasBackupDiskRiskReason}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,2,0,0" Height="12" ClipToBounds="True" Background="{DynamicResource ItemBg}">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding BackupDiskUsedPercent}" Height="12" Margin="0" Foreground="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource Surface2}" IsVisible="{Binding HasBackupUsageSegments, Converter={StaticResource BoolInvertConverter}}"/>
              <lvc:CartesianChart Series="{Binding BackupUsageSeries}"
                                  XAxes="{Binding BackupUsageXAxes}"
                                  YAxes="{Binding BackupUsageYAxes}"
                                  Background="{DynamicResource ItemBg}"
                                  IsVisible="{Binding HasBackupUsageSegments}"
                                  LegendPosition="Hidden"
                                  Height="12"
                                  Margin="0"
                                  Padding="0"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource ItemBg}"
                    CornerRadius="12"
                    Padding="10"
                    MinHeight="180">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="{infra:LocalizedString Key=Dashboard.Storage.TopConsumers}"
                           Classes="kicker"
                           Margin="0"/>
                <TextBlock Grid.Row="1"
                           Text="{infra:LocalizedString Key=Dashboard.Storage.TopConsumersEmpty}"
                           Classes="metric-hint"
                           IsVisible="{Binding HasBackupTopConsumers, Converter={StaticResource BoolInvertConverter}}"/>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding BackupTopConsumers}"
                              IsVisible="{Binding HasBackupTopConsumers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Surface2}"
                              BorderBrush="{DynamicResource BorderSoft}"
                              BorderThickness="1"
                              CornerRadius="10"
                              Padding="10,8"
                              Margin="0,0,0,8"
                              ToolTip.Tip="{Binding Tooltip}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Width="10"
                                  Height="10"
                                  CornerRadius="5"
                                  Background="{Binding Brush}"
                                  VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Name}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding ValueText}"
                                     Classes="metric-hint"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
