<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.DashboardView"
    x:CompileBindings="False"
    Background="{DynamicResource VS.WindowBackground}">

  <!-- Vertical scroll for short windows. The whole page scales uniformly inside. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">

    <!-- Scale EVERYTHING uniformly from this design width -->
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
      <Grid Width="1220">
        <!-- 6 rows: 0 Header, 1 KPIs, 2 Backup storage, 3 Actions, 4 Charts, 5 Activity -->
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Classes="header" Padding="16" Grid.Row="0" Margin="4">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Dashboard.Title}" Classes="section-title" FontSize="28"/>
            <TextBlock Text="{infra:LocalizedString Key=Dashboard.Description}" Classes="kicker" FontSize="18"/>
          </StackPanel>
        </Border>

        <!-- KPI row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="4,8,4,0">
          <Border Classes="card" Padding="20" Grid.Column="0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Kpi.Projects}" Classes="kicker"/>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding ProjectCount}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProjectsHint}" Classes="metric-hint"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="20" Grid.Column="1">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Kpi.Backups}" Classes="kicker"/>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{Binding SnapshotCount}" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SnapshotsHint}" Classes="metric-hint"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="card" Padding="20" Grid.Column="2">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Kpi.Storage}" Classes="kicker"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding StorageUsed}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           MaxWidth="200"/>
                <TextBlock Text="{Binding StorageHint}"
                           Classes="metric-hint"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Backup storage -->
        <Grid Grid.Row="2" Margin="4,12,4,0">
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.BackupStorage}" Classes="section-title"/>

              <!-- Base blue bar (used vs total) + segmented overlay (Other + per-project VaultSync) -->
              <Grid Margin="0,4,0,0" Height="12" ClipToBounds="True"
                    Background="{DynamicResource ItemBg}">
                <!-- Base blue bar: overall used space on the backup drive -->
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding BackupDiskUsedPercent}"
                               Height="12"
                               Margin="0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Background="{DynamicResource Surface2}"/>
                <!-- Stacked row chart overlay: breakdown of used space (Other + VaultSync projects) -->
                <lvc:CartesianChart
                    Series="{Binding BackupUsageSeries}"
                    XAxes="{Binding BackupUsageXAxes}"
                    YAxes="{Binding BackupUsageYAxes}"
                    Background="Transparent"
                    IsVisible="False"
                    LegendPosition="Hidden"
                    Height="12"
                    Margin="0"
                    Padding="0"/>
              </Grid>

              <!-- Legend: Other + projects -->
              <ItemsControl ItemsSource="{Binding BackupUsageSegments}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,12,2">
                      <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}"/>
                      <TextBlock Text="{Binding Label}" Classes="metric-hint"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Existing textual hints -->
              <TextBlock Text="{Binding BackupDiskFreeText}"
                         Classes="metric-hint"
                         Margin="0,4,0,0"/>
              <TextBlock Text="{Binding BackupDiskThresholdText}"
                         Foreground="{DynamicResource TextSecondary}"
                         FontSize="11"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,12,4,0">
          <!-- TODO: actions toolbar/cards will go here -->
        </Grid>

        <!-- Charts row -->
        <Grid Grid.Row="4" ColumnDefinitions="2*,1*" ColumnSpacing="16" Margin="4,12,4,0">
          <!-- Trend -->
          <Border Classes="card" Padding="14" Grid.Column="0">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0">
                <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.BackupsThisWeek}" Classes="section-title"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Padding="8,4"
                        Background="{DynamicResource ItemBg}">
                  <TextBlock Text="{Binding TotalSnapshotsWeekLabel}" FontWeight="SemiBold"/>
                </Border>
              </Grid>
              <lvc:CartesianChart Grid.Row="1"
                                  Series="{Binding SnapshotSeries}"
                                  XAxes="{Binding SnapshotXAxes}"
                                  YAxes="{Binding SnapshotYAxes}"
                                  Background="{Binding $parent[Border].Background}"
                                  LegendPosition="Hidden"
                                  Height="360"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
            </Grid>
          </Border>

          <!-- Donut -->
          <Border Classes="card" Padding="14" Grid.Column="1">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.StorageUsage}" Classes="section-title" Margin="0,0,0,8"/>

              <Grid Grid.Row="1">
                <lvc:PieChart
                    Series="{Binding StorageSeries}"
                    Background="{Binding $parent[Border].Background}"
                    LegendPosition="Hidden"
                    Height="360"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

                <!-- Center label -->
                <StackPanel IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="2">
                  <TextBlock Text="{Binding StorageUsed}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.StorageUsageLabel}" Classes="metric-hint" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Legend -->
              <ItemsControl Grid.Row="2" ItemsSource="{Binding StorageLegend}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="180" MinWidth="200"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                      <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}"/>
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>

        <!-- Recent activity -->
        <Border Classes="card" Padding="14" Margin="4,12,4,0" Grid.Row="5">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Text="{infra:LocalizedString Key=Dashboard.Section.RecentActivity}" Classes="section-title" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActivityItems}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource ItemBg}" CornerRadius="12" Margin="0,6,0,6" Padding="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Title}" Classes="kicker"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </ScrollViewer>
</UserControl>
