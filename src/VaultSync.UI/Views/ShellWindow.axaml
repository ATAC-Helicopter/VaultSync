<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VaultSync.UI.Views"
        x:Class="VaultSync.UI.Views.ShellWindow"
        Title="VaultSync"
        Width="1000" Height="650">

  <DockPanel>
    <StackPanel DockPanel.Dock="Left" Width="200" Background="#202020" Spacing="8" Margin="0,0,8,0">
      <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
      <Button Content="Projects" Command="{Binding NavigateCommand}" CommandParameter="Projects" />
      <Button Content="History" Command="{Binding NavigateCommand}" CommandParameter="History" />
      <Button Content="Sync" Command="{Binding NavigateCommand}" CommandParameter="Sync" />
      <Button Content="Backups" Command="{Binding NavigateCommand}" CommandParameter="Backups" />
      <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
    </StackPanel>

    <ContentControl Content="{Binding CurrentView}" />
  </DockPanel>
</Window>