<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.RecoveryView"
    x:DataType="vm:RecoveryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="Border.recovery-card">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.recovery-soft">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.recovery-pill">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.recovery-label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ProgressBar.recovery-bar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="16">
      <Grid x:Name="RecoveryHeaderGrid"
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="7">
          <TextBlock Text="{infra:LocalizedString Key=Recovery.Title}"
                     FontSize="26"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Headline}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{CompiledBinding Detail}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="RecoveryHeaderActions"
                    Grid.Column="1"
                    Spacing="8"
                    VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Classes="action-ghost"
                    Content="{infra:LocalizedString Key=Recovery.Export.Action}"
                    Command="{CompiledBinding ExportReportCommand}" />
            <Button Classes="action-ghost"
                    Content="{infra:LocalizedString Key=Common.Refresh}"
                    Command="{CompiledBinding RefreshCommand}" />
          </StackPanel>
          <TextBlock Text="{CompiledBinding ExportStatus}"
                     IsVisible="{CompiledBinding HasExportStatus}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextAlignment="Right"
                     TextWrapping="Wrap"
                     MaxWidth="420" />
        </StackPanel>
      </Grid>

      <Grid x:Name="RecoveryKpiGrid"
            Grid.Row="1"
            ColumnDefinitions="1.3*,*,*,*"
            RowDefinitions="Auto"
            ColumnSpacing="12">
        <Border x:Name="RecoveryScoreCard"
                Classes="recovery-card"
                Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">
            <TextBlock Text="{infra:LocalizedString Key=Recovery.Score.Title}"
                       Classes="recovery-label" />
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">
              <StackPanel Spacing="0">
                <TextBlock Text="{CompiledBinding ReadinessScoreLabel}"
                           FontSize="34"
                           FontWeight="SemiBold" />
                <TextBlock Text="{CompiledBinding ReadinessBand}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{CompiledBinding Insight}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         MaxLines="3"
                         VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Grid.Row="2"
                         Classes="recovery-bar"
                         Value="{CompiledBinding ReadinessPercent}" />
          </Grid>
        </Border>

        <Border x:Name="RecoveryReadyCard"
                Grid.Column="1"
                Classes="recovery-card"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Recovery.Kpi.Ready}"
                       Classes="recovery-label" />
            <TextBlock Text="{CompiledBinding ReadyCount}"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding ProjectSummaryLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
          </StackPanel>
        </Border>

        <Border x:Name="RecoveryAttentionCard"
                Grid.Column="2"
                Classes="recovery-card"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Recovery.Kpi.Attention}"
                       Classes="recovery-label" />
            <TextBlock Text="{CompiledBinding AttentionCount}"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="{infra:LocalizedString Key=Recovery.Kpi.Attention.Detail}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
          </StackPanel>
        </Border>

        <Border x:Name="RecoveryRiskCard"
                Grid.Column="3"
                Classes="recovery-card"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Recovery.Kpi.Risk}"
                       Classes="recovery-label" />
            <TextBlock FontSize="30"
                       FontWeight="SemiBold">
              <Run Text="{CompiledBinding RiskCount}" />
              <Run Text="/" />
              <Run Text="{CompiledBinding UnavailableCount}" />
            </TextBlock>
            <TextBlock Text="{infra:LocalizedString Key=Recovery.RiskPair.Detail}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="RecoveryContentGrid"
            Grid.Row="2"
            ColumnDefinitions="360,*"
            RowDefinitions="Auto"
            ColumnSpacing="16">
        <StackPanel x:Name="RecoveryOverviewPanel"
                    Spacing="12">
          <Border Classes="recovery-card"
                  Padding="18">
            <StackPanel Spacing="14">
              <TextBlock Text="{infra:LocalizedString Key=Recovery.Coverage.Title}"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding CoverageSummary}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />

              <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12">
                <Grid ColumnDefinitions="44,*,Auto"
                      ColumnSpacing="10">
                  <TextBlock Text="24h" Classes="recovery-label" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="recovery-bar" Value="{CompiledBinding Coverage24Percent}" />
                  <TextBlock Grid.Column="2" Text="{CompiledBinding Coverage24Hours}" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="7d" Classes="recovery-label" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="recovery-bar" Value="{CompiledBinding Coverage7Percent}" />
                  <TextBlock Grid.Column="2" Text="{CompiledBinding Coverage7Days}" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="30d" Classes="recovery-label" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="recovery-bar" Value="{CompiledBinding Coverage30Percent}" />
                  <TextBlock Grid.Column="2" Text="{CompiledBinding Coverage30Days}" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                  <TextBlock Text="90d" Classes="recovery-label" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="recovery-bar" Value="{CompiledBinding Coverage90Percent}" />
                  <TextBlock Grid.Column="2" Text="{CompiledBinding Coverage90Days}" FontWeight="SemiBold" />
                </Grid>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="recovery-card"
                  Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="{infra:LocalizedString Key=Recovery.Advisor.Title}"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="{infra:LocalizedString Key=Recovery.Advisor.Detail}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
              <Border Classes="recovery-soft" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{CompiledBinding ThreeTwoOneSummary}" FontWeight="SemiBold" />
                  <TextBlock Text="{CompiledBinding DrillSummary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{CompiledBinding ProtectedSummary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{infra:LocalizedString Key=Recovery.Advisor.OffsiteDisclosure}"
                         FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="recovery-card"
                  Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="{infra:LocalizedString Key=Recovery.Recommendation.Title}"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding TopRecommendation}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Border x:Name="RecoveryProjectsPanel"
                Grid.Column="1"
                Classes="recovery-card"
                Padding="0">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Margin="18,16,18,12">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Recovery.ProjectMatrix.Title}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="{infra:LocalizedString Key=Recovery.ProjectMatrix.FriendlyDetail}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,170"
                      ColumnSpacing="10"
                      Margin="0,8,0,0">
                  <TextBox PlaceholderText="{infra:LocalizedString Key=Recovery.Filter.SearchWatermark}"
                           Text="{CompiledBinding ProjectSearchText, Mode=TwoWay}" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{CompiledBinding ProjectFilters}"
                            SelectedItem="{CompiledBinding SelectedProjectFilter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecoveryFilterOption">
                        <TextBlock Text="{CompiledBinding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              <Border Grid.Column="1"
                      Classes="recovery-pill"
                      VerticalAlignment="Top">
                <TextBlock Text="{CompiledBinding VisibleProjectSummaryLabel}"
                           FontSize="11"
                           FontWeight="SemiBold" />
              </Border>
            </Grid>

            <Border Grid.Row="1"
                    Classes="recovery-soft"
                    Margin="18,0,18,18"
                    Padding="18"
                    IsVisible="{CompiledBinding !HasProjects}">
              <TextBlock Text="{CompiledBinding ProjectEmptyMessage}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <ItemsControl Grid.Row="1"
                          ItemsSource="{CompiledBinding Projects}"
                          IsVisible="{CompiledBinding HasProjects}"
                          Margin="18,0,18,18">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecoveryProjectViewModel">
                  <Border Classes="recovery-soft"
                          Padding="14"
                          Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{CompiledBinding ProjectName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{CompiledBinding ScoreLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Classes="recovery-pill"
                                Background="{CompiledBinding Accent}"
                                BorderBrush="{CompiledBinding Accent}">
                          <TextBlock Text="{CompiledBinding Label}"
                                     FontSize="10"
                                     Foreground="{Binding Accent, Converter={StaticResource ContrastForegroundConverter}}"
                                     FontWeight="SemiBold" />
                        </Border>
                      </Grid>

                      <TextBlock Grid.Row="1"
                                 Text="{CompiledBinding ConfidenceState}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />

                      <TextBlock Grid.Row="2"
                                 Text="{CompiledBinding ConfidenceExplanation}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap"
                                 MaxLines="2" />

                      <Grid Grid.Row="3"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <ProgressBar Classes="recovery-bar"
                                     Value="{CompiledBinding ScoreValue}"
                                     Foreground="{CompiledBinding Accent}" />
                        <TextBlock Grid.Column="1"
                                   Text="{CompiledBinding TrackLabel}"
                                   Classes="recovery-label"
                                   VerticalAlignment="Center" />
                      </Grid>

                      <Grid Grid.Row="4"
                            ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                            ColumnSpacing="8">
                        <Border Classes="recovery-pill"><TextBlock Text="{CompiledBinding CopyLabel}" FontSize="10" /></Border>
                        <Border Grid.Column="1" Classes="recovery-pill"><TextBlock Text="{CompiledBinding MediaLabel}" FontSize="10" /></Border>
                        <Border Grid.Column="2" Classes="recovery-pill"><TextBlock Text="{CompiledBinding OffsiteLabel}" FontSize="10" /></Border>
                        <Button Grid.Column="4"
                                Classes="action-ghost"
                                Content="Read-only proof"
                                Command="{CompiledBinding RunDrillCommand}" />
                        <Button Grid.Column="5"
                                Classes="action-primary"
                                Content="Test restore"
                                ToolTip.Tip="Restore representative files into a new isolated folder, reopen them, and record the evidence."
                                Command="{CompiledBinding RunIsolatedRestoreCommand}" />
                      </Grid>

                      <Grid Grid.Row="5"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            IsVisible="{CompiledBinding HasRecommendation}">
                        <TextBlock Text="{CompiledBinding Recommendation}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="action-ghost"
                                Content="{infra:LocalizedString Key=Recovery.Protected.Protect}"
                                Command="{CompiledBinding ProtectRecommendationCommand}" />
                      </Grid>

                      <Expander Grid.Row="6"
                                Header="Recovery inspector">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                          <Border Classes="recovery-soft" Padding="10">
                            <StackPanel Spacing="3">
                              <TextBlock Text="Next useful action" Classes="recovery-label" />
                              <TextBlock Text="{CompiledBinding RecommendedAction}"
                                         FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                          <ItemsControl ItemsSource="{CompiledBinding Evidence}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:RecoveryEvidenceItemViewModel">
                                <Grid ColumnDefinitions="150,90,90,*" ColumnSpacing="8" Margin="4,3">
                                  <TextBlock Text="{CompiledBinding Label}" FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1" Text="{CompiledBinding Status}" />
                                  <TextBlock Grid.Column="2" Text="{CompiledBinding Basis}"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                  <TextBlock Grid.Column="3" Text="{CompiledBinding Detail}"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Expander Header="{CompiledBinding LastDrillLabel}"
                                IsVisible="{CompiledBinding HasDrillDetail}">
                            <Border Classes="recovery-soft" Padding="10" Margin="0,6,0,0">
                              <SelectableTextBlock Text="{CompiledBinding DrillDetail}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" TextWrapping="Wrap" />
                            </Border>
                          </Expander>
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
