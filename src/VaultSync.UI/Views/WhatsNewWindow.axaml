<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
    x:Class="VaultSync.UI.Views.WhatsNewWindow"
    x:DataType="vm:WhatsNewViewModel"
    Width="640"
    Height="720"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Title="{infra:LocalizedString Key=WhatsNew.Title}">

  <Border Background="{DynamicResource Surface0}">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource BorderSoft}"
              BorderThickness="0,0,0,1"
              Padding="28,24,28,20">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18">
          <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="8">
            <TextBlock Text="{CompiledBinding Title}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="{CompiledBinding Subtitle}"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="420" />
          </StackPanel>

          <Border Grid.Row="0"
                  Grid.Column="1"
                  Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,6"
                  VerticalAlignment="Top">
            <TextBlock Text="{CompiledBinding VersionLabel}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontWeight="SemiBold"
                       FontSize="13" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0">
        <ItemsControl ItemsSource="{CompiledBinding Sections}"
                      Margin="28,22,28,22">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WhatsNewSection">
              <Grid ColumnDefinitions="4,*"
                    ColumnSpacing="16"
                    Margin="0,0,0,24">
                <Border Grid.Column="0"
                        Width="4"
                        CornerRadius="2"
                        Background="{DynamicResource AccentBrush}" />

                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="{CompiledBinding Title}"
                             Foreground="{DynamicResource TextPrimary}"
                             FontWeight="SemiBold"
                             FontSize="16" />
                  <ItemsControl ItemsSource="{CompiledBinding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              Margin="0,0,0,9">
                          <Border Width="6"
                                  Height="6"
                                  CornerRadius="3"
                                  Background="{DynamicResource TextMuted}"
                                  Margin="0,8,0,0" />
                          <controls:RichTextBlock Grid.Column="1"
                                                  RichText="{Binding}"
                                                  TextWrapping="Wrap"
                                                  LineHeight="22"
                                                  Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2"
              Background="{DynamicResource Surface1}"
              BorderBrush="{DynamicResource BorderSoft}"
              BorderThickness="0,1,0,0"
              Padding="20">
        <Button Content="{infra:LocalizedString Key=WhatsNew.Close}"
                Command="{CompiledBinding CloseCommand}"
                Background="{DynamicResource AccentBrush}"
                Foreground="{DynamicResource TextOnPillBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                CornerRadius="8"
                MinWidth="132"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center" />
      </Border>
    </Grid>
  </Border>
</Window>
