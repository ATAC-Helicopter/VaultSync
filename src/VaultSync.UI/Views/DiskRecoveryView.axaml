<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             x:Class="VaultSync.UI.Views.DiskRecoveryView"
             x:DataType="vm:DiskRecoveryViewModel">
  <UserControl.Styles>
    <Style Selector="Border.recovery-step">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.recovery-step">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Title}" FontSize="26" FontWeight="SemiBold" />
    <TextBlock x:Name="DiskRecoveryWorkflow" Classes="recovery-step"
               Text="{infra:LocalizedString Key=DiskRecovery.Overview}" />
    <Border Classes="recovery-step">
      <StackPanel Spacing="8">
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.CaptureStep}" Classes="recovery-step" />
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.BootStep}" Classes="recovery-step" />
      </StackPanel>
    </Border>
    <Border Classes="recovery-step">
      <StackPanel Spacing="10">
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Verify}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Intro}" Classes="recovery-step" />
        <WrapPanel>
          <Button Classes="action-ghost" Content="{infra:LocalizedString Key=DiskRecovery.Choose}"
                  Click="ChooseImage" IsEnabled="{Binding CanChoose}" Margin="0,0,8,8" />
          <Button Classes="action-primary" Content="{infra:LocalizedString Key=DiskRecovery.Verify}"
                  Command="{Binding VerifyCommand}" Margin="0,0,8,8" />
          <Button Classes="action-ghost" Content="{infra:LocalizedString Key=DiskRecovery.Cancel}"
                  Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
        </WrapPanel>
        <SelectableTextBlock Text="{Binding Folder}" TextWrapping="Wrap" />
        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="6" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Boundary}" Classes="recovery-step" FontSize="12" />
      </StackPanel>
    </Border>
    <Border Classes="recovery-step">
      <StackPanel Spacing="8">
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.RestoreStep}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.AfterStep}" Classes="recovery-step" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
