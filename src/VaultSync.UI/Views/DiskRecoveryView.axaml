<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             x:Class="VaultSync.UI.Views.DiskRecoveryView"
             x:DataType="vm:DiskRecoveryViewModel">
  <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource BorderSoft}"
          BorderThickness="1" CornerRadius="8" Padding="18">
    <StackPanel Spacing="12">
      <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Title}" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Intro}" TextWrapping="Wrap"/>
      <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Steps}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMuted}"/>
      <WrapPanel>
        <Button Content="{infra:LocalizedString Key=DiskRecovery.Choose}" Click="ChooseImage"
                IsEnabled="{Binding CanChoose}" Margin="0,0,8,8"/>
        <Button Content="{infra:LocalizedString Key=DiskRecovery.Verify}" Command="{Binding VerifyCommand}" Margin="0,0,8,8"/>
        <Button Content="{infra:LocalizedString Key=DiskRecovery.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock Text="{Binding Folder}" TextWrapping="Wrap"/>
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="6"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{infra:LocalizedString Key=DiskRecovery.Boundary}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextMuted}" FontSize="12"/>
    </StackPanel>
  </Border>
</UserControl>
