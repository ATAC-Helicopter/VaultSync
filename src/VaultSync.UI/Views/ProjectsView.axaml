<UserControl
    x:Class="VaultSync.UI.Views.ProjectsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Hover effect for snapshot bars -->
    <Style Selector="Border.snapshot-bar:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Search box: keep focus visuals clean -->
    <Style Selector="TextBox#ProjectSearch">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Focusable" Value="True" />
    </Style>

    <!-- Preset dropdown: pill style -->
    <Style Selector="ComboBox.preset-combo">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Custom container template for project list items -->
    <Style Selector="#ProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="{DynamicResource ListItemMargin}"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource ListItemPadding}">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Soft tint for selected project -->
    <Style Selector="#ProjectList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <Style Selector="Border.preset-editor-shell">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="#141D31" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.preset-editor-section">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="#19243A" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.preset-editor-badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#1C2942" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Border.preset-editor-status.ok">
      <Setter Property="Background" Value="#153626" />
      <Setter Property="BorderBrush" Value="#28734A" />
    </Style>

    <Style Selector="Border.preset-editor-status.warn">
      <Setter Property="Background" Value="#4C3A18" />
      <Setter Property="BorderBrush" Value="#9A7530" />
    </Style>

    <Style Selector="Border.preset-editor-status.error">
      <Setter Property="Background" Value="#4B2428" />
      <Setter Property="BorderBrush" Value="#9E4A55" />
    </Style>

    <Style Selector="Button.preset-editor-action">
      <Setter Property="Background" Value="#1C2942" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preset-editor-action:pointerover">
      <Setter Property="Background" Value="#21304D" />
    </Style>

    <Style Selector="Button.preset-editor-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
  </UserControl.Resources>

  <Border Padding="{DynamicResource PagePadding}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{DynamicResource PageRowSpacing}"
          MaxWidth="2200"
          HorizontalAlignment="Stretch">

    <controls:NotificationCard
        Grid.Row="0"
        Margin="{DynamicResource SectionMarginBottom}"
        DataContext="{Binding Notification}" />

    <!-- Inner content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.6*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="3.4*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: All projects card -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="{DynamicResource CardPaddingLarge}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource PageRowSpacing}">

          <!-- Title + sort -->
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{infra:LocalizedString Key=Projects.Page.Title}"
                       FontSize="{DynamicResource PageTitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource Surface2}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding ToggleSortCommand}">
              <TextBlock Text="{Binding SortModeLabel}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Row="1" ColumnSpacing="8">
            <Border CornerRadius="12"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Padding="0,0,6,0">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="12" />
                <TextBox
                  x:Name="ProjectSearch"
                  Margin="0"
                  Padding="{DynamicResource InputPadding}"
                  Watermark="{infra:LocalizedString Key=Projects.Page.SearchWatermark}"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding SearchText, Mode=TwoWay}"
                  CaretBrush="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </Border>

            <Button Grid.Column="1"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Action.Refresh}" />
            </Button>
          </Grid>

          <Border Grid.Row="2"
                  CornerRadius="12"
                  Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="1"
                  Padding="12,10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="8"
                  RowSpacing="8">
              <TextBlock VerticalAlignment="Center"
                         Text="{infra:LocalizedString Key=Projects.Group.Label}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <ComboBox Grid.Column="1"
                        Classes="preset-combo"
                        ItemsSource="{Binding GroupOptions}"
                        SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <WrapPanel Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Orientation="Horizontal"
                         ItemSpacing="8"
                         LineSpacing="8">
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding SnapshotGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.SnapshotAction}" />
                </Button>
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding BackupGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.BackupAction}" />
                </Button>
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding DisableAutoBackupGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.DisableAuto}" />
                </Button>
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding EnableAutoBackupGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.EnableAuto}" />
                </Button>
              </WrapPanel>
              <TextBlock Grid.Row="2"
                         VerticalAlignment="Center"
                         Text="{infra:LocalizedString Key=Projects.Group.TagLabel}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBox Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding GroupTagInput, Mode=TwoWay}"
                       Watermark="{infra:LocalizedString Key=Projects.Group.TagWatermark}"
                       Background="{DynamicResource InputBackgroundBrush}"
                       BorderBrush="{DynamicResource DividerBrush}"
                       BorderThickness="1"
                       Padding="{DynamicResource InputPadding}" />
              <WrapPanel Grid.Row="3"
                         Grid.ColumnSpan="2"
                         Orientation="Horizontal"
                         ItemSpacing="8"
                         LineSpacing="8">
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding ApplyTagToGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.TagApply}" />
                </Button>
                <Button Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding RemoveTagFromGroupCommand}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Group.TagRemove}" />
                </Button>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           Text="{infra:LocalizedString Key=Projects.Group.TagHelp}" />
              </WrapPanel>
              <ItemsControl Grid.Row="4"
                            Grid.ColumnSpan="2"
                            ItemsSource="{Binding ReusableProjectTags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Padding="8,2"
                            CornerRadius="999"
                            Background="{Binding Background}"
                            BorderBrush="{Binding Border}"
                            BorderThickness="1"
                            Foreground="{Binding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding DataContext.SelectGroupTagCommand, ElementName=Root}"
                            CommandParameter="{Binding Value}">
                      <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" TextAlignment="Center" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Grid.Row="5"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Text="{infra:LocalizedString Key=Projects.Group.Help}"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- Projects list -->
          <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,8"
                          IsVisible="{Binding HasProjects}">
              <ListBox
                x:Name="ProjectList"
                ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch">

                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{DynamicResource ListRowSpacing}">
                    <!-- Name + last snapshot short + size + avatar -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="8"
                          MinHeight="40"
                          VerticalAlignment="Center">
                      <Grid Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border CornerRadius="18" Background="{Binding AvatarColor}"/>
                        <Image Source="{Binding AvatarImagePath}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasCustomAvatar}">
                          <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                          </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding AvatarInitials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                      </Grid>
                <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        FontSize="{DynamicResource SectionHeaderFontSize}"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding LastSnapshotShort}"
                        FontSize="{DynamicResource PageSubtitleFontSize}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock
                        Grid.Column="3"
                        Text="{Binding SizeDisplay}"
                        FontSize="{DynamicResource PageSubtitleFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <!-- Path -->
                    <TextBlock
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,6,0,0"
                      Text="{Binding Path}"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="{DynamicResource PageSubtitleFontSize}"
                      TextWrapping="NoWrap"
                      TextTrimming="CharacterEllipsis" />

                    <!-- Destination -->
                    <TextBlock
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="0,2,0,0"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="{DynamicResource PageSubtitleFontSize}"
                      TextWrapping="NoWrap"
                      TextTrimming="CharacterEllipsis">
                      <Run Text="{infra:LocalizedString Key=Projects.List.DestinationPrefix}" />
                      <Run Text="{Binding PreferredDestinationDisplay}" />
                    </TextBlock>

                    <ItemsControl Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  IsVisible="{Binding HasTags}"
                                  ItemsSource="{Binding TagChips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="999"
                                  Padding="8,2"
                                  HorizontalAlignment="Left"
                                  Background="{Binding Background}"
                                  BorderBrush="{Binding Border}"
                                  BorderThickness="1">
                            <TextBlock Text="{Binding Value}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{Binding Foreground}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="160" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{infra:LocalizedString Key=Projects.List.EncryptionPrefix}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontSize="{DynamicResource PageSubtitleFontSize}" />
                      <Border CornerRadius="999"
                              Padding="8,2"
                              Background="{Binding EncryptionBadgeBackground}">
                        <TextBlock Text="{Binding EncryptionBadgeText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding EncryptionBadgeForeground}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>

                    <!-- Health pill bar -->
                    <Border
                      Grid.Row="5"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      CornerRadius="999"
                      Height="20"
                      Background="{Binding HealthBackground}">
                      <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="{Binding HealthTag}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{Binding HealthForeground}" />
                    </Border>
                  </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>

            <Border IsVisible="{Binding ShowProjectsEmptyState}"
                    CornerRadius="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Padding="20"
                    VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="No projects are available yet."
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Set a projects root in Settings or re-add a tracked project so the Projects page can rebuild its list."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- RIGHT: details + stats -->
      <Border x:Name="ProjectDetailsCard"
              Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              DataContext="{Binding SelectedProject}"
              IsVisible="{Binding HasSelectedProject}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <!-- Header: avatar + name + path -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="48"
                  Height="48"
                  IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Border CornerRadius="24"
                      Background="{Binding AvatarColor}" />
              <Image Source="{Binding AvatarImagePath}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding HasCustomAvatar}">
                <Image.Clip>
                  <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                </Image.Clip>
              </Image>
              <TextBlock Text="{Binding AvatarInitials}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="Normal"
                         FontSize="12"
                         Foreground="White"/>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock
                Text="{Binding Name}"
                FontSize="{DynamicResource PageTitleFontSize}"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{infra:LocalizedString Key=Projects.Label.Location}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{Binding Path}" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="stat-pill sm info"
                            ToolTip.Tip="{infra:LocalizedString Key=Projects.Stat.LastSnapshotLabel}">
                      <TextBlock Text="{Binding LastSnapshotSummary}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="220" />
                    </Border>
                    <Border Classes="stat-pill sm info"
                            ToolTip.Tip="{infra:LocalizedString Key=Projects.Stat.ProjectSize}">
                      <TextBlock Text="{Binding SizeDisplay}"
                                 FontSize="11" />
                    </Border>
                  </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Actions: open folder + snapshot -->

          <WrapPanel Grid.Row="1"
                     ItemSpacing="8"
                     LineSpacing="8"
                     HorizontalAlignment="Left">
            <Button Classes="action-ghost"
                    Padding="14,8"
                    CornerRadius="10"
                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.OpenFolder}" />
            </Button>
            <Button x:Name="ProjectSnapshotButton"
                    Classes="action-primary"
                    Padding="14,8"
                    CornerRadius="10"
                    Command="{Binding DataContext.TakeSnapshotCommand, ElementName=Root}"
                    Content="{Binding DataContext.SnapshotActionLabel, ElementName=Root}" />
            <Button
                    Classes="action-ghost action-danger"
                    Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Command="{Binding DataContext.RemoveProjectCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.RemoveProject}" />
            </Button>
          </WrapPanel>

          <!-- Project controls + key stats -->
          <Grid Grid.Row="2"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">
            <!-- Preset -->
            <Border x:Name="ProjectEncryptionCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotPreset}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectPresetCombo"
                          Grid.Row="1"
                          Classes="preset-combo"
                          ItemsSource="{Binding DataContext.AvailablePresets, ElementName=Root}"
                          SelectedItem="{Binding Preset, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2"
                           Margin="0,2,0,0"
                           Text="{Binding PresetDescription}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="3"
                           IsVisible="{Binding PresetExample, Converter={StaticResource StringNotEmptyConverter}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{infra:LocalizedString Key=Projects.Preset.ExampleLabel}" />
                  <Run Text=" " />
                  <Run Text="{Binding PresetExample}" />
                </TextBlock>
                <TextBlock Grid.Row="4"
                           IsVisible="{Binding RecommendedPreset, Converter={StaticResource StringNotEmptyConverter}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{infra:LocalizedString Key=Projects.Preset.Recommendation.Label}" />
                  <Run Text=" " />
                  <Run Text="{Binding RecommendedPreset}" />
                  <Run Text=" - " />
                  <Run Text="{Binding RecommendedPresetReason}" />
                </TextBlock>
                <Button Grid.Row="5"
                        IsVisible="{Binding RecommendedPreset, Converter={StaticResource StringNotEmptyConverter}}"
                        HorizontalAlignment="Left"
                        Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding DataContext.ApplyPresetRecommendationCommand, ElementName=Root}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Recommendation.Apply}" />
                </Button>
                <TextBlock Grid.Row="6"
                           Text="{infra:LocalizedString Key=Projects.Tags.Label}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Row="7" Spacing="6">
                  <ItemsControl ItemsSource="{Binding DataContext.SelectedProjectTags, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="999"
                                Background="{Binding Background}"
                                BorderBrush="{Binding Border}"
                                BorderThickness="1"
                                Padding="10,4"
                                DoubleTapped="OnProjectTagPillDoubleTapped">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{Binding Foreground}" />
                            <Button Content="x"
                                    Classes="small-button"
                                    Padding="4,0"
                                    MinWidth="18"
                                    MinHeight="18"
                                    VerticalAlignment="Center"
                                    Background="#00000000"
                                    Foreground="{Binding Foreground}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.RemoveProjectTagCommand, ElementName=Root}"
                                    CommandParameter="{Binding Value}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBox Text="{Binding DataContext.ProjectTagInput, ElementName=Root, Mode=TwoWay}"
                           Watermark="{infra:LocalizedString Key=Projects.Tags.Watermark}"
                           Background="{DynamicResource InputBackgroundBrush}"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1"
                           Padding="{DynamicResource InputPadding}"
                           KeyDown="OnProjectTagInputKeyDown" />

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding DataContext.ToggleProjectTagColorEditorCommand, ElementName=Root}"
                            IsEnabled="{Binding DataContext.CanEditProjectTagColor, ElementName=Root}"
                            Padding="{DynamicResource ButtonPadding}"
                            CornerRadius="12"
                            Background="{DynamicResource Surface2}"
                            Foreground="{DynamicResource TextPrimaryBrush}">
                      <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Open}" />
                    </Button>
                    <Border CornerRadius="999"
                            Padding="12,4"
                            Background="{Binding DataContext.ProjectTagColorPreviewBackground, ElementName=Root}"
                            BorderBrush="{Binding DataContext.ProjectTagColorPreviewBorder, ElementName=Root}"
                            BorderThickness="1"
                            IsVisible="{Binding DataContext.CanEditProjectTagColor, ElementName=Root}">
                      <TextBlock Text="{Binding DataContext.ProjectTagColorTarget, ElementName=Root}"
                                 Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                 FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="160" />
                    </Border>
                  </StackPanel>

                  <Border IsVisible="{Binding DataContext.IsProjectTagColorEditorOpen, ElementName=Root}"
                          CornerRadius="18"
                          Background="{DynamicResource Surface2}"
                          BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="1"
                          Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="1.2*,0.8*"
                          RowSpacing="10"
                          ColumnSpacing="16">
                      <StackPanel Grid.Row="0"
                                  Grid.Column="0"
                                  Spacing="4">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Label}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Description}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Row="0"
                              Grid.Column="1"
                              CornerRadius="16"
                              Padding="16,14"
                              Background="{Binding DataContext.ProjectTagColorPreviewBackground, ElementName=Root}"
                              BorderBrush="{Binding DataContext.ProjectTagColorPreviewBorder, ElementName=Root}"
                              BorderThickness="1">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding DataContext.ProjectTagColorTarget, ElementName=Root}"
                                     Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding DataContext.ProjectTagColorHex, ElementName=Root}"
                                     Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                     FontSize="11"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <Grid Grid.Row="1"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Hex}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding DataContext.ProjectTagColorHex, ElementName=Root, Mode=TwoWay}"
                                 Watermark="#RRGGBB"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource DividerBrush}"
                                 BorderThickness="1"
                                 Padding="{DynamicResource InputPadding}" />
                      </Grid>

                      <Grid Grid.Row="2"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Hue}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="360"
                                Value="{Binding DataContext.ProjectTagColorHue, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorHue, ElementName=Root, StringFormat={}{0:0}°}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <Grid Grid.Row="3"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Saturation}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding DataContext.ProjectTagColorSaturation, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorSaturation, ElementName=Root, StringFormat={}{0:0}%}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <Grid Grid.Row="4"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Brightness}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding DataContext.ProjectTagColorValue, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorValue, ElementName=Root, StringFormat={}{0:0}%}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <Grid Grid.Row="5"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Red}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="255"
                                Value="{Binding DataContext.ProjectTagColorRed, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorRed, ElementName=Root, StringFormat={}{0:0}}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <Grid Grid.Row="6"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Green}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="255"
                                Value="{Binding DataContext.ProjectTagColorGreen, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorGreen, ElementName=Root, StringFormat={}{0:0}}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <Grid Grid.Row="7"
                            Grid.ColumnSpan="2"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Blue}"
                                   Width="88"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="255"
                                Value="{Binding DataContext.ProjectTagColorBlue, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DataContext.ProjectTagColorBlue, ElementName=Root, StringFormat={}{0:0}}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </Grid>

                      <StackPanel Grid.Row="8"
                                  Grid.ColumnSpan="2"
                                  Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="10">
                        <Button Command="{Binding DataContext.ResetProjectTagColorCommand, ElementName=Root}"
                                Padding="{DynamicResource ButtonPadding}"
                                CornerRadius="12"
                                Background="{DynamicResource Surface1}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Reset}" />
                        </Button>
                        <Button Command="{Binding DataContext.ApplyProjectTagColorCommand, ElementName=Root}"
                                Padding="{DynamicResource ButtonPadding}"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Apply}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Help}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.ReusableLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding DataContext.ReusableProjectTags, ElementName=Root}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Padding="8,3"
                                  CornerRadius="999"
                                  Background="{Binding Background}"
                                  BorderBrush="{Binding Border}"
                                  BorderThickness="1"
                                  Foreground="{Binding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Command="{Binding DataContext.AddExistingTagToSelectedProjectCommand, ElementName=Root}"
                                  CommandParameter="{Binding Value}">
                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" TextAlignment="Center" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Row="8"
                        HorizontalAlignment="Left"
                        Classes="preset-editor-action"
                        Command="{Binding DataContext.TogglePresetEditorCommand, ElementName=Root}"
                        IsVisible="{Binding DataContext.HasPresetEditorTarget, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DataContext.PresetEditorToggleLabel, ElementName=Root}"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Border Grid.Row="9"
                        IsVisible="{Binding DataContext.IsPresetEditorVisible, ElementName=Root}"
                        Classes="preset-editor-shell">
                  <Grid RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{infra:LocalizedString Key=Projects.Preset.Editor.Help}"
                                   TextWrapping="Wrap"
                                   MaxWidth="520" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Classes="preset-editor-badge"
                              VerticalAlignment="Top">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   ToolTip.Tip="{Binding DataContext.PresetEditorPath, ElementName=Root}"
                                   Text="{Binding DataContext.PresetEditorPathDisplay, ElementName=Root}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.9*,1.1*"
                          ColumnSpacing="14">
                      <Border Grid.Column="0"
                              Classes="preset-editor-section"
                              Padding="0">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="0">
                          <Border Background="#1B2640"
                                  CornerRadius="16,16,0,0"
                                  Padding="12,10"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBlock Text="Rule editor"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Grid.Column="1"
                                         Text="One pattern per line"
                                         FontSize="10"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                          </Border>
                          <TextBox Grid.Row="1"
                                   AcceptsReturn="True"
                                   TextWrapping="NoWrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   MinHeight="320"
                                   VerticalContentAlignment="Top"
                                   Text="{Binding DataContext.PresetEditorContent, ElementName=Root, Mode=TwoWay}"
                                   Background="{DynamicResource InputBackgroundBrush}"
                                   BorderThickness="0"
                                   Padding="14,12" />
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1"
                                  Spacing="12">
                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="10">
                            <TextBlock Text="Quick actions"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Classes="preset-editor-primary"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.SavePresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Save}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.PreviewPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Preview}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ReloadPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Reload}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ExportPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Export}" />
                            </Button>
                          </StackPanel>
                        </Border>

                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Import from file"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Load rules from another preset file into the editor."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding DataContext.PresetEditorImportPath, ElementName=Root, Mode=TwoWay}"
                                     Watermark="{infra:LocalizedString Key=Projects.Preset.Editor.ImportPathWatermark}"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="1"
                                     Padding="{DynamicResource InputPadding}" />
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ImportPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Import}" />
                            </Button>
                          </StackPanel>
                        </Border>

                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Clone as a new preset"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Create a reusable copy with a new preset id."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding DataContext.PresetEditorCloneId, ElementName=Root, Mode=TwoWay}"
                                     Watermark="{infra:LocalizedString Key=Projects.Preset.Editor.CloneIdWatermark}"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="1"
                                     Padding="{DynamicResource InputPadding}" />
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ClonePresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Clone}" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Classes="preset-editor-section"
                            Padding="12,10">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0" />
                        <StackPanel Grid.Column="1"
                                    Spacing="2">
                          <TextBlock Text="Editor status"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="{Binding DataContext.PresetEditorStatus, ElementName=Root}"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- Destination -->
            <Border CornerRadius="14"
                    Grid.Column="1"
                    Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.DestinationLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.DestinationOptions, ElementName=Root}"
                    SelectedItem="{Binding PreferredDestinationOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Border>

            <!-- Encryption policy -->
            <Border CornerRadius="14"
                    Grid.Column="0"
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.EncryptionPolicy}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectEncryptionPolicyCombo"
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.EncryptionPolicyOptions, ElementName=Root}"
                    SelectedItem="{Binding EncryptionPolicyOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Row="2"
                           Orientation="Horizontal"
                           ItemSpacing="8"
                           VerticalAlignment="Center">
                  <TextBlock Text="{Binding EffectiveEncryptionDisplay}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <Border CornerRadius="999"
                          Padding="8,2"
                          Background="{Binding EncryptionBadgeBackground}">
                    <TextBlock Text="{Binding EncryptionBadgeText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding EncryptionBadgeForeground}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                </WrapPanel>
                <Button x:Name="ProjectEncryptionPasswordButton"
                        Grid.Row="3"
                        Content="{infra:LocalizedString Key=Settings.Encryption.SetPassword}"
                        Classes="action-ghost"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.ManageProjectEncryptionCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Row="4"
                           Text="{Binding EncryptionSecretStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <!-- Health -->
            <Border CornerRadius="14"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectHealth}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <Border CornerRadius="999"
                        Background="{Binding HealthBackground}"
                        Padding="{DynamicResource StatPillPadding}">
                  <TextBlock Text="{Binding HealthTag}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{Binding HealthForeground}"
                             HorizontalAlignment="Center"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>
            </Border>

          </Grid>

          <!-- Stats card -->
          <Border Grid.Row="3"
                  Margin="0,2,0,0"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource CardPaddingMedium}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  RowSpacing="12">

              <!-- Top metrics -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="12">
                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TotalSnapshots}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding SnapshotCount}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotStorage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding TotalSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="2">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.AverageSnapshot}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding AverageSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="3">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TimeSinceLast}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding DaysSinceLastSnapshotDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="1"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Snapshot size trend -->
              <StackPanel Grid.Row="2"
                          Spacing="10">

                <TextBlock
                  Text="{infra:LocalizedString Key=Projects.Stat.SnapshotTrend}"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- subtle y-axis baseline -->
                <Border Height="1"
                        Background="{DynamicResource SubtleAxisBrush}"
                        Margin="0,0,0,4"/>

                <!-- Chart area -->
                <Grid RowDefinitions="Auto,Auto">

                  <!-- Bars row -->
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="{DynamicResource ChartItemMargin}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center">
                          <Border
                            Classes="snapshot-bar"
                            Width="22"
                            CornerRadius="6"
                            Background="{Binding TrendColor}"
                            Height="{Binding RelativeBarHeightCapped}"
                            VerticalAlignment="Bottom"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding TooltipText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- X-axis labels (dates) -->
                  <ItemsControl Grid.Row="1"
                                ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{Binding DayLabel}"
                          IsVisible="{Binding ShowDayLabel}"
                          FontSize="10"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center"
                          Margin="{DynamicResource ChartLabelMargin}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendDecreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Decreasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendIncreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Increasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendUnchangedBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Unchanged}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>

              </StackPanel>

              <Border Grid.Row="3"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Recent snapshots list -->
              <Border Grid.Row="4"
                      CornerRadius="18"
                      Background="{DynamicResource CardRaisedBackgroundBrush}"
                      Padding="{DynamicResource CardPaddingSmall}">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">
                  <TextBlock
                    Grid.Row="0"
                    Text="{infra:LocalizedString Key=Projects.Stat.RecentSnapshots}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

                  <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SnapshotHistory}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="12"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Margin="0,4,0,0"
                                  Padding="{DynamicResource CardPaddingSmall}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="4">
                              <Border Grid.RowSpan="3"
                                      Width="6"
                                      CornerRadius="3"
                                      Background="{DynamicResource AccentBrush}"
                                      Opacity="0.6" />
                              <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding DateDisplay}"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                              <Border Grid.Row="0"
                                      Grid.Column="2"
                                      CornerRadius="999"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Padding="{DynamicResource StatPillPadding}">
                                <TextBlock
                                  Text="{Binding SizeDisplay}"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap" />
                              </Border>
                              <TextBlock Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding DiffSummaryDisplay}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="2" />
                              <TextBlock Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding DiffTopPathsDisplay}"
                                         FontSize="10"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="2"
                                         IsVisible="{Binding HasDiffTopPaths}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

            </Grid>
          </Border>

          </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              IsVisible="{Binding ShowSelectedProjectEmptyState}">
        <StackPanel Spacing="10"
                    VerticalAlignment="Top">
          <TextBlock Text="Select a project to inspect details."
                     FontSize="{DynamicResource PageTitleFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="The detail pane will show presets, destinations, encryption, tags, and snapshot history after a project is available."
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    </Grid>
  </Border>
</UserControl>
