<UserControl
    x:Class="VaultSync.UI.Views.ProjectsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:colorpicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
    xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
    xmlns:vm="using:VaultSync.UI.ViewModels"
    x:DataType="vm:ProjectsViewModel">

  <UserControl.Styles>
    <!-- Hover effect for snapshot bars -->
    <Style Selector="Border.snapshot-bar:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Search box: keep focus visuals clean -->
    <Style Selector="TextBox#ProjectSearch">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
    </Style>

    <!-- Preset dropdown: pill style -->
    <Style Selector="ComboBox.preset-combo">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Custom container template for project list items -->
    <Style Selector="ListBox.project-list ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="{DynamicResource ListItemMargin}"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource ListItemPadding}">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Soft tint for selected project -->
    <Style Selector="ListBox.project-list ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <Style Selector="Border.preset-editor-shell">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.preset-editor-section">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.preset-editor-badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource ItemBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Border.preset-editor-status.ok">
      <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="Border.preset-editor-status.warn">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style Selector="Border.preset-editor-status.error">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.preset-editor-action">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.preset-editor-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <Style Selector="Button.preset-editor-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    <DataTemplate x:Key="ProjectCardTemplate" x:DataType="vm:ProjectItemViewModel">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="*,Auto"
            RowSpacing="{DynamicResource ListRowSpacing}">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="8"
              MinHeight="40"
              VerticalAlignment="Center">
          <Grid Grid.Column="0"
                Width="36"
                Height="36"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                IsVisible="{Binding DataContext.ShowProjectAvatars, ElementName=Root}">
            <Border CornerRadius="18" Background="{Binding AvatarColor}" />
            <Image Source="{Binding AvatarImagePath}"
                   Stretch="UniformToFill"
                   IsVisible="{Binding HasCustomAvatar}">
              <Image.Clip>
                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
              </Image.Clip>
            </Image>
            <TextBlock Text="{Binding AvatarInitials}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{Binding AvatarColor, Converter={StaticResource ContrastForegroundConverter}}" />
          </Grid>
          <TextBlock Grid.Column="1"
                     Text="{Binding Name}"
                     FontSize="{DynamicResource SectionHeaderFontSize}"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2"
                     Text="{Binding LastSnapshotShort}"
                     FontSize="{DynamicResource PageSubtitleFontSize}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Grid.Column="3"
                     Text="{Binding LatestSnapshotSizeDisplay}"
                     FontSize="{DynamicResource PageSubtitleFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Margin="0,6,0,0"
                   Text="{Binding Path}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource PageSubtitleFontSize}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Margin="0,2,0,0"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="{DynamicResource PageSubtitleFontSize}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis">
          <Run Text="{infra:LocalizedString Key=Projects.List.DestinationPrefix}" />
          <Run Text="{Binding PreferredDestinationDisplay}" />
        </TextBlock>

        <ItemsControl Grid.Row="3"
                      Grid.ColumnSpan="2"
                      IsVisible="{Binding HasTags}"
                      ItemsSource="{Binding TagChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="999"
                      Padding="8,2"
                      HorizontalAlignment="Left"
                      Background="{Binding Background}"
                      BorderBrush="{Binding Border}"
                      BorderThickness="1">
                <TextBlock Text="{Binding Value}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{Binding Foreground}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{infra:LocalizedString Key=Projects.List.EncryptionPrefix}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="{DynamicResource PageSubtitleFontSize}" />
          <Border CornerRadius="999"
                  Padding="8,2"
                  Background="{Binding EncryptionBadgeBackground}">
            <TextBlock Text="{Binding EncryptionBadgeText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding EncryptionBadgeForeground}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
          </Border>
        </StackPanel>

        <Border Grid.Row="5"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                CornerRadius="999"
                Height="20"
                Background="{Binding HealthBackground}">
          <TextBlock VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Text="{Binding HealthTag}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{Binding HealthForeground}" />
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Padding="{DynamicResource PagePadding}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{DynamicResource PageRowSpacing}"
          MaxWidth="2200"
          HorizontalAlignment="Stretch">

    <controls:NotificationCard
        Grid.Row="0"
        Margin="{DynamicResource SectionMarginBottom}"
        DataContext="{Binding Notification}" />

    <!-- Inner content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.6*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="3.4*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: All projects card -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="{DynamicResource CardPaddingLarge}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource PageRowSpacing}">

          <!-- Title + sort -->
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            <TextBlock Text="{infra:LocalizedString Key=Projects.Page.Title}"
                       FontSize="{DynamicResource PageTitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1"
                    Padding="11,7"
                    CornerRadius="10"
                    Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource TextPrimaryBrush}">
              <Button.Flyout>
                <Flyout>
                  <Border Width="340"
                          CornerRadius="14"
                          Background="{DynamicResource CardBackgroundBrush}"
                          BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="1"
                          Padding="16">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Create}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Help}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding DataContext.NewProjectGroupName, ElementName=Root, Mode=TwoWay}"
                                 PlaceholderText="{infra:LocalizedString Key=Projects.Folder.NewName}"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource DividerBrush}"
                                 BorderThickness="1"
                                 Padding="{DynamicResource InputPadding}" />
                        <Button Grid.Column="1"
                                Padding="12,7"
                                CornerRadius="10"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource ButtonForegroundBrush}"
                                Command="{Binding DataContext.CreateProjectGroupCommand, ElementName=Root}">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Create}" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <shapes:Path Width="14"
                             Height="14"
                             Stretch="Uniform"
                             Stroke="{DynamicResource TextPrimaryBrush}"
                             StrokeThickness="1.5"
                             Data="M2,4.5 H6 L7.5,6 H14 V13 H2 Z M8,8 V12 M6,10 H10" />
                <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Create}"
                           FontSize="12"
                           FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource Surface2}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding ToggleSortCommand}">
              <TextBlock Text="{Binding SortModeLabel}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Row="1" ColumnSpacing="8">
            <TextBox
              x:Name="ProjectSearch"
              PlaceholderText="{infra:LocalizedString Key=Projects.Page.SearchWatermark}"
              Text="{Binding SearchText, Mode=TwoWay}" />

            <Button Grid.Column="1"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Action.Refresh}" />
            </Button>
          </Grid>

          <!-- Projects list -->
          <Grid Grid.Row="2">
            <ScrollViewer IsVisible="{Binding HasProjects}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
              <ItemsControl ItemsSource="{Binding ProjectFolders}"
                            IsVisible="{Binding HasProjectFolders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectFolderViewModel">
                    <StackPanel Margin="0,0,0,12" Spacing="6">
                      <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                          <Border Width="30"
                                  Height="30"
                                  CornerRadius="9"
                                  Background="{DynamicResource AccentSoftBrush}">
                            <shapes:Path Width="16"
                                         Height="16"
                                         Stretch="Uniform"
                                         Fill="{DynamicResource AccentBrush}"
                                         Data="M2,4.5 H6 L7.5,6 H14 V13 H2 Z" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Summary}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Grid Grid.Column="2" Width="16" Height="16">
                            <shapes:Path IsVisible="{Binding !IsExpanded}"
                                         Stroke="{DynamicResource TextSecondaryBrush}"
                                         StrokeThickness="1.5"
                                         Data="M3,5 L8,10 L13,5" />
                            <shapes:Path IsVisible="{Binding IsExpanded}"
                                         Stroke="{DynamicResource TextSecondaryBrush}"
                                         StrokeThickness="1.5"
                                         Data="M3,10 L8,5 L13,10" />
                          </Grid>
                        </Grid>
                      </ToggleButton>

                      <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6">
                        <Border Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <WrapPanel ItemSpacing="6" IsVisible="{Binding ShowBatchActions}">
                              <Button Padding="8,5"
                                      CornerRadius="8"
                                      Command="{Binding DataContext.SnapshotGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="{infra:LocalizedString Key=Projects.Group.SnapshotAction}">
                                <TextBlock Text="Snapshot" FontSize="10" />
                              </Button>
                              <Button Padding="8,5"
                                      CornerRadius="8"
                                      Command="{Binding DataContext.BackupGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="{infra:LocalizedString Key=Projects.Group.BackupAction}">
                                <TextBlock Text="Backup" FontSize="10" />
                              </Button>
                              <Button Padding="8,5"
                                      Command="{Binding DataContext.DisableAutoBackupGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Projects.Group.DisableAuto}" FontSize="10" />
                              </Button>
                              <Button Padding="8,5"
                                      Command="{Binding DataContext.EnableAutoBackupGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Projects.Group.EnableAuto}" FontSize="10" />
                              </Button>
                            </WrapPanel>

                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="6"
                                  IsVisible="{Binding IsRenaming}">
                              <TextBox Text="{Binding EditName, Mode=TwoWay}"
                                       Padding="{DynamicResource InputPadding}" />
                              <Button Grid.Column="1"
                                      Padding="8,5"
                                      Command="{Binding DataContext.SaveRenameProjectGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Common.Save}" FontSize="10" />
                              </Button>
                              <Button Grid.Column="2"
                                      Padding="8,5"
                                      Command="{Binding DataContext.CancelRenameProjectGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Common.Cancel}" FontSize="10" />
                              </Button>
                            </Grid>

                            <WrapPanel Grid.Column="1" ItemSpacing="6" IsVisible="{Binding !IsRenaming}">
                              <Button Padding="8,5"
                                      Command="{Binding DataContext.BeginRenameProjectGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Rename}" FontSize="10" />
                              </Button>
                              <Button Padding="8,5"
                                      Command="{Binding DataContext.RequestDeleteProjectGroupCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{infra:LocalizedString Key=Common.Delete}" FontSize="10" />
                              </Button>
                            </WrapPanel>
                          </Grid>
                        </Border>

                          <Border IsVisible="{Binding IsDeleteConfirmationVisible}"
                                  CornerRadius="10"
                                  Background="{DynamicResource DangerSoftBrush}"
                                  BorderBrush="{DynamicResource DangerBrush}"
                                  BorderThickness="1"
                                  Padding="10">
                            <StackPanel Spacing="8">
                              <TextBlock Text="{Binding DeleteExplanation}"
                                         TextWrapping="Wrap"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <WrapPanel ItemSpacing="8">
                                <Button Command="{Binding DataContext.ConfirmDeleteProjectGroupCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{infra:LocalizedString Key=Common.Delete}" />
                                </Button>
                                <Button Command="{Binding DataContext.CancelDeleteProjectGroupCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="{infra:LocalizedString Key=Common.Cancel}" />
                                </Button>
                              </WrapPanel>
                            </StackPanel>
                          </Border>

                          <ListBox Classes="project-list"
                                   ItemsSource="{Binding Projects}"
                                   SelectedItem="{Binding DataContext.SelectedProject, ElementName=Root, Mode=TwoWay}"
                                   ItemTemplate="{StaticResource ProjectCardTemplate}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   HorizontalAlignment="Stretch"
                                   ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   Padding="0" />

                          <TextBlock IsVisible="{Binding !HasProjects}"
                                     Text="{infra:LocalizedString Key=Projects.Folder.Empty}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     HorizontalAlignment="Center"
                                     Margin="0,10" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox x:Name="ProjectList"
                       Classes="project-list"
                       ItemsSource="{Binding UngroupedProjects}"
                       SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                       ItemTemplate="{StaticResource ProjectCardTemplate}"
                       IsVisible="{Binding HasUngroupedProjects}"
                       Background="Transparent"
                       BorderThickness="0"
                       HorizontalAlignment="Stretch"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       Padding="0,0,0,8" />
              </StackPanel>
            </ScrollViewer>

            <Border IsVisible="{Binding ShowProjectsEmptyState}"
                    CornerRadius="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Padding="20"
                    VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Empty.Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{infra:LocalizedString Key=Projects.Empty.Description}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- RIGHT: details + stats -->
      <Border x:Name="ProjectDetailsCard"
              Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              DataContext="{Binding SelectedProject}"
              IsVisible="{Binding DataContext.HasSelectedProject, ElementName=Root}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
          <!-- Header: avatar + name + path -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="48"
                  Height="48"
                  IsVisible="{Binding DataContext.ShowProjectAvatars, ElementName=Root}">
              <Border CornerRadius="24"
                      Background="{Binding AvatarColor}" />
              <Image Source="{Binding AvatarImagePath}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding HasCustomAvatar}">
                <Image.Clip>
                  <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                </Image.Clip>
              </Image>
              <TextBlock Text="{Binding AvatarInitials}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="Normal"
                         FontSize="12"
                         Foreground="{Binding AvatarColor, Converter={StaticResource ContrastForegroundConverter}}"/>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock
                Text="{Binding Name}"
                FontSize="{DynamicResource PageTitleFontSize}"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{infra:LocalizedString Key=Projects.Label.Location}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{Binding Path}" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="stat-pill sm info"
                            ToolTip.Tip="{infra:LocalizedString Key=Projects.Stat.LastSnapshotLabel}">
                      <TextBlock Text="{Binding LastSnapshotSummary}"
                                 FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="220" />
                    </Border>
                    <Border Classes="stat-pill sm info"
                            ToolTip.Tip="{infra:LocalizedString Key=Projects.Stat.LatestSnapshotSize}">
                      <TextBlock Text="{Binding LatestSnapshotSizeDisplay}"
                                 FontSize="11" />
                    </Border>
                  </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Actions: open folder + snapshot -->

          <StackPanel Grid.Row="1" Spacing="10">
            <WrapPanel ItemSpacing="8"
                       LineSpacing="8"
                       HorizontalAlignment="Left">
            <Button Classes="action-ghost"
                    Padding="14,8"
                    CornerRadius="10"
                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.OpenFolder}" />
            </Button>
            <Button x:Name="ProjectSnapshotButton"
                    Classes="action-primary"
                    Padding="14,8"
                    CornerRadius="10"
                    Command="{Binding DataContext.TakeSnapshotCommand, ElementName=Root}"
                    Content="{Binding DataContext.SnapshotActionLabel, ElementName=Root}" />
            <Button
                    Classes="action-ghost action-danger"
                    Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Command="{Binding DataContext.RemoveProjectCommand, ElementName=Root}"
                    Content="{infra:LocalizedString Key=Projects.Detail.RemoveProject}" />
            </WrapPanel>

            <Border IsVisible="{Binding DataContext.IsRemoveProjectPreviewOpen, ElementName=Root}"
                    Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    AutomationProperties.LiveSetting="Polite">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="{Binding DataContext.RemoveProjectPreviewTitle, ElementName=Root}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Text="{Binding DataContext.RemoveProjectPreviewDetail, ElementName=Root}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
                  <Button Classes="action-ghost"
                          Content="{infra:LocalizedString Key=Dashboard.Workflow.Backups}"
                          Command="{Binding DataContext.ReviewStoredBackupsCommand, ElementName=Root}" />
                  <Button Classes="action-ghost"
                          Content="{infra:LocalizedString Key=Common.Cancel}"
                          Command="{Binding DataContext.CancelRemoveProjectCommand, ElementName=Root}" />
                  <Button Classes="action-danger"
                          Content="{infra:LocalizedString Key=Projects.Detail.RemoveProject}"
                          Command="{Binding DataContext.ConfirmRemoveProjectCommand, ElementName=Root}" />
                </WrapPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Project controls + key stats -->
          <Grid Grid.Row="2"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">
            <!-- Preset -->
            <Border x:Name="ProjectEncryptionCard"
                    Grid.Column="0"
                    Grid.Row="0"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotPreset}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectPresetCombo"
                          Grid.Row="1"
                          Classes="preset-combo"
                          ItemsSource="{Binding DataContext.AvailablePresets, ElementName=Root}"
                          SelectedItem="{Binding Preset, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Grid.Row="2"
                           Margin="0,2,0,0"
                           Text="{Binding PresetDescription}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="3"
                           IsVisible="{Binding PresetExample, Converter={StaticResource StringNotEmptyConverter}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{infra:LocalizedString Key=Projects.Preset.ExampleLabel}" />
                  <Run Text=" " />
                  <Run Text="{Binding PresetExample}" />
                </TextBlock>
                <TextBlock Grid.Row="4"
                           IsVisible="{Binding RecommendedPreset, Converter={StaticResource StringNotEmptyConverter}}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                  <Run Text="{infra:LocalizedString Key=Projects.Preset.Recommendation.Label}" />
                  <Run Text=" " />
                  <Run Text="{Binding RecommendedPreset}" />
                  <Run Text=" - " />
                  <Run Text="{Binding RecommendedPresetReason}" />
                </TextBlock>
                <Button Grid.Row="5"
                        IsVisible="{Binding RecommendedPreset, Converter={StaticResource StringNotEmptyConverter}}"
                        HorizontalAlignment="Left"
                        Padding="{DynamicResource ButtonTightPadding}"
                        CornerRadius="10"
                        Background="{DynamicResource Surface2}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding DataContext.ApplyPresetRecommendationCommand, ElementName=Root}">
                  <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Recommendation.Apply}" />
                </Button>
                <TextBlock Grid.Row="6"
                           Text="{infra:LocalizedString Key=Projects.Tags.Label}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel x:Name="ProjectTagsEditorSection"
                            Grid.Row="7"
                            Spacing="6">
                  <ItemsControl ItemsSource="{Binding DataContext.SelectedProjectTags, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="999"
                                Background="{Binding Background}"
                                BorderBrush="{Binding Border}"
                                BorderThickness="1"
                                Padding="10,4"
                                DoubleTapped="OnProjectTagPillDoubleTapped">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Value}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{Binding Foreground}" />
                            <Button Classes="small-button"
                                    Padding="4,0"
                                    MinWidth="18"
                                    MinHeight="18"
                                    VerticalAlignment="Center"
                                    Background="#00000000"
                                    Foreground="{Binding Foreground}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.RemoveProjectTagCommand, ElementName=Root}"
                                    CommandParameter="{Binding Value}"
                                    AutomationProperties.Name="{infra:LocalizedString Key=Projects.Tags.Remove}"
                                    ToolTip.Tip="{infra:LocalizedString Key=Projects.Tags.Remove}">
                              <shapes:Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                                           Width="10"
                                           Height="10"
                                           Stretch="Uniform"
                                           Stroke="{Binding Foreground}"
                                           StrokeThickness="1.5" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBox Text="{Binding DataContext.ProjectTagInput, ElementName=Root, Mode=TwoWay}"
                           PlaceholderText="{infra:LocalizedString Key=Projects.Tags.Watermark}"
                           Background="{DynamicResource InputBackgroundBrush}"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1"
                           Padding="{DynamicResource InputPadding}"
                           KeyDown="OnProjectTagInputKeyDown" />

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding DataContext.ToggleProjectTagColorEditorCommand, ElementName=Root}"
                            IsEnabled="{Binding DataContext.CanEditProjectTagColor, ElementName=Root}"
                            Padding="{DynamicResource ButtonPadding}"
                            CornerRadius="12"
                            Background="{DynamicResource Surface2}"
                            Foreground="{DynamicResource TextPrimaryBrush}">
                      <TextBlock Text="{Binding DataContext.ProjectTagColorToggleLabel, ElementName=Root}" />
                    </Button>
                    <Border CornerRadius="999"
                            Padding="12,4"
                            Background="{Binding DataContext.ProjectTagColorPreviewBackground, ElementName=Root}"
                            BorderBrush="{Binding DataContext.ProjectTagColorPreviewBorder, ElementName=Root}"
                            BorderThickness="1"
                            IsVisible="{Binding DataContext.CanEditProjectTagColor, ElementName=Root}">
                      <TextBlock Text="{Binding DataContext.ProjectTagColorTarget, ElementName=Root}"
                                 Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                 FontWeight="Bold"
                                 TextTrimming="CharacterEllipsis"
                                 MaxWidth="160" />
                    </Border>
                  </StackPanel>

                  <Border IsVisible="{Binding DataContext.IsProjectTagColorEditorOpen, ElementName=Root}"
                          CornerRadius="18"
                          Background="{DynamicResource Surface2}"
                          BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="1"
                          Padding="16">
                    <StackPanel Spacing="14">
                      <WrapPanel Orientation="Horizontal"
                                 ItemSpacing="14"
                                 LineSpacing="14">
                        <StackPanel MinWidth="240"
                                    MaxWidth="420"
                                    Spacing="4">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Label}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Description}"
                                     FontSize="10"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <Border MinWidth="220"
                                MaxWidth="320"
                                CornerRadius="16"
                                Padding="16,14"
                                Background="{Binding DataContext.ProjectTagColorPreviewBackground, ElementName=Root}"
                                BorderBrush="{Binding DataContext.ProjectTagColorPreviewBorder, ElementName=Root}"
                                BorderThickness="1">
                          <StackPanel Spacing="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.ProjectTagColorTarget, ElementName=Root}"
                                       Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DataContext.ProjectTagColorHex, ElementName=Root}"
                                       Foreground="{Binding DataContext.ProjectTagColorPreviewForeground, ElementName=Root}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </WrapPanel>

                      <WrapPanel Orientation="Horizontal"
                                 ItemSpacing="14"
                                 LineSpacing="14">
                        <Border MinWidth="260"
                                MaxWidth="360"
                                Background="{DynamicResource Surface1}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{Binding DataContext.ProjectTagColorPickerLabel, ElementName=Root}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border ClipToBounds="True"
                                    Background="Transparent">
                              <colorpicker:ColorView Color="{Binding DataContext.SelectedProjectTagColor, ElementName=Root, Mode=TwoWay}"
                                                     Margin="6,-48,6,6"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaVisible="False"
                                                     IsColorModelVisible="False"
                                                     IsColorPaletteVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsComponentTextInputVisible="False"
                                                     IsColorPreviewVisible="False"
                                                     IsColorSpectrumVisible="True"
                                                     IsColorSpectrumSliderVisible="True"
                                                     IsComponentSliderVisible="False"
                                                     MaxWidth="260"
                                                     HorizontalAlignment="Left"
                                                     ClipToBounds="False"
                                                     ColorSpectrumShape="Ring" />
                            </Border>
                          </StackPanel>
                        </Border>

                        <Border MinWidth="220"
                                MaxWidth="300"
                                Background="{DynamicResource Surface1}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{Binding DataContext.ProjectTagColorPaletteLabel, ElementName=Root}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding DataContext.ProjectTagColorSwatches, ElementName=Root}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Button Classes="color-swatch-button"
                                          Width="46"
                                          Height="34"
                                          Command="{Binding DataContext.ApplyProjectTagColorSwatchCommand, ElementName=Root}"
                                          CommandParameter="{Binding Hex}">
                                    <Border Width="40"
                                            Height="28"
                                            CornerRadius="10"
                                            Background="{Binding SwatchBrush}"
                                            BorderBrush="{Binding OutlineBrush}"
                                            BorderThickness="1.5" />
                                  </Button>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DataContext.ProjectTagColorGlobalHint, ElementName=Root}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </WrapPanel>

                      <WrapPanel Orientation="Horizontal"
                                 HorizontalAlignment="Right"
                                 ItemSpacing="10"
                                 LineSpacing="10">
                        <Button Command="{Binding DataContext.ResetProjectTagColorCommand, ElementName=Root}"
                                Padding="{DynamicResource ButtonTightPadding}"
                                CornerRadius="12"
                                Background="{DynamicResource Surface1}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Reset}" />
                        </Button>
                        <Button Command="{Binding DataContext.ApplyProjectTagColorCommand, ElementName=Root}"
                                Padding="{DynamicResource ButtonTightPadding}"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource TextOnAccentBrush}">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Color.Apply}" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.Help}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Tags.ReusableLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding DataContext.ReusableProjectTags, ElementName=Root}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Padding="8,3"
                                  CornerRadius="999"
                                  Background="{Binding Background}"
                                  BorderBrush="{Binding Border}"
                                  BorderThickness="1"
                                  Foreground="{Binding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Command="{Binding DataContext.AddExistingTagToSelectedProjectCommand, ElementName=Root}"
                                  CommandParameter="{Binding Value}">
                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" TextAlignment="Center" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Row="8"
                        HorizontalAlignment="Left"
                        Classes="preset-editor-action"
                        Command="{Binding DataContext.TogglePresetEditorCommand, ElementName=Root}"
                        IsVisible="{Binding DataContext.HasPresetEditorTarget, ElementName=Root}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DataContext.PresetEditorToggleLabel, ElementName=Root}"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Border Grid.Row="9"
                        IsVisible="{Binding DataContext.IsPresetEditorVisible, ElementName=Root}"
                        Classes="preset-editor-shell">
                  <Grid RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{infra:LocalizedString Key=Projects.Preset.Editor.Help}"
                                   TextWrapping="Wrap"
                                   MaxWidth="520" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Classes="preset-editor-badge"
                              VerticalAlignment="Top">
                        <TextBlock FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   ToolTip.Tip="{Binding DataContext.PresetEditorPath, ElementName=Root}"
                                   Text="{Binding DataContext.PresetEditorPathDisplay, ElementName=Root}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                      </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.9*,1.1*"
                          ColumnSpacing="14">
                      <Border Grid.Column="0"
                              Classes="preset-editor-section"
                              Padding="0">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="0">
                          <Border Background="{DynamicResource Surface2}"
                                  CornerRadius="16,16,0,0"
                                  Padding="12,10"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.PanelTitle}"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                              <TextBlock Grid.Column="1"
                                         Text="{infra:LocalizedString Key=Projects.Preset.Editor.PanelSubtitle}"
                                         FontSize="10"
                                         Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                          </Border>
                          <TextBox Grid.Row="1"
                                   AcceptsReturn="True"
                                   TextWrapping="NoWrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   MinHeight="320"
                                   VerticalContentAlignment="Top"
                                   Text="{Binding DataContext.PresetEditorContent, ElementName=Root, Mode=TwoWay}"
                                   Background="{DynamicResource InputBackgroundBrush}"
                                   BorderThickness="0"
                                   Padding="14,12" />
                        </Grid>
                      </Border>

                      <StackPanel Grid.Column="1"
                                  Spacing="12">
                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="10">
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.ActionsTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Classes="preset-editor-primary"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.SavePresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Save}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.PreviewPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Preview}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ReloadPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Reload}" />
                            </Button>
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ExportPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Export}" />
                            </Button>
                          </StackPanel>
                        </Border>

                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.ImportTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.ImportDescription}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding DataContext.PresetEditorImportPath, ElementName=Root, Mode=TwoWay}"
                                     PlaceholderText="{infra:LocalizedString Key=Projects.Preset.Editor.ImportPathWatermark}"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="1"
                                     Padding="{DynamicResource InputPadding}" />
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ImportPresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Import}" />
                            </Button>
                          </StackPanel>
                        </Border>

                        <Border Classes="preset-editor-section">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.CloneTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.CloneDescription}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox Text="{Binding DataContext.PresetEditorCloneId, ElementName=Root, Mode=TwoWay}"
                                     PlaceholderText="{infra:LocalizedString Key=Projects.Preset.Editor.CloneIdWatermark}"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="1"
                                     Padding="{DynamicResource InputPadding}" />
                            <Button Classes="preset-editor-action"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ClonePresetEditorCommand, ElementName=Root}">
                              <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.Clone}" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Classes="preset-editor-section"
                            Padding="12,10">
                      <Grid ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0" />
                        <StackPanel Grid.Column="1"
                                    Spacing="2">
                          <TextBlock Text="{infra:LocalizedString Key=Projects.Preset.Editor.StatusTitle}"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock FontSize="10"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Text="{Binding DataContext.PresetEditorStatus, ElementName=Root}"
                                     TextWrapping="Wrap"
                                     MaxLines="3" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- Destination -->
            <Border CornerRadius="14"
                    Grid.Column="1"
                    Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Folder.Assignment}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.GroupOptions, ElementName=Root}"
                    SelectedItem="{Binding SelectedGroupOption, Mode=TwoWay}"
                    IsEnabled="{Binding IsRegistered}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2"
                           Margin="0,6,0,0"
                           Text="{infra:LocalizedString Key=Projects.Stat.DestinationLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox
                    Grid.Row="3"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.DestinationOptions, ElementName=Root}"
                    SelectedItem="{Binding PreferredDestinationOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Border>

            <!-- Encryption policy -->
            <Border CornerRadius="14"
                    Grid.Column="0"
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.EncryptionPolicy}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectEncryptionPolicyCombo"
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.EncryptionPolicyOptions, ElementName=Root}"
                    SelectedItem="{Binding EncryptionPolicyOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Row="2"
                           Orientation="Horizontal"
                           ItemSpacing="8"
                           VerticalAlignment="Center">
                  <TextBlock Text="{Binding EffectiveEncryptionDisplay}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <Border CornerRadius="999"
                          Padding="8,2"
                          Background="{Binding EncryptionBadgeBackground}">
                    <TextBlock Text="{Binding EncryptionBadgeText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding EncryptionBadgeForeground}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                </WrapPanel>
                <Button x:Name="ProjectEncryptionPasswordButton"
                        Grid.Row="3"
                        Content="{infra:LocalizedString Key=Settings.Encryption.SetPassword}"
                        Classes="action-ghost"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.ManageProjectEncryptionCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Row="4"
                           Text="{Binding EncryptionSecretStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <!-- Health -->
            <Border CornerRadius="14"
                    Grid.Column="1"
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0">
              <StackPanel Spacing="8">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectHealth}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <Border CornerRadius="999"
                        Background="{Binding HealthBackground}"
                        Padding="{DynamicResource StatPillPadding}">
                  <TextBlock Text="{Binding HealthTag}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{Binding HealthForeground}"
                             HorizontalAlignment="Center"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Section.AutoBackups}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Section.AutoBackupsTooltip}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding IsAutoBackupEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding IsRegistered}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{infra:LocalizedString Key=Backups.Section.AutoBackups}"
                                AutomationProperties.HelpText="{infra:LocalizedString Key=Backups.Section.AutoBackupsTooltip}" />
                </Grid>
              </StackPanel>
            </Border>

          </Grid>

          <!-- Stats card -->
          <Border Grid.Row="3"
                  Margin="0,2,0,0"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource CardPaddingMedium}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  RowSpacing="12">

              <!-- Top metrics -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="12">
                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TotalSnapshots}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding SnapshotCount}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotStorage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding TotalSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="2">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.AverageSnapshot}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding AverageSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        MinHeight="64"
                        Grid.Column="3">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TimeSinceLast}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding DaysSinceLastSnapshotDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="1"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Snapshot size trend -->
              <StackPanel Grid.Row="2"
                          Spacing="10">

                <TextBlock
                  Text="{infra:LocalizedString Key=Projects.Stat.SnapshotTrend}"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- subtle y-axis baseline -->
                <Border Height="1"
                        Background="{DynamicResource SubtleAxisBrush}"
                        Margin="0,0,0,4"/>

                <!-- Chart area -->
                <Grid RowDefinitions="Auto,Auto">

                  <!-- Bars row -->
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="{DynamicResource ChartItemMargin}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center">
                          <Border
                            Classes="snapshot-bar"
                            Width="22"
                            CornerRadius="6"
                            Background="{Binding TrendColor}"
                            Height="{Binding RelativeBarHeightCapped}"
                            VerticalAlignment="Bottom"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding TooltipText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- X-axis labels (dates) -->
                  <ItemsControl Grid.Row="1"
                                ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{Binding DayLabel}"
                          IsVisible="{Binding ShowDayLabel}"
                          FontSize="10"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center"
                          Margin="{DynamicResource ChartLabelMargin}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendDecreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Decreasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendIncreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Increasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendUnchangedBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Unchanged}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>

              </StackPanel>

              <Border Grid.Row="3"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Recent snapshots list -->
              <Border Grid.Row="4"
                      CornerRadius="18"
                      Background="{DynamicResource CardRaisedBackgroundBrush}"
                      Padding="{DynamicResource CardPaddingSmall}">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">
                  <TextBlock
                    Grid.Row="0"
                    Text="{infra:LocalizedString Key=Projects.Stat.RecentSnapshots}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

                  <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SnapshotHistory}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="12"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Margin="0,4,0,0"
                                  Padding="{DynamicResource CardPaddingSmall}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="6">
                              <Border Grid.RowSpan="3"
                                      Width="6"
                                      CornerRadius="3"
                                      Background="{DynamicResource AccentBrush}"
                                      Opacity="0.6" />
                              <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding DateDisplay}"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                              <Border Grid.Row="0"
                                      Grid.Column="2"
                                      CornerRadius="999"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Padding="{DynamicResource StatPillPadding}">
                                <TextBlock
                                  Text="{Binding SizeDisplay}"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap" />
                              </Border>
                              <TextBlock Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding DiffSummaryDisplay}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="2" />
                              <TextBlock Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Text="{Binding DiffTopPathsDisplay}"
                                         FontSize="10"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="2"
                                         IsVisible="{Binding HasDiffTopPaths}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

            </Grid>
          </Border>

          </Grid>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              IsVisible="{Binding ShowSelectedProjectEmptyState}">
        <StackPanel Spacing="10"
                    VerticalAlignment="Top">
          <TextBlock Text="{infra:LocalizedString Key=Projects.Details.EmptyTitle}"
                     FontSize="{DynamicResource PageTitleFontSize}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{infra:LocalizedString Key=Projects.Details.EmptyDescription}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    </Grid>
  </Border>
</UserControl>
