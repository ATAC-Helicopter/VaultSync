<UserControl
    x:Class="VaultSync.UI.Views.ProjectsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Hover effect for snapshot bars -->
    <Style Selector="Border.snapshot-bar:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Search box: keep focus visuals clean -->
    <Style Selector="TextBox#ProjectSearch">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Focusable" Value="True" />
    </Style>

    <!-- Preset dropdown: pill style -->
    <Style Selector="ComboBox.preset-combo">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>

    <!-- Custom container template for project list items -->
    <Style Selector="#ProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,8,0,0"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="16">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Soft tint for selected project -->
    <Style Selector="#ProjectList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="32,24,32,24" RowDefinitions="Auto,*" RowSpacing="16">

    <controls:NotificationCard
        Grid.Row="0"
        Margin="0,0,0,12"
        DataContext="{Binding Notification}" />

    <!-- Inner content -->
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: All projects card -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">

          <!-- Title + sort -->
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{infra:LocalizedString Key=Projects.Page.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1"
                    Padding="10,6"
                    CornerRadius="10"
                    Background="{DynamicResource Surface2}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding ToggleSortCommand}">
              <TextBlock Text="{Binding SortModeLabel}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Row="1" ColumnSpacing="8">
            <Border CornerRadius="12"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Padding="0,0,6,0">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="12" />
                <TextBox
                  x:Name="ProjectSearch"
                  Margin="0"
                  Padding="10,8"
                  Watermark="{infra:LocalizedString Key=Projects.Page.SearchWatermark}"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding SearchText, Mode=TwoWay}"
                  CaretBrush="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </Border>

            <Button Grid.Column="1"
                    Padding="12,6"
                    CornerRadius="10"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Action.Refresh}" />
            </Button>
          </Grid>

          <!-- Projects list -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ListBox
              x:Name="ProjectList"
              ItemsSource="{Binding Projects}"
              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
              Background="Transparent"
              BorderThickness="0"
              HorizontalAlignment="Stretch">

              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                    <!-- Name + last snapshot short + size + avatar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <Grid Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border CornerRadius="18" Background="{Binding AvatarColor}"/>
                        <Image Source="{Binding AvatarImagePath}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasCustomAvatar}">
                          <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                          </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding AvatarInitials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                      </Grid>
                      <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding LastSnapshotShort}"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock
                        Grid.Column="3"
                        Text="{Binding SizeDisplay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <!-- Path -->
                    <TextBlock
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,6,0,0"
                      Text="{Binding Path}"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="13"
                      TextWrapping="NoWrap"
                      TextTrimming="CharacterEllipsis" />

                    <!-- Health pill bar -->
                    <Border
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      CornerRadius="999"
                      Height="20"
                      Background="{Binding HealthBackground}">
                      <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="{Binding HealthTag}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextOnPillBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- RIGHT: details + stats -->
      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              DataContext="{Binding SelectedItem, ElementName=ProjectList}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
          <!-- Header: avatar + name + path -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="48"
                  Height="48"
                  IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Border CornerRadius="24"
                      Background="{Binding AvatarColor}" />
              <Image Source="{Binding AvatarImagePath}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding HasCustomAvatar}">
                <Image.Clip>
                  <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                </Image.Clip>
              </Image>
              <TextBlock Text="{Binding AvatarInitials}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Foreground="White"/>
            </Grid>

            <StackPanel Grid.Column="1">
              <TextBlock
                Text="{Binding Name}"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{infra:LocalizedString Key=Projects.Label.Location}" />
                    <Run Text=" " />
                    <Run Text="{Binding Path}" />
                  </TextBlock>
            </StackPanel>
          </Grid>

          <!-- Actions: open folder + snapshot -->

          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      Spacing="8">
            <Button Padding="10,4"
                    CornerRadius="999"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.OpenFolder}" />
            </Button>
            <Button Padding="10,4"
                    CornerRadius="999"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding DataContext.TakeSnapshotCommand, ElementName=Root}"
                    Content="{Binding DataContext.SnapshotActionLabel, ElementName=Root}" />
            <Button Padding="10,4"
                    CornerRadius="999"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DataContext.RemoveProjectCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.RemoveProject}" />
            </Button>
          </StackPanel>

          <!-- Stat badges row -->
          <Grid Grid.Row="2"
                ColumnDefinitions="*,*,*,*"
                ColumnSpacing="12">
            <!-- Preset -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotPreset}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.AvailablePresets, ElementName=Root}"
                    SelectedItem="{Binding Preset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
              </StackPanel>
            </Border>

            <!-- Health -->
            <Border Grid.Column="1"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectHealth}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border CornerRadius="999"
                        Background="{Binding HealthBackground}"
                        Padding="6,2">
                  <TextBlock Text="{Binding HealthTag}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextOnPillBrush}"
                             HorizontalAlignment="Center"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>
            </Border>

            <!-- Last snapshot -->
            <Border Grid.Column="2"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.LastSnapshotLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LastSnapshotSummary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <!-- Size -->
            <Border Grid.Column="3"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectSize}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding SizeDisplay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Stats card -->
          <Border Grid.Row="3"
                  Margin="0,4,0,0"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="16">
            <StackPanel Spacing="12">

              <!-- Top metrics -->
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TotalSnapshots}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SnapshotCount}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="10"
                        Grid.Column="1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotStorage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="10"
                        Grid.Column="2">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.AverageSnapshot}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding AverageSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="10"
                        Grid.Column="3">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TimeSinceLast}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DaysSinceLastSnapshotDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Snapshot size trend -->
              <StackPanel Spacing="10">

                <TextBlock
                  Text="{infra:LocalizedString Key=Projects.Stat.SnapshotTrend}"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- subtle y-axis baseline -->
                <Border Height="1"
                        Background="{DynamicResource SubtleAxisBrush}"
                        Margin="0,0,0,4"/>

                <!-- Chart area -->
                <Grid RowDefinitions="Auto,Auto">

                  <!-- Bars row -->
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="6,0"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center">
                          <Border
                            Classes="snapshot-bar"
                            Width="22"
                            CornerRadius="6"
                            Background="{Binding TrendColor}"
                            Height="{Binding RelativeBarHeight}"
                            VerticalAlignment="Bottom"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding TooltipText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- X-axis labels (dates) -->
                  <ItemsControl Grid.Row="1"
                                ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{Binding Timestamp, StringFormat='{}{0:dd/MM}'}"
                          FontSize="10"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center"
                          Margin="10,4,10,0"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendDecreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Decreasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendIncreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Increasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendUnchangedBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Unchanged}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>

              </StackPanel>

              <Border Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Recent snapshots list -->
              <StackPanel Spacing="8">
                <TextBlock
                  Text="{infra:LocalizedString Key=Projects.Stat.RecentSnapshots}"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="220">
                  <ItemsControl ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                          <TextBlock
                            Grid.Column="0"
                            Text="{Binding DateDisplay}"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                          <TextBlock
                            Grid.Column="1"
                            Text="{Binding SizeDisplay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>

            </StackPanel>
          </Border>

        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
