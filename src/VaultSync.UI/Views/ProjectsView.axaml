<UserControl
    x:Class="VaultSync.UI.Views.ProjectsView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Hover effect for snapshot bars -->
    <Style Selector="Border.snapshot-bar:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Search box: keep focus visuals clean -->
    <Style Selector="TextBox#ProjectSearch">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Focusable" Value="True" />
    </Style>

    <!-- Preset dropdown: pill style -->
    <Style Selector="ComboBox.preset-combo">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
    </Style>

    <!-- Custom container template for project list items -->
    <Style Selector="#ProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="{DynamicResource ListItemMargin}"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource ListItemPadding}">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Soft tint for selected project -->
    <Style Selector="#ProjectList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Padding="{DynamicResource PagePadding}">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="{DynamicResource PageRowSpacing}"
          MaxWidth="2200"
          HorizontalAlignment="Stretch">

    <controls:NotificationCard
        Grid.Row="0"
        Margin="{DynamicResource SectionMarginBottom}"
        DataContext="{Binding Notification}" />

    <!-- Inner content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: All projects card -->
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="{DynamicResource CardPaddingLarge}">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource PageRowSpacing}">

          <!-- Title + sort -->
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="{infra:LocalizedString Key=Projects.Page.Title}"
                       FontSize="{DynamicResource PageTitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button Grid.Column="1"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource Surface2}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding ToggleSortCommand}">
              <TextBlock Text="{Binding SortModeLabel}"
                         FontSize="12"
                         FontWeight="SemiBold" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Row="1" ColumnSpacing="8">
            <Border CornerRadius="12"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Padding="0,0,6,0">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="12" />
                <TextBox
                  x:Name="ProjectSearch"
                  Margin="0"
                  Padding="{DynamicResource InputPadding}"
                  Watermark="{infra:LocalizedString Key=Projects.Page.SearchWatermark}"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Text="{Binding SearchText, Mode=TwoWay}"
                  CaretBrush="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </Border>

            <Button Grid.Column="1"
                    Padding="{DynamicResource ButtonTightPadding}"
                    CornerRadius="10"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding RefreshCommand}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Action.Refresh}" />
            </Button>
          </Grid>

          <!-- Projects list -->
          <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,0,8">
            <ListBox
              x:Name="ProjectList"
              ItemsSource="{Binding Projects}"
              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
              Background="Transparent"
              BorderThickness="0"
              HorizontalAlignment="Stretch">

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="{DynamicResource ListRowSpacing}">
                    <!-- Name + last snapshot short + size + avatar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <Grid Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,4,0"
                            IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border CornerRadius="18" Background="{Binding AvatarColor}"/>
                        <Image Source="{Binding AvatarImagePath}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasCustomAvatar}">
                          <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                          </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding AvatarInitials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                      </Grid>
                <TextBlock
                        Grid.Column="1"
                        Text="{Binding Name}"
                        FontSize="{DynamicResource SectionHeaderFontSize}"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Grid.Column="2"
                        Text="{Binding LastSnapshotShort}"
                        FontSize="{DynamicResource PageSubtitleFontSize}"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock
                        Grid.Column="3"
                        Text="{Binding SizeDisplay}"
                        FontSize="{DynamicResource PageSubtitleFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>

                    <!-- Path -->
                    <TextBlock
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,6,0,0"
                      Text="{Binding Path}"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="{DynamicResource PageSubtitleFontSize}"
                      TextWrapping="NoWrap"
                      TextTrimming="CharacterEllipsis" />

                    <!-- Destination -->
                    <TextBlock
                      Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="0,2,0,0"
                      Foreground="{DynamicResource TextMutedBrush}"
                      FontSize="{DynamicResource PageSubtitleFontSize}"
                      TextWrapping="NoWrap"
                      TextTrimming="CharacterEllipsis">
                      <Run Text="{infra:LocalizedString Key=Projects.List.DestinationPrefix}" />
                      <Run Text="{Binding PreferredDestinationDisplay}" />
                    </TextBlock>

                    <StackPanel Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{infra:LocalizedString Key=Projects.List.EncryptionPrefix}"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 FontSize="{DynamicResource PageSubtitleFontSize}" />
                      <Border CornerRadius="999"
                              Padding="8,2"
                              Background="{Binding EncryptionBadgeBackground}">
                        <TextBlock Text="{Binding EncryptionBadgeText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding EncryptionBadgeForeground}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>
                    </StackPanel>

                    <!-- Health pill bar -->
                    <Border
                      Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,0"
                      CornerRadius="999"
                      Height="20"
                      Background="{Binding HealthBackground}">
                      <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="{Binding HealthTag}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextOnPillBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- RIGHT: details + stats -->
      <Border x:Name="ProjectDetailsCard"
              Grid.Column="2"
              Background="{DynamicResource SurfaceCardBrush}"
              CornerRadius="24"
              Padding="24"
              DataContext="{Binding SelectedItem, ElementName=ProjectList}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
          <!-- Header: avatar + name + path -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Grid Width="48"
                  Height="48"
                  IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Border CornerRadius="24"
                      Background="{Binding AvatarColor}" />
              <Image Source="{Binding AvatarImagePath}"
                     Stretch="UniformToFill"
                     IsVisible="{Binding HasCustomAvatar}">
                <Image.Clip>
                  <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                </Image.Clip>
              </Image>
              <TextBlock Text="{Binding AvatarInitials}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontWeight="Normal"
                         FontSize="12"
                         Foreground="White"/>
            </Grid>

            <StackPanel Grid.Column="1">
              <TextBlock
                Text="{Binding Name}"
                FontSize="{DynamicResource PageTitleFontSize}"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{infra:LocalizedString Key=Projects.Label.Location}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{Binding Path}" />
                  </TextBlock>
            </StackPanel>
          </Grid>

          <!-- Actions: open folder + snapshot -->

          <StackPanel Grid.Row="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      Spacing="8">
            <Button Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.OpenFolder}" />
            </Button>
            <Button x:Name="ProjectSnapshotButton"
                    Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding DataContext.TakeSnapshotCommand, ElementName=Root}"
                    Content="{Binding DataContext.SnapshotActionLabel, ElementName=Root}" />
            <Button Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding DataContext.RemoveProjectCommand, ElementName=Root}">
              <TextBlock Text="{infra:LocalizedString Key=Projects.Detail.RemoveProject}" />
            </Button>
          </StackPanel>

          <!-- Stat badges row -->
          <WrapPanel Grid.Row="2"
                     Orientation="Horizontal"
                     ItemWidth="240">
            <!-- Preset -->
            <Border x:Name="ProjectEncryptionCard"
                    CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotPreset}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectPresetCombo"
                          Grid.Row="1"
                          Classes="preset-combo"
                          ItemsSource="{Binding DataContext.AvailablePresets, ElementName=Root}"
                          SelectedItem="{Binding Preset, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
              </Grid>
            </Border>

            <!-- Destination -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.DestinationLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.DestinationOptions, ElementName=Root}"
                    SelectedItem="{Binding PreferredDestinationOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Border>

            <!-- Encryption policy -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.EncryptionPolicy}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="ProjectEncryptionPolicyCombo"
                    Grid.Row="1"
                    Classes="preset-combo"
                    ItemsSource="{Binding DataContext.EncryptionPolicyOptions, ElementName=Root}"
                    SelectedItem="{Binding EncryptionPolicyOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Grid.Row="2"
                           Orientation="Horizontal"
                           ItemSpacing="8"
                           VerticalAlignment="Center">
                  <TextBlock Text="{Binding EffectiveEncryptionDisplay}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                  <Border CornerRadius="999"
                          Padding="8,2"
                          Background="{Binding EncryptionBadgeBackground}">
                    <TextBlock Text="{Binding EncryptionBadgeText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding EncryptionBadgeForeground}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                </WrapPanel>
                <Button x:Name="ProjectEncryptionPasswordButton"
                        Grid.Row="3"
                        Content="{infra:LocalizedString Key=Settings.Encryption.SetPassword}"
                        Classes="action-ghost"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.ManageProjectEncryptionCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Row="4"
                           Text="{Binding EncryptionSecretStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>

            <!-- Health -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <StackPanel Spacing="4">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectHealth}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <Border CornerRadius="999"
                        Background="{Binding HealthBackground}"
                        Padding="{DynamicResource StatPillPadding}">
                  <TextBlock Text="{Binding HealthTag}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextOnPillBrush}"
                             HorizontalAlignment="Center"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>
            </Border>

            <!-- Last snapshot -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.LastSnapshotLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <TextBlock Text="{Binding LastSnapshotSummary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <!-- Size -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Margin="0,0,12,12">
              <StackPanel Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.ProjectSize}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />
                <TextBlock Text="{Binding SizeDisplay}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Stats card -->
          <Border Grid.Row="3"
                  Margin="0,4,0,0"
                  CornerRadius="18"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="{DynamicResource CardPaddingMedium}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                  RowSpacing="12">

              <!-- Top metrics -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,*,*,*"
                    ColumnSpacing="12">
                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TotalSnapshots}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding SnapshotCount}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        Grid.Column="1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.SnapshotStorage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding TotalSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        Grid.Column="2">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.AverageSnapshot}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding AverageSnapshotSizeDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border CornerRadius="10"
                        Background="{DynamicResource CardRaisedBackgroundBrush}"
                        Padding="{DynamicResource CardPaddingSmall}"
                        Grid.Column="3">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.TimeSinceLast}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                    <TextBlock Text="{Binding DaysSinceLastSnapshotDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Grid.Row="1"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Snapshot size trend -->
              <StackPanel Grid.Row="2"
                          Spacing="10">

                <TextBlock
                  Text="{infra:LocalizedString Key=Projects.Stat.SnapshotTrend}"
                  FontSize="13"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

                <!-- subtle y-axis baseline -->
                <Border Height="1"
                        Background="{DynamicResource SubtleAxisBrush}"
                        Margin="0,0,0,4"/>

                <!-- Chart area -->
                <Grid RowDefinitions="Auto,Auto">

                  <!-- Bars row -->
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Bottom"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="{DynamicResource ChartItemMargin}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center">
                          <Border
                            Classes="snapshot-bar"
                            Width="22"
                            CornerRadius="6"
                            Background="{Binding TrendColor}"
                            Height="{Binding RelativeBarHeightCapped}"
                            VerticalAlignment="Bottom"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding TooltipText}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- X-axis labels (dates) -->
                  <ItemsControl Grid.Row="1"
                                ItemsSource="{Binding SnapshotHistory}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                  <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{Binding DayLabel}"
                          IsVisible="{Binding ShowDayLabel}"
                          FontSize="10"
                          Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center"
                          Margin="{DynamicResource ChartLabelMargin}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>

                <!-- Legend -->
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendDecreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Decreasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendIncreaseBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Increasing}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="3"
                            Background="{DynamicResource LegendUnchangedBrush}"/>
                    <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.Unchanged}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </StackPanel>

              </StackPanel>

              <Border Grid.Row="3"
                      Margin="0,6,0,0"
                      Height="1"
                      Background="{DynamicResource DividerBrush}" />

              <!-- Recent snapshots list -->
              <Border Grid.Row="4"
                      CornerRadius="18"
                      Background="{DynamicResource CardRaisedBackgroundBrush}"
                      Padding="{DynamicResource CardPaddingSmall}">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">
                  <TextBlock
                    Grid.Row="0"
                    Text="{infra:LocalizedString Key=Projects.Stat.RecentSnapshots}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

                  <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SnapshotHistory}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border CornerRadius="12"
                                  Background="{DynamicResource CardBackgroundBrush}"
                                  Margin="0,4,0,0"
                                  Padding="{DynamicResource CardPaddingSmall}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                              <Border Width="6"
                                      CornerRadius="3"
                                      Background="{DynamicResource AccentBrush}"
                                      Opacity="0.6" />
                              <TextBlock
                                Grid.Column="1"
                                Text="{Binding DateDisplay}"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                              <Border Grid.Column="2"
                                      CornerRadius="999"
                                      Background="{DynamicResource InputBackgroundBrush}"
                                      Padding="{DynamicResource StatPillPadding}">
                                <TextBlock
                                  Text="{Binding SizeDisplay}"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="NoWrap" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

            </Grid>
          </Border>

          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    </Grid>
  </Border>
</UserControl>
