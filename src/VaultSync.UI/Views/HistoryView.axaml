<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.history-kicker">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.history-muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.history-title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.history-surface">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.history-control">
      <Setter Property="Background" Value="{DynamicResource Surface0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.history-signal">
      <Setter Property="Background" Value="{DynamicResource Surface0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.history-chip">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Border.history-station">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBox.history-filter">
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.history-button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.history-title-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.history-title-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VS.Primary}" />
    </Style>
    <Style Selector="ListBox#TimelineList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="#TimelineList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="#TimelineList ListBoxItem:pointerover Border.history-station">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    </Style>
    <Style Selector="#TimelineList ListBoxItem:selected Border.history-station">
      <Setter Property="BorderBrush" Value="{DynamicResource VS.Primary}" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid MaxWidth="2200"
          HorizontalAlignment="Stretch"
          MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="{infra:LocalizedString Key=History.Title}"
                     FontSize="25"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Summary}"
                     Classes="history-muted"
                     MaxWidth="980" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="action-ghost history-button"
                Content="{infra:LocalizedString Key=Common.Refresh}"
                Command="{CompiledBinding RefreshCommand}"
                VerticalAlignment="Top" />
      </Grid>

      <Border Grid.Row="1"
              Classes="history-control">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              ColumnSpacing="10">
          <ComboBox Classes="history-filter"
                    ItemsSource="{CompiledBinding DateRangeOptions}"
                    SelectedItem="{CompiledBinding SelectedDateRange, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="1"
                    Classes="history-filter"
                    ItemsSource="{CompiledBinding ActivityFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedActivityFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="2"
                    Classes="history-filter"
                    MinWidth="190"
                    ItemsSource="{CompiledBinding ProjectFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedProjectFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="3"
                    Classes="history-filter"
                    ItemsSource="{CompiledBinding LaneFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedLaneFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <WrapPanel Grid.Column="4"
                     ItemSpacing="8"
                     LineSpacing="8"
                     VerticalAlignment="Center">
            <Border Classes="history-chip">
              <TextBlock Text="{CompiledBinding FilterStateLabel}"
                         Classes="history-kicker" />
            </Border>
            <Border Classes="history-chip">
              <TextBlock Text="{CompiledBinding WindowLabel}"
                         Classes="history-kicker" />
            </Border>
          </WrapPanel>

          <Button Grid.Column="5"
                  Classes="history-button"
                  Content="Reset"
                  Command="{CompiledBinding ResetFiltersCommand}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Row="2"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="10"
            IsVisible="{CompiledBinding HasLoadedEvents}">
        <Border Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#4F8DFF" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding LoadedSummaryLabel}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Loaded"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1"
                Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#FFB454" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding BackupSignalLabel}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Backup trunk"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2"
                Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#22CC88" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding RestoreSummaryLabel}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Restores"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="3"
                Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#8B7CFF" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding MetadataSignalLabel}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Metadata"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3"
              Classes="history-surface"
              ClipToBounds="True"
              IsVisible="{CompiledBinding HasLoadedEvents}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0"
                ColumnDefinitions="112,*,160"
                MinHeight="42"
                Background="{DynamicResource Surface0}">
            <TextBlock Text="Metro graph"
                       Classes="history-kicker"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0" />
            <WrapPanel Grid.Column="1"
                       ItemSpacing="12"
                       LineSpacing="6"
                       VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Border Width="9"
                        Height="9"
                        CornerRadius="5"
                        Background="#4F8DFF"
                        VerticalAlignment="Center" />
                <TextBlock Text="Auto"
                           Classes="history-kicker"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Border Width="9"
                        Height="9"
                        CornerRadius="5"
                        Background="#FFB454"
                        VerticalAlignment="Center" />
                <TextBlock Text="Manual"
                           Classes="history-kicker"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Border Width="9"
                        Height="9"
                        CornerRadius="5"
                        Background="#22CC88"
                        VerticalAlignment="Center" />
                <TextBlock Text="Restore"
                           Classes="history-kicker"
                           VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Border Width="9"
                        Height="9"
                        CornerRadius="5"
                        Background="#8B7CFF"
                        VerticalAlignment="Center" />
                <TextBlock Text="Metadata"
                           Classes="history-kicker"
                           VerticalAlignment="Center" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Grid.Column="2"
                       Text="{CompiledBinding PageLabel}"
                       Classes="history-kicker"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0" />
          </Grid>

          <ListBox x:Name="TimelineList"
                   Grid.Row="1"
                   IsVisible="{CompiledBinding HasTimelineItems}"
                   ItemsSource="{CompiledBinding TimelineItems}"
                   SelectedItem="{CompiledBinding SelectedTimelineItem, Mode=TwoWay}"
                   SelectionMode="Single"
                   Margin="14,0,14,0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="104,*"
                      MinHeight="84">
                  <Canvas Width="104"
                          Height="84"
                          ClipToBounds="False">
                    <Path Data="{Binding BackupGraphPathData}"
                          Stroke="#4F8DFF"
                          StrokeThickness="3.5"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                    <Path Data="{Binding MetadataGraphPathData}"
                          Stroke="#8B7CFF"
                          StrokeThickness="3.5"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                    <Path Data="{Binding RestoreGraphPathData}"
                          Stroke="#22CC88"
                          StrokeThickness="3.5"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                    <Ellipse Canvas.Left="{Binding NodeLeft}"
                             Canvas.Top="32"
                             Width="20"
                             Height="20"
                             Fill="{DynamicResource Surface0}"
                             Stroke="{Binding Accent}"
                             StrokeThickness="3.5" />
                    <Ellipse Canvas.Left="{Binding InnerNodeLeft}"
                             Canvas.Top="37"
                             Width="10"
                             Height="10"
                             Fill="{Binding Accent}" />
                  </Canvas>

                  <Border Grid.Column="1"
                          Classes="history-station"
                          Margin="0,6,0,6">
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="14"
                          RowSpacing="7">
                      <WrapPanel ItemSpacing="8"
                                 LineSpacing="6">
                        <Border Classes="history-chip"
                                BorderBrush="{Binding Accent}">
                          <TextBlock Text="{Binding Kind}"
                                     Classes="history-kicker" />
                        </Border>
                        <Border Classes="history-chip">
                          <TextBlock Text="{Binding Lane}"
                                     Classes="history-kicker" />
                        </Border>
                        <Border Classes="history-chip"
                                IsVisible="{Binding HasMarkerSummary}">
                          <TextBlock Text="{Binding MarkerSummary}"
                                     Classes="history-kicker" />
                        </Border>
                      </WrapPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="2"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{Binding RelativeLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TimeLabel}"
                                   Classes="history-kicker"
                                   HorizontalAlignment="Right" />
                      </StackPanel>

                      <Button Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Classes="history-title-button"
                              ToolTip.Tip="{Binding Detail}">
                        <Button.Flyout>
                          <Flyout Placement="Right">
                            <Border Classes="history-control"
                                    Width="360">
                              <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                    RowSpacing="10">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                  <Border Width="5"
                                          CornerRadius="3"
                                          Background="{Binding Accent}" />
                                  <StackPanel Grid.Column="1"
                                              Spacing="4">
                                    <TextBlock Text="{Binding Kind}"
                                               Classes="history-kicker" />
                                    <TextBlock Text="{Binding Title}"
                                               Classes="history-title" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Detail}"
                                           Classes="history-muted" />
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="8">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="Project"
                                               Classes="history-kicker" />
                                    <TextBlock Text="{Binding ProjectName}"
                                               Classes="history-title"
                                               TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1"
                                              Spacing="2">
                                    <TextBlock Text="Line"
                                               Classes="history-kicker" />
                                    <TextBlock Text="{Binding Lane}"
                                               Classes="history-title"
                                               TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <StackPanel Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Spacing="2">
                                    <TextBlock Text="Origin"
                                               Classes="history-kicker" />
                                    <TextBlock Text="{Binding OriginSummary}"
                                               Classes="history-muted"
                                               IsVisible="{Binding HasOriginSummary}" />
                                  </StackPanel>
                                </Grid>
                                <WrapPanel Grid.Row="3"
                                           ItemSpacing="8"
                                           LineSpacing="8">
                                  <Border Classes="history-chip"
                                          IsVisible="{Binding HasMarkerSummary}">
                                    <TextBlock Text="{Binding MarkerSummary}"
                                               Classes="history-kicker" />
                                  </Border>
                                </WrapPanel>
                              </Grid>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                        <TextBlock Text="{Binding Title}"
                                   Classes="history-title"
                                   TextTrimming="CharacterEllipsis" />
                      </Button>
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="1"
                IsVisible="{CompiledBinding !HasTimelineItems}">
            <Border Classes="history-control"
                    Width="540"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <StackPanel Spacing="12">
                <TextBlock Text="{CompiledBinding EmptyTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{CompiledBinding EmptyMessage}"
                           Classes="history-muted"
                           TextAlignment="Center" />
                <Button Content="Reset filters"
                        Command="{CompiledBinding ResetFiltersCommand}"
                        HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="2"
                ColumnDefinitions="Auto,*,Auto"
                MinHeight="54"
                Margin="14,0"
                ColumnSpacing="12">
            <Button Content="Previous"
                    Command="{CompiledBinding PreviousPageCommand}"
                    VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Spacing="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding PageLabel}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{CompiledBinding WindowLabel}"
                         Classes="history-kicker"
                         HorizontalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="2"
                    Content="Next"
                    Command="{CompiledBinding NextPageCommand}"
                    VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="3"
            IsVisible="{CompiledBinding !HasLoadedEvents}">
        <Border Classes="history-surface"
                Width="620"
                Padding="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <TextBlock Text="{CompiledBinding EmptyTitle}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding EmptyMessage}"
                       Classes="history-muted" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
