<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.history-kicker">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.history-muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.history-title">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.history-value">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.history-surface">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.history-panel">
      <Setter Property="Background" Value="{DynamicResource Surface0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.history-chip">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="Border.history-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ComboBox.history-filter">
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.history-button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.history-title-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.history-title-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VS.Primary}" />
    </Style>
    <Style Selector="ListBox#TimelineList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="#TimelineList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="Transparent"
                  Padding="0">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid MaxWidth="2200"
          HorizontalAlignment="Stretch"
          MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="18">
        <StackPanel Spacing="5">
          <TextBlock Text="{infra:LocalizedString Key=History.Title}"
                     FontSize="25"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Summary}"
                     Classes="history-muted"
                     MaxWidth="980" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="action-ghost history-button"
                Content="{infra:LocalizedString Key=Common.Refresh}"
                Command="{CompiledBinding RefreshCommand}"
                VerticalAlignment="Top" />
      </Grid>

      <Border Grid.Row="1"
              Classes="history-panel">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              ColumnSpacing="10">
          <ComboBox Classes="history-filter"
                    ItemsSource="{CompiledBinding DateRangeOptions}"
                    SelectedItem="{CompiledBinding SelectedDateRange, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="1"
                    Classes="history-filter"
                    ItemsSource="{CompiledBinding ActivityFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedActivityFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="2"
                    Classes="history-filter"
                    MinWidth="190"
                    ItemsSource="{CompiledBinding ProjectFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedProjectFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ComboBox Grid.Column="3"
                    Classes="history-filter"
                    ItemsSource="{CompiledBinding LaneFilterOptions}"
                    SelectedItem="{CompiledBinding SelectedLaneFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <WrapPanel Grid.Column="4"
                     ItemSpacing="8"
                     LineSpacing="8"
                     VerticalAlignment="Center">
            <Border Classes="history-chip">
              <TextBlock Text="{CompiledBinding FilterStateLabel}"
                         Classes="history-kicker" />
            </Border>
            <Border Classes="history-chip">
              <TextBlock Text="{CompiledBinding WindowLabel}"
                         Classes="history-kicker" />
            </Border>
          </WrapPanel>

          <Button Grid.Column="5"
                  Classes="history-button"
                  Content="Reset"
                  Command="{CompiledBinding ResetFiltersCommand}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Row="2"
            ColumnDefinitions="1.1*,1*,1*,1*"
            ColumnSpacing="10"
            IsVisible="{CompiledBinding HasLoadedEvents}">
        <Border Classes="history-panel">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#4F8DFF" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding LoadedSummaryLabel}"
                         Classes="history-value" />
              <TextBlock Text="{CompiledBinding FilterStateLabel}"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="1"
                Classes="history-panel">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#FFB454" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding BackupSignalLabel}"
                         Classes="history-value" />
              <TextBlock Text="{infra:LocalizedString Key=History.LaneFilter.Backup}"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="2"
                Classes="history-panel">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#22CC88" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding RestoreSummaryLabel}"
                         Classes="history-value" />
              <TextBlock Text="{infra:LocalizedString Key=History.LaneFilter.Restore}"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Column="3"
                Classes="history-panel">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="7"
                    CornerRadius="4"
                    Background="#8B7CFF" />
            <StackPanel Grid.Column="1"
                        Spacing="3">
              <TextBlock Text="{CompiledBinding MetadataSignalLabel}"
                         Classes="history-value" />
              <TextBlock Text="{infra:LocalizedString Key=History.LaneFilter.Metadata}"
                         Classes="history-kicker" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3"
            ColumnDefinitions="*,380"
            ColumnSpacing="12"
            IsVisible="{CompiledBinding HasLoadedEvents}">
        <Border Classes="history-surface"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0"
                  ColumnDefinitions="104,*,300,138"
                  MinHeight="42"
                  Background="{DynamicResource Surface0}">
              <TextBlock Text="{infra:LocalizedString Key=History.Graph.Lanes}"
                         Classes="history-kicker"
                         VerticalAlignment="Center"
                         Margin="18,0,0,0" />
              <WrapPanel Grid.Column="1"
                         ItemSpacing="12"
                         LineSpacing="6"
                         VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="9" Height="9" CornerRadius="5" Background="#4F8DFF" VerticalAlignment="Center" />
                  <TextBlock Text="{infra:LocalizedString Key=History.Lane.Auto}" Classes="history-kicker" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="9" Height="9" CornerRadius="5" Background="#FFB454" VerticalAlignment="Center" />
                  <TextBlock Text="{infra:LocalizedString Key=History.Lane.Manual}" Classes="history-kicker" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="9" Height="9" CornerRadius="5" Background="#22CC88" VerticalAlignment="Center" />
                  <TextBlock Text="{infra:LocalizedString Key=History.Lane.Restore}" Classes="history-kicker" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="9" Height="9" CornerRadius="5" Background="#8B7CFF" VerticalAlignment="Center" />
                  <TextBlock Text="{infra:LocalizedString Key=History.Lane.Metadata}" Classes="history-kicker" VerticalAlignment="Center" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Grid.Column="2"
                         Text="Impact"
                         Classes="history-kicker"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="3"
                         Text="{CompiledBinding PageLabel}"
                         Classes="history-kicker"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,18,0" />
            </Grid>

            <ListBox x:Name="TimelineList"
                     Grid.Row="1"
                     IsVisible="{CompiledBinding HasTimelineItems}"
                     ItemsSource="{CompiledBinding TimelineItems}"
                     SelectedItem="{CompiledBinding SelectedTimelineItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     Margin="14,0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="history-item">
                    <Grid ColumnDefinitions="104,*,300,138"
                          MinHeight="70">
                      <Canvas Width="104"
                              Height="70"
                              ClipToBounds="False">
                        <Path Data="{Binding BackupGraphPathData}"
                              Stroke="#4F8DFF"
                              StrokeThickness="3.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path Data="{Binding MetadataGraphPathData}"
                              Stroke="#8B7CFF"
                              StrokeThickness="3.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path Data="{Binding RestoreGraphPathData}"
                              Stroke="#22CC88"
                              StrokeThickness="3.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Ellipse Canvas.Left="{Binding NodeLeft}"
                                 Canvas.Top="25"
                                 Width="20"
                                 Height="20"
                                 Fill="{DynamicResource Surface0}"
                                 Stroke="{Binding Accent}"
                                 StrokeThickness="3.5" />
                        <Ellipse Canvas.Left="{Binding InnerNodeLeft}"
                                 Canvas.Top="30"
                                 Width="10"
                                 Height="10"
                                 Fill="{Binding Accent}" />
                      </Canvas>

                      <Grid Grid.Column="1"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="5"
                            VerticalAlignment="Center">
                        <WrapPanel ItemSpacing="8"
                                   LineSpacing="6">
                          <Border Classes="history-chip"
                                  BorderBrush="{Binding Accent}">
                            <TextBlock Text="{Binding Kind}" Classes="history-kicker" />
                          </Border>
                          <Border Classes="history-chip">
                            <TextBlock Text="{Binding Lane}" Classes="history-kicker" />
                          </Border>
                          <Border Classes="history-chip"
                                  IsVisible="{Binding HasMarkerSummary}">
                            <TextBlock Text="{Binding MarkerSummary}" Classes="history-kicker" />
                          </Border>
                        </WrapPanel>

                        <Button Grid.Row="1"
                                Classes="history-title-button"
                                ToolTip.Tip="{Binding HoverDetail}">
                          <TextBlock Text="{Binding Title}"
                                     Classes="history-title"
                                     TextTrimming="CharacterEllipsis" />
                        </Button>
                      </Grid>

                      <WrapPanel Grid.Column="2"
                                 ItemSpacing="10"
                                 LineSpacing="4"
                                 VerticalAlignment="Center"
                                 Margin="12,0">
                        <TextBlock Text="{Binding SizeLabel}" Classes="history-kicker" />
                        <TextBlock Text="{Binding ChangeSummaryLabel}" Classes="history-kicker" />
                        <TextBlock Text="{Binding FileCountLabel}" Classes="history-kicker" />
                      </WrapPanel>

                      <StackPanel Grid.Column="3"
                                  Spacing="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,12,0">
                        <TextBlock Text="{Binding RelativeLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TimeLabel}"
                                   Classes="history-kicker"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1"
                  IsVisible="{CompiledBinding !HasTimelineItems}">
              <Border Classes="history-panel"
                      Width="540"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                <StackPanel Spacing="12">
                  <TextBlock Text="{CompiledBinding EmptyTitle}"
                             FontSize="20"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding EmptyMessage}"
                             Classes="history-muted"
                             TextAlignment="Center" />
                  <Button Content="Reset"
                          Command="{CompiledBinding ResetFiltersCommand}"
                          HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto"
                  MinHeight="54"
                  Margin="14,0"
                  ColumnSpacing="12">
              <Button Content="Previous"
                      Command="{CompiledBinding PreviousPageCommand}"
                      VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Spacing="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding PageLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{CompiledBinding WindowLabel}"
                           Classes="history-kicker"
                           HorizontalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="Next"
                      Command="{CompiledBinding NextPageCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Classes="history-surface"
                Padding="16"
                VerticalAlignment="Stretch">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
              <Border Width="6"
                      CornerRadius="4"
                      Background="{CompiledBinding SelectedEventAccent}" />
              <StackPanel Grid.Column="1"
                          Spacing="4">
                <TextBlock Text="{CompiledBinding SelectedEventKind}"
                           Classes="history-kicker" />
                <TextBlock Text="{CompiledBinding SelectedEventTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="{CompiledBinding SelectedEventDetail}"
                       Classes="history-muted" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="10">
              <StackPanel Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=History.Graph.When}"
                           Classes="history-kicker" />
                <TextBlock Text="{CompiledBinding SelectedEventWhen}"
                           Classes="history-title" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=History.Graph.Lanes}"
                           Classes="history-kicker" />
                <TextBlock Text="{CompiledBinding SelectedEventLane}"
                           Classes="history-title" />
              </StackPanel>
              <StackPanel Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Spacing="2">
                <TextBlock Text="{infra:LocalizedString Key=History.Kpi.Projects}"
                           Classes="history-kicker" />
                <TextBlock Text="{CompiledBinding SelectedEventProject}"
                           Classes="history-title" />
              </StackPanel>
            </Grid>

            <WrapPanel Grid.Row="3"
                       ItemSpacing="8"
                       LineSpacing="8">
              <Border Classes="history-chip"
                      IsVisible="{CompiledBinding SelectedEventHasMarkerSummary}">
                <TextBlock Text="{CompiledBinding SelectedEventMarkerSummary}"
                           Classes="history-kicker" />
              </Border>
              <Border Classes="history-chip"
                      IsVisible="{CompiledBinding SelectedEventHasOriginSummary}">
                <TextBlock Text="{CompiledBinding SelectedEventOriginSummary}"
                           Classes="history-kicker" />
              </Border>
            </WrapPanel>

            <Border Grid.Row="4"
                    Classes="history-panel"
                    Padding="12"
                    VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="{infra:LocalizedString Key=History.Panel.Insight}"
                           Classes="history-kicker" />
                <TextBlock Text="{CompiledBinding Insight}"
                           Classes="history-muted" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="5"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="8">
              <Button Content="{CompiledBinding SelectedProtectedActionLabel}"
                      Command="{CompiledBinding ToggleSelectedProtectedCommand}"
                      Classes="history-button"
                      IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
              <Button Grid.Column="1"
                      Content="{CompiledBinding SelectedKnownGoodActionLabel}"
                      Command="{CompiledBinding ToggleSelectedKnownGoodCommand}"
                      Classes="history-button"
                      IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3"
            IsVisible="{CompiledBinding !HasLoadedEvents}">
        <Border Classes="history-surface"
                Width="620"
                Padding="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
          <StackPanel Spacing="8">
            <TextBlock Text="{CompiledBinding EmptyTitle}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding EmptyMessage}"
                       Classes="history-muted" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
