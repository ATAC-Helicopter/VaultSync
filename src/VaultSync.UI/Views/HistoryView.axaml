<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.history-label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.history-muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.history-pill">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.graph-row">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="Border.graph-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="18">
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="7">
          <TextBlock Text="{infra:LocalizedString Key=History.Title}"
                     FontSize="26"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Summary}"
                     Classes="history-muted"
                     MaxLines="2" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="action-ghost"
                Content="{infra:LocalizedString Key=Common.Refresh}"
                Command="{CompiledBinding RefreshCommand}"
                VerticalAlignment="Top" />
      </Grid>

      <Grid Grid.Row="1"
            ColumnDefinitions="120,*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="6">
          <TextBlock Text="{infra:LocalizedString Key=History.Graph.Lanes}"
                     Classes="history-label" />
          <Grid Height="24">
            <Border Width="2" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Left" Margin="16,0,0,0" />
            <Border Width="2" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Left" Margin="40,0,0,0" />
            <Border Width="2" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Left" Margin="64,0,0,0" />
          </Grid>
        </StackPanel>

        <WrapPanel Grid.Column="1"
                   ItemSpacing="8"
                   LineSpacing="8"
                   VerticalAlignment="Bottom">
          <Border Classes="history-pill">
            <TextBlock Text="{infra:LocalizedString Key=History.Lane.Metadata}" FontSize="10" FontWeight="SemiBold" />
          </Border>
          <Border Classes="history-pill">
            <TextBlock Text="{infra:LocalizedString Key=History.Lane.Backup}" FontSize="10" FontWeight="SemiBold" />
          </Border>
          <Border Classes="history-pill">
            <TextBlock Text="{infra:LocalizedString Key=History.Lane.Restore}" FontSize="10" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>

        <TextBlock Grid.Column="2"
                   Text="{CompiledBinding TotalEventCount}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   VerticalAlignment="Bottom" />
      </Grid>

      <Grid Grid.Row="2">
        <Border Padding="18"
                Background="{DynamicResource Surface1}"
                CornerRadius="8"
                IsVisible="{CompiledBinding !HasTimelineItems}">
          <TextBlock Text="{CompiledBinding EmptyState}"
                     Classes="history-muted" />
        </Border>

        <Grid IsVisible="{CompiledBinding HasTimelineItems}"
              RowDefinitions="Auto,*"
              Background="{DynamicResource Surface1}">
          <Grid Grid.Row="0"
                ColumnDefinitions="120,*,156"
                ColumnSpacing="16"
                Margin="0,0,0,2"
                MinHeight="34">
            <TextBlock Text="{infra:LocalizedString Key=History.Graph.Graph}"
                       Classes="history-label"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
            <TextBlock Grid.Column="1"
                       Text="{infra:LocalizedString Key=History.Graph.Event}"
                       Classes="history-label"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       Text="{infra:LocalizedString Key=History.Graph.When}"
                       Classes="history-label"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,16,0" />
          </Grid>

          <ItemsControl Grid.Row="1"
                        ItemsSource="{CompiledBinding TimelineItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="graph-row">
                  <Grid ColumnDefinitions="120,*,156"
                        ColumnSpacing="16">
                    <Grid Width="120"
                          MinHeight="72">
                      <Border Width="2"
                              Background="{DynamicResource DividerBrush}"
                              HorizontalAlignment="Left"
                              Margin="16,0,0,0" />
                      <Border Width="2"
                              Background="{DynamicResource DividerBrush}"
                              HorizontalAlignment="Left"
                              Margin="40,0,0,0" />
                      <Border Width="2"
                              Background="{DynamicResource DividerBrush}"
                              HorizontalAlignment="Left"
                              Margin="64,0,0,0" />
                      <Border Height="2"
                              Width="34"
                              Background="{Binding Accent}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="{Binding ConnectorMargin}" />
                      <Ellipse Width="14"
                               Height="14"
                               Fill="{Binding Accent}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="{Binding NodeMargin}" />
                    </Grid>

                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="5"
                          VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kind}"
                                   Classes="history-label"
                                   VerticalAlignment="Center" />
                      </Grid>

                      <TextBlock Grid.Row="1"
                                 Text="{Binding Detail}"
                                 Classes="history-muted"
                                 MaxLines="2" />

                      <WrapPanel Grid.Row="2"
                                 ItemSpacing="8"
                                 LineSpacing="6">
                        <TextBlock Text="{Binding ProjectName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Lane}"
                                   Classes="history-label" />
                        <TextBlock Text="{Binding MarkerSummary}"
                                   Classes="history-label"
                                   IsVisible="{Binding HasMarkerSummary}" />
                      </WrapPanel>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,16,0">
                      <TextBlock Text="{Binding RelativeLabel}"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding TimeLabel}"
                                 Classes="history-label"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
