<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.history-eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.history-copy">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.history-heading">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.history-number">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.history-glass">
      <Setter Property="Background" Value="#62101A28" />
      <Setter Property="BorderBrush" Value="#273C55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.history-paper">
      <Setter Property="Background" Value="#8A0A111C" />
      <Setter Property="BorderBrush" Value="#20344C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.history-chip">
      <Setter Property="Background" Value="#80132133" />
      <Setter Property="BorderBrush" Value="#2B496B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="ComboBox.history-filter">
      <Setter Property="MinWidth" Value="146" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Background" Value="#80101A28" />
      <Setter Property="BorderBrush" Value="#2B496B" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.history-button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBox.history-editor">
      <Setter Property="Background" Value="#6B0A1422" />
      <Setter Property="BorderBrush" Value="#27445F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.history-event-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.history-event-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VS.Primary}" />
    </Style>
    <Style Selector="ListBox#TimelineList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="#TimelineList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="Transparent"
                  Padding="0">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
          RowDefinitions="Auto,*">

      <Border Grid.Row="0"
              BorderBrush="#1C3148"
              BorderThickness="0,0,0,1"
              Padding="30,26,30,22">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#101C2A" Offset="0" />
            <GradientStop Color="#0B111A" Offset="0.55" />
            <GradientStop Color="#15111E" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="18">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="22">
            <StackPanel Spacing="8">
              <TextBlock Text="{infra:LocalizedString Key=History.Title}"
                         FontSize="30"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding Summary}"
                         Classes="history-copy"
                         MaxWidth="980" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="action-ghost history-button"
                    Content="{infra:LocalizedString Key=Common.Refresh}"
                    Command="{CompiledBinding RefreshCommand}"
                    VerticalAlignment="Top" />
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">
            <WrapPanel ItemSpacing="8"
                       LineSpacing="8">
              <ComboBox Classes="history-filter"
                        ItemsSource="{CompiledBinding DateRangeOptions}"
                        SelectedItem="{CompiledBinding SelectedDateRange, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox Classes="history-filter"
                        ItemsSource="{CompiledBinding ActivityFilterOptions}"
                        SelectedItem="{CompiledBinding SelectedActivityFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox Classes="history-filter"
                        MinWidth="190"
                        ItemsSource="{CompiledBinding ProjectFilterOptions}"
                        SelectedItem="{CompiledBinding SelectedProjectFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox Classes="history-filter"
                        ItemsSource="{CompiledBinding LaneFilterOptions}"
                        SelectedItem="{CompiledBinding SelectedLaneFilter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Border Classes="history-chip">
                <TextBlock Text="{CompiledBinding FilterStateLabel}"
                           Classes="history-eyebrow" />
              </Border>
              <Border Classes="history-chip">
                <TextBlock Text="{CompiledBinding WindowLabel}"
                           Classes="history-eyebrow" />
              </Border>
            </WrapPanel>

            <Button Grid.Column="1"
                    Classes="history-button"
                    Content="Reset"
                    Command="{CompiledBinding ResetFiltersCommand}"
                    VerticalAlignment="Top" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="30,22,30,30"
              IsVisible="{CompiledBinding HasLoadedEvents}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="18">
          <Border Classes="history-glass"
                Padding="20">
          <Grid ColumnDefinitions="2*,*,*,*"
                ColumnSpacing="18">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">
              <Border Width="8"
                      CornerRadius="5"
                      Background="{CompiledBinding SelectedEventAccent}" />
              <StackPanel Grid.Column="1"
                          Spacing="8">
                <WrapPanel ItemSpacing="8"
                           LineSpacing="8">
                  <Border Classes="history-chip"
                          BorderBrush="{CompiledBinding SelectedEventAccent}">
                    <TextBlock Text="{CompiledBinding SelectedEventKind}"
                               Classes="history-eyebrow" />
                  </Border>
                  <Border Classes="history-chip">
                    <TextBlock Text="{CompiledBinding SelectedEventLane}"
                               Classes="history-eyebrow" />
                  </Border>
                  <Border Classes="history-chip"
                          IsVisible="{CompiledBinding SelectedEventHasMarkerSummary}">
                    <TextBlock Text="{CompiledBinding SelectedEventMarkerSummary}"
                               Classes="history-eyebrow" />
                  </Border>
                </WrapPanel>
                <TextBlock Text="{CompiledBinding SelectedEventTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{CompiledBinding SelectedEventDetail}"
                           Classes="history-copy"
                           MaxWidth="900" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1"
                        Spacing="5"
                        VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding SelectedEventWhen}"
                         Classes="history-number" />
              <TextBlock Text="{CompiledBinding SelectedEventProject}"
                         Classes="history-eyebrow" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Spacing="5"
                        VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding SelectedEventSize}"
                         Classes="history-number" />
              <TextBlock Text="{CompiledBinding SelectedEventFiles}"
                         Classes="history-eyebrow" />
            </StackPanel>
            <StackPanel Grid.Column="3"
                        Spacing="5"
                        VerticalAlignment="Center">
              <TextBlock Text="{CompiledBinding SelectedEventChangeSummary}"
                         Classes="history-number" />
              <TextBlock Text="{CompiledBinding SelectedEventOriginSummary}"
                         Classes="history-eyebrow"
                         IsVisible="{CompiledBinding SelectedEventHasOriginSummary}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,320"
              ColumnSpacing="22">
          <Border Classes="history-paper"
                  ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Grid.Row="0"
                    ColumnDefinitions="96,*,190"
                    MinHeight="46"
                    Background="#52070D15">
                <WrapPanel Grid.Column="1"
                           ItemSpacing="14"
                           LineSpacing="6"
                           VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#4F8DFF" VerticalAlignment="Center" />
                    <TextBlock Text="{infra:LocalizedString Key=History.Lane.Auto}" Classes="history-eyebrow" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#FFB454" VerticalAlignment="Center" />
                    <TextBlock Text="{infra:LocalizedString Key=History.Lane.Manual}" Classes="history-eyebrow" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#22CC88" VerticalAlignment="Center" />
                    <TextBlock Text="{infra:LocalizedString Key=History.Lane.Restore}" Classes="history-eyebrow" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="10" Height="10" CornerRadius="5" Background="#8B7CFF" VerticalAlignment="Center" />
                    <TextBlock Text="{infra:LocalizedString Key=History.Lane.Metadata}" Classes="history-eyebrow" VerticalAlignment="Center" />
                  </StackPanel>
                </WrapPanel>
                <TextBlock Grid.Column="2"
                           Text="{CompiledBinding PageLabel}"
                           Classes="history-eyebrow"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />
              </Grid>

              <ListBox x:Name="TimelineList"
                       Grid.Row="1"
                       IsVisible="{CompiledBinding HasTimelineItems}"
                       ItemsSource="{CompiledBinding TimelineItems}"
                       SelectedItem="{CompiledBinding SelectedTimelineItem, Mode=TwoWay}"
                       SelectionMode="Single"
                       Margin="16,0"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="96,*,170"
                          MinHeight="78">
                      <Canvas Width="96"
                              Height="78"
                              ClipToBounds="False">
                        <Path Data="{Binding BackupGraphPathData}"
                              Stroke="#4F8DFF"
                              StrokeThickness="4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path Data="{Binding MetadataGraphPathData}"
                              Stroke="#8B7CFF"
                              StrokeThickness="4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path Data="{Binding RestoreGraphPathData}"
                              Stroke="#22CC88"
                              StrokeThickness="4"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Ellipse Canvas.Left="{Binding NodeLeft}"
                                 Canvas.Top="27"
                                 Width="24"
                                 Height="24"
                                 Fill="#0A111B"
                                 Stroke="{Binding Accent}"
                                 StrokeThickness="4" />
                        <Ellipse Canvas.Left="{Binding InnerNodeLeft}"
                                 Canvas.Top="33"
                                 Width="12"
                                 Height="12"
                                 Fill="{Binding Accent}" />
                      </Canvas>

                      <Grid Grid.Column="1"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="5"
                            VerticalAlignment="Center">
                        <WrapPanel ItemSpacing="8"
                                   LineSpacing="6">
                          <Border Classes="history-chip"
                                  BorderBrush="{Binding Accent}">
                            <TextBlock Text="{Binding Kind}" Classes="history-eyebrow" />
                          </Border>
                          <Border Classes="history-chip">
                            <TextBlock Text="{Binding Lane}" Classes="history-eyebrow" />
                          </Border>
                          <Border Classes="history-chip"
                                  IsVisible="{Binding HasMarkerSummary}">
                            <TextBlock Text="{Binding MarkerSummary}" Classes="history-eyebrow" />
                          </Border>
                        </WrapPanel>

                        <Button Grid.Row="1"
                                Classes="history-event-button"
                                ToolTip.Tip="{Binding HoverDetail}">
                          <TextBlock Text="{Binding Title}"
                                     Classes="history-heading"
                                     TextTrimming="CharacterEllipsis" />
                        </Button>

                        <WrapPanel Grid.Row="2"
                                   ItemSpacing="10"
                                   LineSpacing="4">
                          <TextBlock Text="{Binding SizeLabel}" Classes="history-eyebrow" />
                          <TextBlock Text="{Binding ChangeSummaryLabel}" Classes="history-eyebrow" />
                          <TextBlock Text="{Binding FileCountLabel}" Classes="history-eyebrow" />
                        </WrapPanel>
                      </Grid>

                      <StackPanel Grid.Column="2"
                                  Spacing="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,12,0">
                        <TextBlock Text="{Binding RelativeLabel}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TimeLabel}"
                                   Classes="history-eyebrow"
                                   HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Grid Grid.Row="1"
                    IsVisible="{CompiledBinding !HasTimelineItems}">
                <Border Classes="history-glass"
                        Width="560"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{CompiledBinding EmptyTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{CompiledBinding EmptyMessage}"
                               Classes="history-copy"
                               TextAlignment="Center" />
                    <Button Content="Reset"
                            Command="{CompiledBinding ResetFiltersCommand}"
                            HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="2"
                    ColumnDefinitions="Auto,*,Auto"
                    MinHeight="56"
                    Margin="18,0"
                    ColumnSpacing="12">
                <Button Content="Previous"
                        Command="{CompiledBinding PreviousPageCommand}"
                        VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            Spacing="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <TextBlock Text="{CompiledBinding PageLabel}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding WindowLabel}"
                             Classes="history-eyebrow"
                             HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Next"
                        Command="{CompiledBinding NextPageCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="14">
            <Border Classes="history-glass"
                    Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{infra:LocalizedString Key=History.Panel.Insight}"
                           Classes="history-eyebrow" />
                <TextBlock Text="{CompiledBinding Insight}"
                           Classes="history-copy" />
              </StackPanel>
            </Border>

            <Border Classes="history-glass"
                    Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="{infra:LocalizedString Key=History.Panel.TotalEvents}"
                           Classes="history-eyebrow" />
                <TextBlock Text="{CompiledBinding LoadedSummaryLabel}"
                           Classes="history-number" />
                <TextBlock Text="{CompiledBinding BackupSignalLabel}"
                           Classes="history-copy" />
                <TextBlock Text="{CompiledBinding RestoreSummaryLabel}"
                           Classes="history-copy" />
                <TextBlock Text="{CompiledBinding MetadataSignalLabel}"
                           Classes="history-copy" />
              </StackPanel>
            </Border>

            <Border Classes="history-glass"
                    Padding="16">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10">
                <TextBlock Text="{infra:LocalizedString Key=History.Panel.Next}"
                           Classes="history-eyebrow" />
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                  <Button Content="{CompiledBinding SelectedProtectedActionLabel}"
                          Command="{CompiledBinding ToggleSelectedProtectedCommand}"
                          Classes="history-button"
                          IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                  <Button Grid.Column="1"
                          Content="{CompiledBinding SelectedKnownGoodActionLabel}"
                          Command="{CompiledBinding ToggleSelectedKnownGoodCommand}"
                          Classes="history-button"
                          IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                </Grid>
                <StackPanel Grid.Row="2"
                            Spacing="8">
                  <TextBox Text="{CompiledBinding SelectedSnapshotLabelDraft, Mode=TwoWay}"
                           Watermark="Snapshot label"
                           Classes="history-editor"
                           IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                  <TextBox Text="{CompiledBinding SelectedSnapshotTagsDraft, Mode=TwoWay}"
                           Watermark="Tags, comma separated"
                           Classes="history-editor"
                           IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                  <TextBox Text="{CompiledBinding SelectedSnapshotNoteDraft, Mode=TwoWay}"
                           Watermark="Notes"
                           Classes="history-editor"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="76"
                           IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                  <Grid ColumnDefinitions="*,*"
                        ColumnSpacing="8">
                    <Button Content="Save notes"
                            Command="{CompiledBinding SaveSelectedSnapshotMetadataCommand}"
                            Classes="history-button"
                            IsEnabled="{CompiledBinding CanEditSelectedSnapshotMetadata}" />
                    <Button Grid.Column="1"
                            Content="Clear"
                            Command="{CompiledBinding ClearSelectedSnapshotMetadataCommand}"
                            Classes="history-button"
                            IsEnabled="{CompiledBinding HasSelectedSnapshotTextMetadata}" />
                  </Grid>
                </StackPanel>
                <TextBlock Grid.Row="3"
                           Text="{CompiledBinding SelectedEventOriginSummary}"
                           Classes="history-copy"
                           IsVisible="{CompiledBinding SelectedEventHasOriginSummary}" />
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="30"
              IsVisible="{CompiledBinding !HasLoadedEvents}">
        <Grid>
        <Border Classes="history-glass"
                Width="680"
                Padding="34"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Text="{CompiledBinding EmptyTitle}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding EmptyMessage}"
                       Classes="history-copy" />
          </StackPanel>
        </Border>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
