<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    Background="{DynamicResource VS.WindowBackground}">

  <UserControl.Styles>
    <Style Selector="TextBlock.history-label">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.history-muted">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.history-panel">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.history-signal">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinWidth" Value="190" />
    </Style>
    <Style Selector="Border.history-kind">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.history-event">
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="86" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.history-event:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="{DynamicResource PagePadding}">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Spacing="7">
          <TextBlock Text="{infra:LocalizedString Key=History.Title}"
                     FontSize="26"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Summary}"
                     Classes="history-muted"
                     MaxLines="2" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="action-ghost"
                Content="{infra:LocalizedString Key=Common.Refresh}"
                Command="{CompiledBinding RefreshCommand}"
                VerticalAlignment="Top" />
      </Grid>

      <WrapPanel ItemSpacing="10"
                 LineSpacing="10">
        <Border Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="4"
                    CornerRadius="2"
                    Background="#4F8DFF" />
            <StackPanel Grid.Column="1"
                        Spacing="4">
              <TextBlock Text="{CompiledBinding BackupCount}"
                         FontSize="22"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding BackupSignalLabel}"
                         Classes="history-label"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="4"
                    CornerRadius="2"
                    Background="#8B7CFF" />
            <StackPanel Grid.Column="1"
                        Spacing="4">
              <TextBlock Text="{CompiledBinding SnapshotOnlyCount}"
                         FontSize="22"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding MetadataSignalLabel}"
                         Classes="history-label"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="history-signal">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
            <Border Width="4"
                    CornerRadius="2"
                    Background="#22CC88" />
            <StackPanel Grid.Column="1"
                        Spacing="4">
              <TextBlock Text="{CompiledBinding ProjectCount}"
                         FontSize="22"
                         FontWeight="SemiBold" />
              <TextBlock Text="{CompiledBinding ProjectSignalLabel}"
                         Classes="history-label"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </WrapPanel>

      <Grid ColumnDefinitions="*,320"
            ColumnSpacing="16">
        <Border Classes="history-panel">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="14">
            <Border Width="5"
                    CornerRadius="3"
                    Background="{DynamicResource VS.Primary}" />
            <StackPanel Grid.Column="1"
                        Spacing="8">
              <TextBlock Text="{CompiledBinding LatestEventLabel}"
                         Classes="history-label" />
              <TextBlock Text="{CompiledBinding LatestEventTitle}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{CompiledBinding LatestEventDetail}"
                         Classes="history-muted"
                         MaxLines="3" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Classes="history-panel">
          <StackPanel Spacing="8">
            <TextBlock Text="{CompiledBinding TotalEventCount}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding Insight}"
                       Classes="history-muted"
                       MaxLines="4" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="history-panel"
              IsVisible="{CompiledBinding !HasTimelineItems}">
        <TextBlock Text="{CompiledBinding EmptyState}"
                   Classes="history-muted" />
      </Border>

      <ItemsControl ItemsSource="{CompiledBinding TimelineItems}"
                    IsVisible="{CompiledBinding HasTimelineItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="history-event">
              <Grid ColumnDefinitions="6,*,150"
                    ColumnSpacing="14">
                <Border Background="{Binding Accent}"
                        CornerRadius="8,0,0,8" />

                <StackPanel Grid.Column="1"
                            Spacing="8"
                            Margin="0,14,0,14">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding ProjectName}"
                                 Classes="history-label" />
                      <TextBlock Text="{Binding Title}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 MaxLines="2" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Classes="history-kind"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Kind}"
                                 Classes="history-label" />
                    </Border>
                  </Grid>

                  <TextBlock Text="{Binding Detail}"
                             Classes="history-muted"
                             MaxLines="2" />

                  <WrapPanel ItemSpacing="8"
                             LineSpacing="6">
                    <TextBlock Text="{Binding Lane}"
                               Classes="history-label" />
                    <TextBlock Text="{Binding MarkerSummary}"
                               Classes="history-label"
                               IsVisible="{Binding HasMarkerSummary}" />
                  </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Spacing="4"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,16,0">
                  <TextBlock Text="{Binding RelativeLabel}"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding TimeLabel}"
                             Classes="history-label"
                             HorizontalAlignment="Right"
                             TextWrapping="Wrap"
                             TextAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
