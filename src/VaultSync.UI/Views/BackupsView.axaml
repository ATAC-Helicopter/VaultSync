<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI.ViewModels"
             x:Class="VaultSync.UI.Views.BackupsView"
             x:DataType="vm:BackupsViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Remove OS-style blue selection highlight for list boxes in this view -->
    <Style Selector="ListBox > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Per-project backups list: card container + selected tint -->
    <Style Selector="#PerProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,6,0,6"
                  CornerRadius="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="16">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="#PerProjectList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Global backup history list: card container + selected tint -->
    <Style Selector="#HistoryList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,5,0,5"
                  CornerRadius="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="12">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="#HistoryList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Tag pill style for snapshot type/status -->
    <Style Selector="Border.backup-tag">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small icon circle (for per-project list) -->
    <Style Selector="Border.project-icon-circle">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24"
                  Spacing="16">

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="12">
          <StackPanel>
            <TextBlock Text="Backups"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="View snapshot history and per-project backup status."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      Margin="16,0,0,0">
            <Button Content="Back up all projects"
                    HorizontalAlignment="Left"
                    Classes="primary-button"
                    Command="{Binding CreateBackupCommand}"/>
          </StackPanel>
        </StackPanel>

        <!-- SUMMARY CARDS -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="12">

          <!-- Total snapshots -->
          <Border Classes="card"
                  Padding="16">
            <StackPanel>
              <TextBlock Text="Snapshots"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding TotalSnapshots}"
                         FontSize="22"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding SnapshotsSummaryLine}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <!-- Last backup -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="1">
            <StackPanel>
              <TextBlock Text="Last backup"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding LastBackupDisplay}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding LastBackupRelative}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>

          <!-- Total backup size -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="2">
            <StackPanel>
              <TextBlock Text="Total stored"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding TotalBackupSizeFormatted}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding SnapshotActivitySummary}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- MAIN AREA: per-project (left) + history (right) -->
        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Stretch">

          <!-- PER-PROJECT BACKUPS -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="18"
                  MinWidth="360"
                  MaxWidth="520"
                  Margin="0,0,18,0">

            <StackPanel Spacing="10">

              <!-- Section header -->
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="Per-project backups"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Back up single projects and check their status."
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>

              <!-- Per-project list -->
              <ListBox x:Name="PerProjectList"
                       ItemsSource="{Binding ProjectBackups}"
                       SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                       SelectionMode="Single"
                       BorderThickness="0"
                       Margin="0,6,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <!-- 3-row layout: name/buttons, last backup, stats -->
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="6"
                          ColumnSpacing="12">

                      <!-- Icon column -->
                      <Border Grid.RowSpan="3"
                              Grid.Column="0"
                              Classes="project-icon-circle">
                        <TextBlock Text="{Binding Name[0]}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>

                      <!-- Row 0: name + buttons -->
                      <TextBlock Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding Name}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />

                      <StackPanel Grid.Row="0"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="10"
                                  HorizontalAlignment="Right">
                        <Button Content="Back up"
                                Classes="small-button"
                                Command="{Binding DataContext.BackupProjectCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="History"
                                Classes="small-button"
                                Command="{Binding DataContext.ShowProjectHistoryCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>

                      <!-- Row 1: last backup -->
                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="Last backup:"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastBackupDisplay}"
                                   FontSize="11" />
                      </StackPanel>

                      <!-- Row 2: stats -->
                      <StackPanel Grid.Row="2"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="10">
                        <TextBlock Text="{Binding SnapshotCount}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="snapshots"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="•"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="{Binding TotalSizeFormatted}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="stored"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>

                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </StackPanel>
          </Border>

          <!-- GLOBAL HISTORY + MINI-CHART -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="18"
                  MinWidth="360"
                  Margin="0">

            <StackPanel Spacing="10">

              <!-- History header + filters -->
              <Grid ColumnDefinitions="*,Auto"
                    Margin="0,0,0,4">

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Snapshot history"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding HistoryFilterProjectLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Type filter buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right">
                  <Button Content="All"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="All" />
                  <Button Content="Auto"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="Auto" />
                  <Button Content="Manual"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="Manual" />
                </StackPanel>
              </Grid>

              <!-- History list -->
              <ListBox x:Name="HistoryList"
                       ItemsSource="{Binding Snapshots}"
                       BorderThickness="0"
                       Margin="0,6,0,0"
                       MaxHeight="260"
                       SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="4">

                        <!-- Left: description + time -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="6">
                          <TextBlock Text="{Binding Label}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />

                          <Border Classes="backup-tag"
                                  Background="{Binding TagBackground}">
                            <TextBlock Text="{Binding Type}"
                                       FontSize="11" />
                          </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="6">
                          <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Right: size + status + actions -->
                        <StackPanel Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                          <TextBlock Text="{Binding SizeFormatted}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Right" />

                          <StackPanel Orientation="Horizontal"
                                      HorizontalAlignment="Right"
                                      Spacing="6">
                            <Button Content="Restore"
                                    Classes="small-button"
                                    Command="{Binding DataContext.RestoreBackupCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Delete"
                                    Classes="small-button"
                                    Command="{Binding DataContext.DeleteBackupCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </StackPanel>

                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Weekly mini-activity chart -->
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="Last 7 days"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Spacing="4"
                            Margin="0,4,0,0">
                  <ItemsControl ItemsSource="{Binding SnapshotActivity}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Spacing="2">
                          <Border Width="8"
                                  Height="{Binding BarHeight}"
                                  Background="{Binding BarBrush}"
                                  CornerRadius="4" />
                          <TextBlock Text="{Binding DayLabel}"
                                     FontSize="10"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </Border>

        </WrapPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Busy overlay -->
    <Border Background="#80000080"
            IsVisible="{Binding IsBusy}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <!-- Status / title -->
        <TextBlock Text="{Binding BusyMessage}"
                   FontSize="13"
                   Foreground="White"
                   HorizontalAlignment="Center" />

        <!-- Determinate progress bar -->
        <ProgressBar Width="260"
                     Maximum="100"
                     Value="{Binding BackupProgress}" />

        <!-- Current file -->
        <TextBlock Text="{Binding BackupCurrentFile}"
                   FontSize="11"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="340" />

        <!-- ETA -->
        <TextBlock Text="{Binding BackupEtaText}"
                   FontSize="11"
                   Foreground="White"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>