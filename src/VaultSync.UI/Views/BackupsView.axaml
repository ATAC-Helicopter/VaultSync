<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI.ViewModels"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             xmlns:viewsControls="clr-namespace:VaultSync.UI.Views.Controls"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             x:Class="VaultSync.UI.Views.BackupsView"
             x:DataType="vm:BackupsViewModel"
             x:CompileBindings="False">

  <UserControl.Resources>
    <controls:StatusToBrushConverter x:Key="StatusToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="#PerProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="{DynamicResource ListItemMarginTight}"
                  Background="Transparent"
                  Padding="0">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Preset dropdown: pill style (match Projects view) -->
    <Style Selector="ComboBox.preset-combo">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="240" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBox">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Padding" Value="6" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardRaisedBackgroundBrush}" />
    </Style>

    <Style Selector="ComboBox.preset-combo /template/ Popup ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>



    <Style Selector="Border.project-icon-circle">
      <Setter Property="Width" Value="{DynamicResource ProjectIconSize}" />
      <Setter Property="Height" Value="{DynamicResource ProjectIconSize}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ProjectIconRadius}" />
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="{DynamicResource ProjectIconMargin}" />
    </Style>

    <Style Selector="Border.pulse-ring">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Expander.backup-group">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Expander">
          <Border CornerRadius="18"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <StackPanel Margin="{TemplateBinding Padding}">
              <ToggleButton x:Name="PART_Header"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Focusable="False"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  HorizontalAlignment="Stretch" />
              </ToggleButton>
              <ContentPresenter x:Name="PART_ContentHost"
                                Margin="0,8,0,0"
                                Content="{TemplateBinding Content}"
                                IsVisible="{TemplateBinding IsExpanded}" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Expander.backup-group ToggleButton#PART_Header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter
              Content="{TemplateBinding Content}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Margin="0" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Smooth expand/collapse -->
    <Style Selector="Expander.backup-group /template/ ContentPresenter#PART_ContentHost">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Expander.backup-group:expanded /template/ ContentPresenter#PART_ContentHost">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Expander.backup-group TextBlock.chevron">
      <Setter Property="Text" Value="›" />
    </Style>
    <Style Selector="Expander.backup-group:expanded TextBlock.chevron">
      <Setter Property="Text" Value="‹›" />
    </Style>

    <!-- Per-project cards -->
    <Style Selector="Border.project-card">
      <Setter Property="Background" Value="{DynamicResource Surface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>


    <Style Selector="Border.summary-stat">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="{DynamicResource SummaryStatPadding}" />
    </Style>

    <!-- Active backup cards -->
    <Style Selector="Border.active-backup-card">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Small buttons -->
    <Style Selector="Button.small-button">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="{DynamicResource SmallButtonPadding}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.small-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
    <Style Selector="Button.small-button:pressed">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Per-project primary action -->

  </UserControl.Styles>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  BringIntoViewOnFocusChange="False">
      <!-- Stretch to the full available width with a soft cap for readability. -->
      <Grid MaxWidth="2200"
            HorizontalAlignment="Stretch"
            MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <StackPanel Margin="{DynamicResource PageStackMargin}"
                    Spacing="{DynamicResource PageRowSpacing}"
                    HorizontalAlignment="Stretch">

        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              VerticalAlignment="Center">
          <StackPanel Grid.Column="0">
            <TextBlock Text="{infra:LocalizedString Key=Backups.Page.Title}"
                       FontSize="{DynamicResource PageTitleFontSize}"
                       FontWeight="SemiBold" />
            <TextBlock Text="{infra:LocalizedString Key=Backups.Page.Description}"
                       FontSize="{DynamicResource PageSubtitleFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,6,0,0">
            <Button x:Name="BackupAllButton"
                    Content="{infra:LocalizedString Key=Backups.Action.BackupAll}"
                    Classes="action-primary"
                    Padding="{DynamicResource ButtonPillPadding}"
                    CornerRadius="999"
                    Command="{Binding CreateBackupCommand}"/>
          </StackPanel>
        </Grid>

        <!-- NOTIFICATION BANNER -->
        <controls:NotificationCard DataContext="{Binding Notification}" />


        <!-- SUMMARY -->
        <Grid ColumnDefinitions="*,*,*"
                ColumnSpacing="16">

            <!-- Total snapshots -->
            <Border Classes="card"
                    Padding="{DynamicResource CardPaddingMedium}"
                    VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.Total}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding TotalSnapshots}"
                           FontSize="{DynamicResource PageTitleFontSize}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="10">
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.TodayLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SnapshotsToday}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.ThisWeekLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SnapshotsThisWeek}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.YesterdayLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SnapshotsYesterday}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAuto}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding AutoSnapshotsThisWeek}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="2" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterManual}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ManualSnapshotsThisWeek}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="2" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Snapshot.Type.Imported}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ImportedSnapshotsCount}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                </Grid>
                <StackPanel Spacing="6"
                            Margin="0,2,0,0">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.ThisWeekMixLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="8"
                        RowSpacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAuto}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ThisWeekAutoPercent}"
                                 Height="6"
                                 Foreground="#3A7AFE"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="1"
                               Text="{infra:LocalizedString Key=Backups.Section.FilterManual}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ThisWeekManualPercent}"
                                 Height="6"
                                 Foreground="#22CC88"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="2"
                               Text="{infra:LocalizedString Key=Backups.Snapshot.Type.Imported}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="2"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ThisWeekImportedPercent}"
                                 Height="6"
                                 Foreground="#FFB84C"
                                 Background="{DynamicResource Surface2}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Last backup -->
            <Border Classes="card"
                    Padding="{DynamicResource CardPaddingMedium}"
                    Grid.Column="1"
                    VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.Last}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding LastBackupDisplay}"
                           FontSize="{DynamicResource SectionHeaderFontSize}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="10">
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.AgeLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LastBackupRelative}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.SizeLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LastBackupSizeValueFormatted}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.TotalLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding TotalSnapshots}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.ThisWeekLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding SnapshotsThisWeek}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                </Grid>
                <StackPanel Spacing="4"
                            Margin="0,2,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.FreshnessLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastBackupFreshnessLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding LastBackupFreshnessBrush}"
                               ToolTip.Tip="{Binding LastBackupFreshnessTooltip}" />
                  </Grid>
                  <ProgressBar Minimum="0"
                               Maximum="100"
                               Value="{Binding LastBackupFreshnessPercent}"
                               Height="8"
                               CornerRadius="4"
                               Foreground="{Binding LastBackupFreshnessBrush}"
                               ToolTip.Tip="{Binding LastBackupFreshnessTooltip}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Total backup size -->
            <Border Classes="card"
                    Padding="16"
                    Grid.Column="2"
                    VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.TotalStored}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding TotalBackupSizeFormatted}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="10">
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.LocalLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding TotalStoredLocalValueFormatted}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="0" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.ImportedLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding TotalStoredImportedValueFormatted}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.LocalBackupsLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LocalSnapshotsCount}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                  <Border Classes="summary-stat" Grid.Row="1" Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.ImportedBackupsLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ImportedSnapshotsCount}"
                                 FontSize="14"
                                 FontWeight="SemiBold" />
                    </Grid>
                  </Border>
                </Grid>
                <StackPanel Spacing="6"
                            Margin="0,2,0,0">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.StorageMixLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        RowSpacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.LocalLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding StorageLocalPercent}"
                                 Height="6"
                                 Foreground="#3A7AFE"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="1"
                               Text="{infra:LocalizedString Key=Backups.Summary.ImportedLabel}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding StorageImportedPercent}"
                                 Height="6"
                                 Foreground="#FFB84C"
                                 Background="{DynamicResource Surface2}" />
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="6"
                            Margin="0,4,0,0">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.TopConsumersLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Summary.TopConsumersEmpty}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}"
                             IsVisible="{Binding HasTopStorageConsumers, Converter={StaticResource BoolInvertConverter}}" />
                  <ItemsControl ItemsSource="{Binding TopStorageConsumers}"
                                IsVisible="{Binding HasTopStorageConsumers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                          <TextBlock Text="{Binding ProjectName}"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="190"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                          <StackPanel Grid.Column="1"
                                      Orientation="Horizontal"
                                      Spacing="8"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalSize}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SharePercentLabel}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6"
                            Margin="0,4,0,0">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Health.Center.Title}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding BackupHealthSummaryLine}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" />
                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="8"
                        RowSpacing="4">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Health.Center.Healthy}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding HealthHealthyPercent}"
                                 Height="5"
                                 Foreground="#22CC88"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="1"
                               Text="{infra:LocalizedString Key=Backups.Health.Center.Aging}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding HealthAgingPercent}"
                                 Height="5"
                                 Foreground="#FFB84C"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="2"
                               Text="{infra:LocalizedString Key=Backups.Health.Center.Stale}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="2"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding HealthStalePercent}"
                                 Height="5"
                                 Foreground="#F56A5A"
                                 Background="{DynamicResource Surface2}" />

                    <TextBlock Grid.Row="3"
                               Text="{infra:LocalizedString Key=Backups.Health.Center.NoBackup}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar Grid.Row="3"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding HealthNoBackupPercent}"
                                 Height="5"
                                 Foreground="#7F8FA8"
                                 Background="{DynamicResource Surface2}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
        </Grid>

        <!-- MINI BACKUP STORAGE CARD (Backups page) -->
        <Border Classes="card"
                Padding="{DynamicResource CardPaddingMedium}">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Backups.Section.StorageLabel}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding BackupDiskDriveLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Used percent + free/total summary -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding BackupDiskUsedPercent, StringFormat='{}{0:0}% used'}"
                         FontSize="{DynamicResource SectionHeaderFontSize}"
                         FontWeight="SemiBold" />
              <TextBlock Text="·"
                         Margin="4,0"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding BackupDiskFreeText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Usage bar -->
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding BackupDiskUsedPercent}"
                         Height="4"
                         CornerRadius="2" />

            <!-- Threshold / warning info -->
            <TextBlock Text="{Binding BackupDiskThresholdText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBlock Text="{infra:LocalizedString Key=Backups.Section.Warning}"
                       FontSize="11"
                       Foreground="{DynamicResource DangerBrush}"
                       IsVisible="{Binding BackupDiskIsBelowThreshold}" />

            <!-- SMART / drive health -->
            <TextBlock Text="{Binding BackupDiskHealthText}"
                       FontSize="11"
                       Foreground="{Binding BackupDiskHealthBrush}"
                       IsVisible="{Binding BackupDiskHealthVisible}" />
          </StackPanel>
        </Border>

        <!-- RUNNING BACKUPS CARD (inline, below summary cards) -->
        <Expander Classes="backup-group"
                  IsExpanded="True"
                  IsVisible="{Binding IsBusy}">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Backups.Section.Active}"
                           FontSize="14"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveBackups.Count, StringFormat=' · {0} active'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Classes="chevron"
                           Margin="8,0,0,0"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Expander.Header>

          <Border Margin="0,6,0,0"
                  Padding="0,8,0,0"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <ItemsControl x:Name="ActiveBackupsList" ItemsSource="{Binding ActiveBackups}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                               ItemWidth="380" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,4,12,4"
                              Padding="12"
                              Classes="active-backup-card"
                              HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="4,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="6"
                              HorizontalAlignment="Stretch">
                          <Border Grid.RowSpan="3"
                                  Grid.Column="0"
                                  Width="4"
                                  CornerRadius="2"
                                  Background="{Binding StageBrush}"
                                  Opacity="0.8" />
                          <StackPanel Grid.Row="0"
                                      Grid.Column="1"
                                      Spacing="2"
                                      HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding ProjectName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                            <TextBlock Text="{Binding DestinationDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"
                                       IsVisible="{Binding HasDestinationDisplay}" />
                            <Border Classes="stat-pill sm info"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding HasPolicyText}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="pill-icon" Text="⚑" />
                                <TextBlock Text="{Binding PolicyText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="220"
                                           ToolTip.Tip="{Binding PolicyText}" />
                              </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding StageDisplay}"
                                       FontSize="11"
                                       Foreground="{Binding StageBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                          </StackPanel>
                          <StackPanel Grid.Row="0"
                                      Grid.Column="2"
                                      Spacing="4"
                                      HorizontalAlignment="Right"
                                      MaxWidth="140">
                            <TextBlock Text="{Binding ProgressLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Right" />
                            <Button Content="{infra:LocalizedString Key=Backups.Section.Cancel}"
                                    Command="{Binding CancelCommand}"
                                    Classes="small-button"
                                    Padding="8,2"
                                    MinWidth="0"
                                    IsEnabled="{Binding CanCancel}"
                                    IsVisible="{Binding CanCancel}" />
                          </StackPanel>
                          <ProgressBar Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Minimum="0"
                                       Maximum="100"
                                       Value="{Binding DisplayProgress}"
                                       IsIndeterminate="{Binding IsIndeterminate}"
                                       Foreground="{Binding StageBrush}"
                                       Height="6"
                                       CornerRadius="3" />
                          <StackPanel Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Spacing="2"
                                      HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding CurrentFileDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="6"
                                  IsVisible="{Binding HasEtaDisplay}">
                              <Border Grid.Column="0"
                                      Classes="stat-pill sm info"
                                      IsVisible="{Binding IsEstimate}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Classes="pill-icon" Text="≈" />
                                  <TextBlock Text="{Binding EstimateLabel}"
                                             FontSize="10"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding EtaDisplay}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="NoWrap"
                                         HorizontalAlignment="Left"
                                         TextAlignment="Left" />
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{infra:LocalizedString Key=Backups.Section.WaitMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Expander>

        <!-- MAIN AREA: per-project (left) + history (right) -->
        <Grid ColumnDefinitions="3*,2*"
              ColumnSpacing="16">

          <!-- PER-PROJECT BACKUPS -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="14"
                  MinWidth="0"
                  Grid.Column="0"
                  VerticalAlignment="Stretch">

            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">

              <!-- Section header -->
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Section.PerProjectTitle}"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Section.PerProjectDescription}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <ComboBox Grid.Column="1"
                          Classes="preset-combo"
                          MinWidth="120"
                          MaxWidth="170"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding ProjectSortOptions}"
                          SelectedItem="{Binding SelectedProjectSortOption, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>

              <!-- Per-project list -->
              <ListBox x:Name="PerProjectList"
                       Grid.Row="1"
                       ItemsSource="{Binding ProjectBackups}"
                       SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                       SelectionMode="Single"
                       BorderThickness="0"
                       Padding="0"
                       AutoScrollToSelectedItem="False"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       VerticalAlignment="Stretch"
                       MinHeight="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card project-card"
                            CornerRadius="14"
                            Padding="10"
                            Margin="0,2,0,2"
                            Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource BorderSoft}"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="8">

                      <StackPanel Grid.RowSpan="3"
                                  Grid.Column="0"
                                  Orientation="Horizontal"
                                  Spacing="10"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0">
                        <Border Width="4"
                                Height="34"
                                Background="{Binding AvatarColor}"
                                CornerRadius="2"
                                Opacity="0.85"
                                VerticalAlignment="Center" />
                        <Grid Width="40"
                              Height="40"
                              IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
                          <Border Width="40"
                                  Height="40"
                                  CornerRadius="999"
                                  Background="{Binding AvatarColor}" />
                          <Image Source="{Binding AvatarImagePath}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding HasCustomAvatar}">
                            <Image.Clip>
                              <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                            </Image.Clip>
                          </Image>
                          <TextBlock Text="{Binding AvatarInitials}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontWeight="SemiBold"
                                     Foreground="White" />
                        </Grid>
                      </StackPanel>

                      <!-- Name -->
                      <StackPanel Grid.Row="0"
                                  Grid.Column="1"
                                  Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <ItemsControl ItemsSource="{Binding ProjectTags}"
                                      IsVisible="{Binding HasProjectTags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="stat-pill sm info"
                                      Padding="{DynamicResource StatPillPadding}">
                                <TextBlock Text="{Binding}" FontSize="10" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Last backup + stats -->
                      <Grid Grid.Row="1"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            VerticalAlignment="Center">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{infra:LocalizedString Key=Backups.Section.LastBackupLabel}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock Text="{Binding LastBackupDisplay}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     MaxWidth="240"
                                     ToolTip.Tip="{Binding LastBackupDisplay}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   ItemSpacing="8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                          <Border Classes="stat-pill sm warning"
                                  IsVisible="{Binding HasStorageDelta}">
                            <TextBlock Text="{Binding StorageDeltaFormatted}"
                                       FontWeight="SemiBold"
                                       MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" />
                          </Border>
                          <Border Classes="stat-pill sm info">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="pill-icon" Text="*" />
                              <TextBlock Text="{Binding SnapshotCount}" FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                          <Border Classes="stat-pill sm success">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="pill-icon" Text="+" />
                              <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="SemiBold" />
                            </StackPanel>
                          </Border>
                        </WrapPanel>
                      </Grid>

                      <!-- Destination + Encryption -->
                      <Grid Grid.Row="2"
                            Grid.Column="1"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="6">
                        <WrapPanel Grid.Row="0"
                                   Orientation="Horizontal"
                                   ItemSpacing="8"
                                   LineSpacing="8"
                                   ItemHeight="56"
                                   HorizontalAlignment="Stretch">
                          <StackPanel Spacing="5"
                                      Width="190"
                                      MinWidth="160"
                                      MaxWidth="260"
                                      Margin="0,0,8,6">
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.DestinationLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox
                                Classes="preset-combo"
                                ItemsSource="{Binding DataContext.DestinationOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding PreferredDestinationOption, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>

                          <StackPanel Spacing="5"
                                      Width="190"
                                      MinWidth="160"
                                      MaxWidth="260"
                                      Margin="0,0,8,6">
                            <TextBlock Text="{infra:LocalizedString Key=Projects.Stat.EncryptionPolicy}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="BackupsProjectEncryptionPolicyCombo"
                                      Classes="preset-combo"
                                      ItemsSource="{Binding DataContext.EncryptionPolicyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding EncryptionPolicyOption, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>

                          <StackPanel Spacing="5"
                                      Width="190"
                                      MinWidth="160"
                                      MaxWidth="260"
                                      Margin="0,0,0,6">
                            <TextBlock Text="{infra:LocalizedString Key=Backups.Restore.Mode.Label}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox
                                Classes="preset-combo"
                                ItemsSource="{Binding DataContext.RestoreModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding RestoreModeOption, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>

                          <StackPanel Spacing="5"
                                      Width="190"
                                      MinWidth="160"
                                      MaxWidth="260"
                                      Margin="0,0,0,6">
                            <TextBlock Text="{infra:LocalizedString Key=Backups.Verification.Policy.Label}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox
                                Classes="preset-combo"
                                ItemsSource="{Binding DataContext.VerificationPolicyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding VerificationPolicyOption, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </WrapPanel>

                        <WrapPanel Grid.Row="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left">
                          <Border Classes="backup-tag sm info"
                                  Margin="0,0,8,4"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="{Binding EffectiveEncryptionDisplay}" />
                          </Border>

                          <Button x:Name="BackupsProjectEncryptionPasswordButton"
                                  Content="{infra:LocalizedString Key=Settings.Encryption.SetPassword}"
                                  Classes="small-button"
                                  Margin="0,0,0,4"
                                  Command="{Binding DataContext.ManageProjectEncryptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </WrapPanel>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              VerticalAlignment="Center">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding EncryptionSecretStatus}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Margin="0,2,0,0"
                                     TextWrapping="Wrap"
                                     MaxHeight="32"
                                     TextTrimming="CharacterEllipsis" />

                          <Button x:Name="PerProjectBackupButton"
                                  Grid.Column="1"
                                  Content="{infra:LocalizedString Key=Backups.Section.PerProjectAction}"
                                  Classes="action-primary"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,0,2"
                                  Command="{Binding DataContext.BackupProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </Grid>

                      <!-- Auto backup toggle -->
                      <StackPanel Grid.Row="0"
                                  Grid.Column="2"
                                  Spacing="4"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.AutoBackups}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ToggleSwitch x:Name="AutoBackupToggle"
                                    IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    MinWidth="0"
                                      HorizontalAlignment="Right"
                                      ToolTip.Tip="{infra:LocalizedString Key=Backups.Section.AutoBackupsTooltip}" />
                      </StackPanel>

                    </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Border>

          <!-- RIGHT PANEL: destinations + history + activity -->
          <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="12">

            <!-- DESTINATIONS -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="{DynamicResource CardPaddingSmall}"
                    Grid.Row="0">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Title}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Button Grid.Column="1"
                          Content="{infra:LocalizedString Key=Nav.Settings}"
                          Command="{Binding OpenSettingsCommand}"
                          Classes="action-ghost"
                          Padding="10,4"
                          MinWidth="0" />
                </Grid>
                <TextBlock Text="{infra:LocalizedString Key=Tray.Destinations.None}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding HasDestinationStatuses, Converter={StaticResource BoolInvertConverter}}" />
                <ItemsControl ItemsSource="{Binding DestinationStatuses}"
                              IsVisible="{Binding HasDestinationStatuses}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                                 ItemWidth="220"
                                 HorizontalAlignment="Stretch"
                                 ItemSpacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <viewsControls:DestinationStatusCard />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- HISTORY -->
            <Border x:Name="BackupsHistorySection"
                    Classes="card"
                    CornerRadius="18"
                    Padding="{DynamicResource CardPaddingLarge}"
                    Grid.Row="1">

              <StackPanel Spacing="12">

                <!-- History header + filters -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,2">

                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Section.HistoryTitle}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding HistoryFilterProjectLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- Type filter buttons -->
                  <WrapPanel Grid.Column="1"
                             Orientation="Horizontal"
                             ItemSpacing="6"
                             HorizontalAlignment="Right">
                    <ToggleButton Classes="small-pill"
                                  IsChecked="{Binding IsTypeFilterAll, Mode=OneWay}"
                                  Command="{Binding FilterSnapshotsCommand}"
                                  CommandParameter="All">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="pill-icon" Text="•" />
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAll}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="small-pill"
                                  IsChecked="{Binding IsTypeFilterAuto, Mode=OneWay}"
                                  Command="{Binding FilterSnapshotsCommand}"
                                  CommandParameter="Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="pill-icon" Text="▲" />
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAuto}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="small-pill"
                                  IsChecked="{Binding IsTypeFilterManual, Mode=OneWay}"
                                  Command="{Binding FilterSnapshotsCommand}"
                                  CommandParameter="Manual">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="pill-icon" Text="■" />
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterManual}" />
                      </StackPanel>
                    </ToggleButton>
                  </WrapPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,2,0,0">
                  <ToggleButton Content="{infra:LocalizedString Key=Backups.Section.FilterOnlyErrors}"
                                Classes="small-pill"
                                IsChecked="{Binding OnlyErrorsFilter, Mode=TwoWay}" />
                  <ToggleButton Content="{infra:LocalizedString Key=Backups.Section.FilterOnlyManual}"
                                Classes="small-pill"
                                IsChecked="{Binding OnlyManualFilter, Mode=TwoWay}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*,Auto"
                      ColumnSpacing="8"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="6"
                      Margin="0,4,0,0">
                  <TextBlock Grid.Row="0"
                             Grid.ColumnSpan="3"
                             Text="{infra:LocalizedString Key=Backups.Compare.Header}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />

                  <ComboBox Grid.Row="1"
                            Grid.Column="0"
                            ItemsSource="{Binding Snapshots}"
                            SelectedItem="{Binding SelectedSnapshotA, Mode=TwoWay}"
                            MinWidth="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding TimelineSelectionLabel}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding Snapshots}"
                            SelectedItem="{Binding SelectedSnapshotB, Mode=TwoWay}"
                            MinWidth="180">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding TimelineSelectionLabel}"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Content="{infra:LocalizedString Key=Backups.Compare.Button}"
                          Classes="small-button"
                          Command="{Binding CompareSelectedSnapshotsCommand}" />

                  <TextBlock Grid.Row="2"
                             Grid.ColumnSpan="3"
                             Text="{infra:LocalizedString Key=Backups.Compare.Help}"
                             FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextWrapping="Wrap" />
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerBrush}" />

                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding SnapshotGroups}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card project-card"
                                CornerRadius="12"
                                Padding="0"
                                Margin="{DynamicResource ListItemMarginTight}">
                        <Expander Classes="backup-group"
                                  IsExpanded="{Binding IsExpanded}"
                                  HorizontalAlignment="Stretch">
                          <Expander.Header>
                            <Grid ColumnDefinitions="6,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="6"
                                  Margin="{DynamicResource CardPaddingSmall}">
                              <Border Grid.RowSpan="2"
                                      Grid.Column="0"
                                      Width="6"
                                      Background="{Binding AccentBrush}"
                                      CornerRadius="3" />
                              <StackPanel Grid.Row="0"
                                          Grid.Column="1"
                                          Spacing="2">
                                <TextBlock Text="{Binding ProjectName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Classes="backup-tag sm info"
                                        IsVisible="{Binding HasProjectTags}"
                                        HorizontalAlignment="Left"
                                        MaxWidth="360"
                                        ToolTip.Tip="{Binding ProjectTagsDisplay}">
                                  <TextBlock Text="{Binding ProjectTagsDisplay}"
                                             FontSize="10"
                                             TextTrimming="CharacterEllipsis"
                                             TextWrapping="NoWrap" />
                                </Border>
                              </StackPanel>
                              <StackPanel Grid.Row="1"
                                          Grid.Column="1"
                                          Orientation="Horizontal"
                                          Spacing="6">
                                <TextBlock Text="{infra:LocalizedString Key=Backups.Section.LastBackupLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LatestBackupDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Row="2"
                                          Grid.Column="1"
                                          Orientation="Horizontal"
                                          Spacing="6">
                                <Border Classes="stat-pill sm info"
                                        Padding="{DynamicResource StatPillPadding}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="pill-icon" Text="◷" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="{Binding Summary}" />
                                  </StackPanel>
                                </Border>
                                <Border Classes="stat-pill sm success"
                                        Padding="{DynamicResource StatPillPadding}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="pill-icon" Text="⬤" />
                                    <TextBlock Text="{Binding TotalSizeFormatted}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="{Binding TotalSizeFormatted}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Expander.Header>

                          <Border Margin="0,0,0,0"
                                  Padding="{DynamicResource CardPaddingSmall}"
                                  BorderBrush="{DynamicResource CardBorderBrush}"
                                  BorderThickness="0,1,0,0">
                              <ItemsControl ItemsSource="{Binding Snapshots}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="{DynamicResource Surface1}"
                                            BorderBrush="{DynamicResource BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="{DynamicResource CardPaddingSmall}"
                                            Margin="0,4,0,10">
                                      <Grid ColumnDefinitions="6,*,Auto"
                                            ColumnSpacing="12"
                                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                            RowSpacing="10">
                                        <Border Grid.RowSpan="5"
                                                Grid.Column="0"
                                                Background="{Binding TagBackground}"
                                                CornerRadius="3"
                                                Opacity="0.9" />

                                        <WrapPanel Grid.Row="0"
                                                   Grid.Column="1"
                                                   ItemSpacing="8"
                                                   Orientation="Horizontal"
                                                   VerticalAlignment="Center">
                                          <TextBlock Text="{Binding Label}"
                                                     FontSize="13"
                                                     FontWeight="SemiBold"
                                                     TextTrimming="CharacterEllipsis" />
                                          <Border Classes="backup-tag sm info"
                                                  Background="{Binding TagBackground}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Classes="pill-icon" Text="●" />
                                              <TextBlock Text="{Binding ModeChipLabel}"
                                                         FontSize="11"
                                                         TextTrimming="CharacterEllipsis"
                                                         TextWrapping="NoWrap"
                                                         MaxWidth="180"
                                                         ToolTip.Tip="{Binding ModeChipLabel}" />
                                            </StackPanel>
                                          </Border>
                                          <Border Classes="backup-tag sm warning"
                                                  Background="{Binding ImportedTagBackground}"
                                                  IsVisible="{Binding IsImported}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Classes="pill-icon" Text="⇄" />
                                              <TextBlock Text="{Binding ImportedLabel}"
                                                         FontSize="11"
                                                         TextTrimming="CharacterEllipsis"
                                                         TextWrapping="NoWrap"
                                                         MaxWidth="180"
                                                         ToolTip.Tip="{Binding ImportedLabel}" />
                                            </StackPanel>
                                          </Border>
                                          <Border Classes="backup-tag sm info"
                                                  Background="{DynamicResource Surface3}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Classes="pill-icon" Text="⌁" />
                                              <TextBlock Text="{Binding EncryptionChipLabel}"
                                                         FontSize="11"
                                                         TextTrimming="CharacterEllipsis"
                                                         TextWrapping="NoWrap"
                                                         MaxWidth="180"
                                                         ToolTip.Tip="{Binding EncryptionChipLabel}" />
                                            </StackPanel>
                                          </Border>
                                        </WrapPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="2"
                                                CornerRadius="999"
                                                Padding="10,4"
                                                Background="{DynamicResource Surface3}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                MinWidth="90"
                                                MaxWidth="140"
                                                MinHeight="30">
                                          <TextBlock Text="{Binding SizeFormatted}"
                                                     FontSize="11"
                                                     FontWeight="SemiBold"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     MaxWidth="128" />
                                        </Border>

                                        <WrapPanel Grid.Row="1"
                                                   Grid.Column="1"
                                                   ItemSpacing="6">
                                          <Border Classes="stat-pill sm info"
                                                  Padding="{DynamicResource StatPillPadding}"
                                                  Background="{DynamicResource Surface3}"
                                                  BorderBrush="{DynamicResource BorderSoft}"
                                                  BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Classes="pill-icon" Text="◴" />
                                              <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                         FontSize="11"
                                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                          </Border>
                                          <Border Classes="stat-pill sm info"
                                                  Padding="{DynamicResource StatPillPadding}"
                                                  Background="{DynamicResource Surface2}"
                                                  BorderBrush="{Binding TagBackground}"
                                                  BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                              <TextBlock Classes="pill-icon" Text="⌂" />
                                              <TextBlock Text="{Binding DestinationDisplay}"
                                                         FontSize="11"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         TextTrimming="CharacterEllipsis"
                                                         TextWrapping="NoWrap"
                                                         MaxWidth="260"
                                                         ToolTip.Tip="{Binding DestinationDisplay}" />
                                            </StackPanel>
                                          </Border>
                                        </WrapPanel>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding RetentionOutcomeLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="420"
                                                   TextAlignment="Left" />

                                        <StackPanel x:Name="BackupsDiffSummarySection"
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Spacing="2">
                                          <TextBlock Text="{Binding DiffSummaryDisplay}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"
                                                     MaxLines="2" />
                                          <TextBlock Text="{Binding DiffTopPathsDisplay}"
                                                     IsVisible="{Binding HasDiffTopPaths}"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                     TextWrapping="Wrap"
                                                     MaxLines="2" />
                                        </StackPanel>

                                        <WrapPanel Grid.Row="4"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,2,0,0"
                                                   ItemSpacing="8">
                                          <CheckBox Content="{infra:LocalizedString Key=Backups.Section.Keep}"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsProtected, Mode=TwoWay}"
                                                    Command="{Binding DataContext.ToggleBackupProtectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"/>
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.OpenFolder}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.OpenBackupFolderCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.Restore}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.RestoreBackupCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.DiffSummary.ViewDiff}"
                                                  Classes="small-button"
                                                  IsEnabled="{Binding CanOpenDiffDetails}"
                                                  Command="{Binding DataContext.ShowSnapshotDiffPreviewCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.DiffSummary.ExportText}"
                                                  Classes="small-button"
                                                  IsEnabled="{Binding CanOpenDiffDetails}"
                                                  Command="{Binding DataContext.ExportSnapshotSummaryTextCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.DiffSummary.ExportJson}"
                                                  Classes="small-button"
                                                  IsEnabled="{Binding CanOpenDiffDetails}"
                                                  Command="{Binding DataContext.ExportSnapshotSummaryJsonCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.Delete}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.DeleteBackupCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                        </WrapPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                          </Border>
                        </Expander>
                        </Border>
                      </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

              </StackPanel>
            </Border>

          </Grid>

        </Grid>

        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border IsVisible="{Binding IsVerificationPopupOpen}"
            Background="{DynamicResource OverlayScrimBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360">
          <StackPanel Spacing="12">
            <TextBlock Text="{infra:LocalizedString Key=Backups.Verification.Title}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding VerificationPopupMessage}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="{infra:LocalizedString Key=Backups.Verification.Keep}"
                      MinWidth="100"
                      Command="{Binding CloseVerificationPopupCommand}" />
              <Button Content="{infra:LocalizedString Key=Backups.Verification.Delete}"
                      MinWidth="110"
                      Command="{Binding DeleteFailedBackupCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border IsVisible="{Binding IsDiffPreviewOpen}"
            Background="{DynamicResource OverlayScrimBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="16"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="760"
                MaxWidth="1100"
                Height="520"
                MaxHeight="680">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                RowSpacing="10">
            <StackPanel Grid.Row="0"
                        Spacing="4">
              <TextBlock Text="{Binding DiffPreviewTitle}"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding DiffPreviewMetaLine}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       ItemSpacing="8"
                       LineSpacing="8">
              <Border Classes="stat-pill sm info">
                <TextBlock Text="{Binding DiffPreviewTrigger}" />
              </Border>
              <Border Classes="stat-pill sm info">
                <TextBlock Text="{Binding DiffPreviewMode}" />
              </Border>
              <Border Classes="stat-pill sm warning">
                <TextBlock Text="{Binding DiffPreviewImportedDisplay}" />
              </Border>
              <Border Classes="stat-pill sm info">
                <TextBlock Text="{Binding DiffPreviewEncryptionDisplay}" />
              </Border>
            </WrapPanel>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10">
              <Border Grid.Column="0"
                      Classes="card"
                      Padding="10"
                      CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      RowSpacing="6">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.Changes}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Grid.ColumnSpan="2"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Row="1"
                             Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.Added}" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding DiffPreviewAdded}" />
                  <TextBlock Grid.Row="2"
                             Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.Modified}" />
                  <TextBlock Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding DiffPreviewModified}" />
                  <TextBlock Grid.Row="3"
                             Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.Deleted}" />
                  <TextBlock Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding DiffPreviewDeleted}" />
                </Grid>
              </Border>
              <Border Grid.Column="1"
                      Classes="card"
                      Padding="10"
                      CornerRadius="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.NetChange}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding DiffPreviewNet}"
                             FontSize="16"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="3"
                  ColumnDefinitions="2*,3*"
                  ColumnSpacing="10">
              <Border Grid.Column="0"
                      Classes="card"
                      Padding="10"
                      CornerRadius="10">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.TopPaths}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <ScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DiffPreviewTopPaths}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6"
                                  Padding="8"
                                  CornerRadius="8"
                                  Background="{DynamicResource Surface2}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBlock Text="{Binding Path}"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis"
                                         MaxLines="2" />
                              <StackPanel Grid.Column="1"
                                          Spacing="2">
                                <TextBlock Text="{Binding Changes}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ChangedBytes}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <Border Grid.Column="1"
                      Classes="card"
                      Padding="10"
                      CornerRadius="10">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.DiffSummary.Preview.Raw}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBox Grid.Row="1"
                           Text="{Binding DiffPreviewText}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           FontFamily="Consolas"
                           FontSize="12"
                           Background="{DynamicResource Surface1}"
                           BorderBrush="{DynamicResource BorderSoft}" />
                </Grid>
              </Border>
            </Grid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="{infra:LocalizedString Key=Backups.DiffSummary.ClosePreview}"
                      Classes="action-ghost"
                      Padding="14,8"
                      CornerRadius="10"
                      MinWidth="110"
                      Command="{Binding CloseSnapshotDiffPreviewCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

  </Grid>
</UserControl>
