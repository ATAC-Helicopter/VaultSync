<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI.ViewModels"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             x:Class="VaultSync.UI.Views.BackupsView"
             x:DataType="vm:BackupsViewModel"
             x:CompileBindings="False">

  <UserControl.Resources>
    <controls:StatusToBrushConverter x:Key="StatusToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="#PerProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,4,0,4"
                  Background="Transparent"
                  Padding="0">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>


    <Style Selector="Border.backup-tag">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.project-icon-circle">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style Selector="Border.pulse-ring">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
          </KeyFrame>
          <KeyFrame Cue="70%">
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Expander.backup-group">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Expander">
          <Border CornerRadius="18"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <StackPanel Margin="{TemplateBinding Padding}">
              <ToggleButton x:Name="PART_Header"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Focusable="False"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  HorizontalAlignment="Stretch" />
              </ToggleButton>
              <ContentPresenter x:Name="PART_ContentHost"
                                Margin="0,8,0,0"
                                Content="{TemplateBinding Content}"
                                IsVisible="{TemplateBinding IsExpanded}" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Expander.backup-group ToggleButton#PART_Header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter
              Content="{TemplateBinding Content}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Margin="0" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Expander.backup-group ToggleButton#PART_Header:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Smooth expand/collapse -->
    <Style Selector="Expander.backup-group /template/ ContentPresenter#PART_ContentHost">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Expander.backup-group:expanded /template/ ContentPresenter#PART_ContentHost">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Expander.backup-group TextBlock.chevron">
      <Setter Property="Text" Value="›" />
    </Style>
    <Style Selector="Expander.backup-group:expanded TextBlock.chevron">
      <Setter Property="Text" Value="‹›" />
    </Style>

    <!-- Per-project cards -->
    <Style Selector="Border.project-card">
      <Setter Property="Background" Value="{DynamicResource Surface3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Active backup cards -->
    <Style Selector="Border.active-backup-card">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Small buttons -->
    <Style Selector="Button.small-button">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.small-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>
    <Style Selector="Button.small-button:pressed">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Small filter pills -->
    <Style Selector="Button.small-pill">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.small-pill:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Button.small-pill:pressed">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>

    <!-- Per-project primary action -->

  </UserControl.Styles>
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  BringIntoViewOnFocusChange="False">
      <!-- Stretch to the full available width with a soft cap for readability. -->
      <Grid MaxWidth="2200"
            HorizontalAlignment="Stretch">
        <StackPanel Margin="24"
                    Spacing="16">

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="12">
          <StackPanel>
            <TextBlock Text="{infra:LocalizedString Key=Backups.Page.Title}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{infra:LocalizedString Key=Backups.Page.Description}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      Margin="16,0,0,0">
            <Button Content="{infra:LocalizedString Key=Backups.Action.BackupAll}"
                    HorizontalAlignment="Left"
                    Classes="primary-button"
                    Command="{Binding CreateBackupCommand}"/>
          </StackPanel>
        </StackPanel>

        <!-- NOTIFICATION BANNER -->
        <controls:NotificationCard DataContext="{Binding Notification}" />


        <!-- SUMMARY CARDS -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="12">

          <!-- Total snapshots -->
          <Border Classes="card"
                  Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="{infra:LocalizedString Key=Backups.Summary.Total}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding TotalSnapshots}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Margin="0,4,0,4" />
              <TextBlock Grid.Row="2"
                         Text="{Binding SnapshotsSummaryLine}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>

          <!-- Last backup -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="1">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="{infra:LocalizedString Key=Backups.Summary.Last}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding LastBackupDisplay}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,4,0,2" />
              <TextBlock Grid.Row="2"
                         Text="{Binding LastBackupRelative}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>

          <!-- Total backup size -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="2">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="{infra:LocalizedString Key=Backups.Summary.TotalStored}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding TotalBackupSizeFormatted}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,4,0,2" />
              <TextBlock Grid.Row="2"
                         Text="{Binding SnapshotActivitySummary}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>
        </Grid>

        <!-- MINI BACKUP STORAGE CARD (Backups page) -->
        <Border Classes="card"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=Backups.Section.StorageLabel}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding BackupDiskDriveLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Used percent + free/total summary -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding BackupDiskUsedPercent, StringFormat='{}{0:0}% used'}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="·"
                         Margin="4,0"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding BackupDiskFreeText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Usage bar -->
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding BackupDiskUsedPercent}"
                         Height="4"
                         CornerRadius="2" />

            <!-- Threshold / warning info -->
            <TextBlock Text="{Binding BackupDiskThresholdText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBlock Text="{infra:LocalizedString Key=Backups.Section.Warning}"
                       FontSize="11"
                       Foreground="{DynamicResource DangerBrush}"
                       IsVisible="{Binding BackupDiskIsBelowThreshold}" />

            <!-- SMART / drive health -->
            <TextBlock Text="{Binding BackupDiskHealthText}"
                       FontSize="11"
                       Foreground="{Binding BackupDiskHealthBrush}" />
          </StackPanel>
        </Border>

        <!-- RUNNING BACKUPS CARD (inline, below summary cards) -->
        <Expander Classes="backup-group"
                  IsExpanded="True"
                  IsVisible="{Binding IsBusy}">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="6">
                <TextBlock Text="{infra:LocalizedString Key=Backups.Section.Active}"
                           FontSize="14"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveBackups.Count, StringFormat=' · {0} active'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Classes="chevron"
                           Margin="8,0,0,0"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Expander.Header>

          <Border Margin="0,6,0,0"
                  Padding="0,8,0,0"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <ItemsControl x:Name="ActiveBackupsList" ItemsSource="{Binding ActiveBackups}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                               ItemWidth="320" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,4,12,4"
                              Padding="12"
                              Classes="active-backup-card"
                              HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="4,*,Auto"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="6"
                              HorizontalAlignment="Stretch">
                          <Border Grid.RowSpan="3"
                                  Grid.Column="0"
                                  Width="4"
                                  CornerRadius="2"
                                  Background="{Binding StageBrush}"
                                  Opacity="0.8" />
                          <StackPanel Grid.Row="0"
                                      Grid.Column="1"
                                      Spacing="2"
                                      HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding ProjectName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                            <TextBlock Text="{Binding StageDisplay}"
                                       FontSize="11"
                                       Foreground="{Binding StageBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                          </StackPanel>
                          <StackPanel Grid.Row="0"
                                      Grid.Column="2"
                                      Spacing="4"
                                      HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                            <Button Content="{infra:LocalizedString Key=Backups.Section.Cancel}"
                                    Command="{Binding CancelCommand}"
                                    Classes="small-button"
                                    Padding="8,2"
                                    MinWidth="0"
                                    IsEnabled="{Binding CanCancel}"
                                    IsVisible="{Binding CanCancel}" />
                          </StackPanel>
                          <ProgressBar Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Minimum="0"
                                       Maximum="100"
                                       Value="{Binding DisplayProgress}"
                                       IsIndeterminate="{Binding IsIndeterminate}"
                                       Foreground="{Binding StageBrush}"
                                       Height="6"
                                       CornerRadius="3" />
                          <StackPanel Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Spacing="2"
                                      HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding CurrentFileDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                            <TextBlock Text="{Binding EtaDisplay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsVisible="{Binding HasEtaDisplay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{infra:LocalizedString Key=Backups.Section.WaitMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Expander>

        <!-- MAIN AREA: per-project (left) + history (right) -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16">

          <!-- PER-PROJECT BACKUPS -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="14"
                  MinWidth="360"
                  Grid.Column="0">

            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">

              <!-- Section header -->
              <StackPanel Grid.Row="0"
                          Orientation="Horizontal"
                          HorizontalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Section.PerProjectTitle}"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Section.PerProjectDescription}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>

              <!-- Per-project list -->
              <ListBox x:Name="PerProjectList"
                       Grid.Row="1"
                       ItemsSource="{Binding ProjectBackups}"
                       SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                       SelectionMode="Single"
                       BorderThickness="0"
                       VerticalAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card project-card"
                            CornerRadius="14"
                            Padding="8"
                            Margin="0,3,0,3"
                            Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource BorderSoft}"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="4,Auto,*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="3">

                      <Border Grid.RowSpan="3"
                              Grid.Column="0"
                              Width="4"
                              Background="{Binding AvatarColor}"
                              CornerRadius="2"
                              Opacity="0.85"
                              VerticalAlignment="Stretch"
                              Margin="0,4,0,4" />

                      <!-- Avatar -->
                      <Grid Grid.RowSpan="3"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            IsVisible="{Binding DataContext.ShowProjectAvatars, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border CornerRadius="18"
                                Background="{Binding AvatarColor}" />
                        <Image Source="{Binding AvatarImagePath}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasCustomAvatar}">
                          <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                          </Image.Clip>
                        </Image>
                        <TextBlock Text="{Binding AvatarInitials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                      </Grid>

                      <!-- Name -->
                      <StackPanel Grid.Row="0"
                                  Grid.Column="2"
                                  Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <!-- Last backup -->
                      <StackPanel Grid.Row="1"
                                  Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.LastBackupLabel}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastBackupDisplay}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>

                      <!-- Stats pills -->
                      <StackPanel Grid.Row="2"
                                  Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <Border CornerRadius="999"
                                Padding="6,2"
                                Background="{DynamicResource Surface2}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding SnapshotCount}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{infra:LocalizedString Key=Backups.Section.BackupsLabel}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Border>
                        <Border CornerRadius="999"
                                Padding="6,2"
                                Background="{DynamicResource Surface2}">
                          <TextBlock Text="{Binding TotalSizeFormatted}"
                                     FontSize="11"
                                     FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>

                      <!-- Auto backup toggle -->
                      <StackPanel Grid.Row="0"
                                  Grid.Column="3"
                                  Spacing="4"
                                  HorizontalAlignment="Right">
                        <TextBlock Text="{infra:LocalizedString Key=Backups.Section.AutoBackups}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ToggleSwitch IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                      OffContent=""
                                      OnContent=""
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      MinWidth="0"
                                      HorizontalAlignment="Right"
                                      ToolTip.Tip="{infra:LocalizedString Key=Backups.Section.AutoBackupsTooltip}" />
                      </StackPanel>

                      <!-- Primary action -->
                      <Button Grid.Row="2"
                              Grid.Column="3"
                              Content="{infra:LocalizedString Key=Backups.Section.PerProjectAction}"
                              Classes="action-primary"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,4,0,0"
                              Command="{Binding DataContext.BackupProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />

                    </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Grid>
          </Border>

          <!-- RIGHT PANEL: destinations + history + activity -->
          <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="12">

            <!-- DESTINATIONS -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="14"
                    Grid.Row="0">
              <StackPanel Spacing="8">
                <TextBlock Text="{infra:LocalizedString Key=Settings.Destinations.Title}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{infra:LocalizedString Key=Tray.Destinations.None}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding HasDestinationStatuses, Converter={StaticResource BoolInvertConverter}}" />
                <ItemsControl ItemsSource="{Binding DestinationStatuses}"
                              IsVisible="{Binding HasDestinationStatuses}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal"
                                 ItemWidth="260"
                                 ItemHeight="64"
                                 HorizontalAlignment="Stretch"
                                 ItemSpacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,2,0,0"
                              Padding="8"
                              CornerRadius="12"
                              Background="{DynamicResource Surface2}"
                              BorderBrush="{DynamicResource BorderSoft}"
                              BorderThickness="1">
                        <Grid ColumnDefinitions="4,*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="4">
                          <Border Grid.RowSpan="2"
                                  Grid.Column="0"
                                  CornerRadius="2"
                                  Background="{Binding ReachabilityBrush}"
                                  Opacity="0.9"
                                  VerticalAlignment="Center"
                                  Margin="0,6,0,6" />
                          <StackPanel Grid.Column="1"
                                      Spacing="2">
                            <TextBlock Text="{Binding Alias}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Grid Grid.Column="2"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Status}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Grid Width="20"
                                    Height="20"
                                    ClipToBounds="False"
                                    ToolTip.Tip="{Binding Status}">
                                <Border Classes="pulse-ring"
                                        CornerRadius="5"
                                        Background="{Binding ReachabilityBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsChecking}" />
                                <Border Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{Binding ReachabilityBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                              </Grid>
                            </StackPanel>
                            <ToggleSwitch Grid.Row="1"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          IsEnabled="{Binding DataContext.CanToggleDestinations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          IsVisible="{Binding IsConfigurable}"
                                          VerticalAlignment="Center"
                                          Content="{infra:LocalizedString Key=Settings.Destinations.ActiveToggle}"
                                          OnContent=""
                                          OffContent="" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- HISTORY -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="18"
                    MinWidth="360"
                    Grid.Row="1">

              <StackPanel Spacing="12">

                <!-- History header + filters -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,2">

                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{infra:LocalizedString Key=Backups.Section.HistoryTitle}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding HistoryFilterProjectLabel}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <Button Content="{infra:LocalizedString Key=Backups.Section.HistoryFilterAllProjects}"
                              Classes="small-pill"
                              Command="{Binding ShowProjectHistoryCommand}" />
                    </StackPanel>
                  </StackPanel>

                  <!-- Type filter buttons -->
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              HorizontalAlignment="Right">
                    <Button Content="{infra:LocalizedString Key=Backups.Section.FilterAll}"
                            Classes="small-pill"
                            Command="{Binding FilterSnapshotsCommand}"
                            CommandParameter="All" />
                    <Button Content="{infra:LocalizedString Key=Backups.Section.FilterAuto}"
                            Classes="small-pill"
                            Command="{Binding FilterSnapshotsCommand}"
                            CommandParameter="Auto" />
                    <Button Content="{infra:LocalizedString Key=Backups.Section.FilterManual}"
                            Classes="small-pill"
                            Command="{Binding FilterSnapshotsCommand}"
                            CommandParameter="Manual" />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,2,0,0">
                  <ToggleButton Content="{infra:LocalizedString Key=Backups.Section.FilterOnlyErrors}"
                                Classes="small-pill"
                                IsChecked="{Binding OnlyErrorsFilter, Mode=TwoWay}" />
                  <ToggleButton Content="{infra:LocalizedString Key=Backups.Section.FilterOnlyManual}"
                                Classes="small-pill"
                                IsChecked="{Binding OnlyManualFilter, Mode=TwoWay}" />
                </StackPanel>

                <Border Height="1"
                        Background="{DynamicResource DividerBrush}" />

                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                MaxHeight="520"
                                Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding SnapshotGroups}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card project-card"
                                CornerRadius="12"
                                Padding="0"
                                Margin="0,4,0,4">
                        <Expander Classes="backup-group"
                                  IsExpanded="{Binding IsExpanded}"
                                  HorizontalAlignment="Stretch">
                          <Expander.Header>
                            <Grid ColumnDefinitions="6,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="6"
                                  Margin="10">
                              <Border Grid.RowSpan="2"
                                      Grid.Column="0"
                                      Width="6"
                                      Background="{Binding AccentBrush}"
                                      CornerRadius="3" />
                              <StackPanel Grid.Row="0"
                                          Grid.Column="1"
                                          Spacing="2">
                                <TextBlock Text="{Binding ProjectName}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <StackPanel Grid.Row="1"
                                          Grid.Column="1"
                                          Orientation="Horizontal"
                                          Spacing="6">
                                <TextBlock Text="{infra:LocalizedString Key=Backups.Section.LastBackupLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LatestBackupDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Row="2"
                                          Grid.Column="1"
                                          Orientation="Horizontal"
                                          Spacing="6">
                                <Border CornerRadius="999"
                                        Padding="8,2"
                                        Background="{DynamicResource Surface2}">
                                  <TextBlock Text="{Binding Summary}"
                                             FontSize="11"
                                             FontWeight="SemiBold" />
                                </Border>
                                <Border CornerRadius="999"
                                        Padding="8,2"
                                        Background="{DynamicResource Surface2}">
                                  <TextBlock Text="{Binding TotalSizeFormatted}"
                                             FontSize="11"
                                             FontWeight="SemiBold" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Expander.Header>

                          <Border Margin="0,0,0,0"
                                  Padding="10"
                                  BorderBrush="{DynamicResource CardBorderBrush}"
                                  BorderThickness="0,1,0,0">
                              <ItemsControl ItemsSource="{Binding Snapshots}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Background="{DynamicResource Surface1}"
                                            BorderBrush="{DynamicResource BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12"
                                            Margin="0,4,0,10">
                                      <Grid ColumnDefinitions="6,*,Auto"
                                            ColumnSpacing="12"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="8">
                                        <Border Grid.RowSpan="3"
                                                Grid.Column="0"
                                                Background="{Binding TagBackground}"
                                                CornerRadius="3"
                                                Opacity="0.9" />

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                          <TextBlock Text="{Binding Label}"
                                                     FontSize="13"
                                                     FontWeight="SemiBold"
                                                     TextTrimming="CharacterEllipsis" />
                                          <Border Classes="backup-tag"
                                                  Background="{Binding TagBackground}">
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       FontSize="11" />
                                          </Border>
                                          <Border Classes="backup-tag"
                                                  Background="{Binding ImportedTagBackground}"
                                                  IsVisible="{Binding IsImported}">
                                            <TextBlock Text="{Binding ImportedLabel}"
                                                       FontSize="11" />
                                          </Border>
                                        </StackPanel>

                                        <Border Grid.Row="0"
                                                Grid.Column="2"
                                                CornerRadius="999"
                                                Padding="8,2"
                                                Background="{DynamicResource Surface3}">
                                          <TextBlock Text="{Binding SizeFormatted}"
                                                     FontSize="11"
                                                     FontWeight="SemiBold" />
                                        </Border>

                                        <WrapPanel Grid.Row="1"
                                                   Grid.Column="1"
                                                   ItemSpacing="6">
                                          <Border CornerRadius="999"
                                                  Padding="8,2"
                                                  Background="{DynamicResource Surface3}"
                                                  BorderBrush="{DynamicResource BorderSoft}"
                                                  BorderThickness="1">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                          </Border>
                                          <Border CornerRadius="999"
                                                  Padding="8,2"
                                                  Background="{DynamicResource Surface2}"
                                                  BorderBrush="{Binding TagBackground}"
                                                  BorderThickness="1">
                                            <TextBlock Text="{Binding DestinationDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                          </Border>
                                        </WrapPanel>

                                        <WrapPanel Grid.Row="2"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   ItemSpacing="8">
                                          <CheckBox Content="{infra:LocalizedString Key=Backups.Section.Keep}"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsProtected, Mode=TwoWay}"
                                                    Command="{Binding DataContext.ToggleBackupProtectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"/>
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.OpenFolder}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.OpenBackupFolderCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.Restore}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.RestoreBackupCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                          <Button Content="{infra:LocalizedString Key=Backups.Section.Delete}"
                                                  Classes="small-button"
                                                  Command="{Binding DataContext.DeleteBackupCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                        </WrapPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                          </Border>
                        </Expander>
                        </Border>
                      </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

              </StackPanel>
            </Border>

            <!-- ACTIVITY -->
            <Border Classes="card"
                    CornerRadius="18"
                    Padding="14"
                    MinWidth="360"
                    Grid.Row="2">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Text="{infra:LocalizedString Key=Backups.Section.SnapshotsActivity}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="10"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Border Width="8" Height="8" CornerRadius="4" Background="#3A7AFE" />
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterAuto}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Border Width="8" Height="8" CornerRadius="4" Background="#22CC88" />
                      <TextBlock Text="{infra:LocalizedString Key=Backups.Section.FilterManual}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding SnapshotActivity}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Spacing="2">
                        <Border Width="12"
                                ToolTip.Tip="{Binding TooltipText}">
                          <StackPanel VerticalAlignment="Bottom" Spacing="1">
                            <Border Height="{Binding ManualHeight}"
                                    Background="{Binding ManualBrush}"
                                    CornerRadius="3"
                                    IsVisible="{Binding HasManual}" />
                            <Border Height="{Binding AutoHeight}"
                                    Background="{Binding AutoBrush}"
                                    CornerRadius="3"
                                    IsVisible="{Binding HasAuto}" />
                            <Border Height="{Binding EmptyHeight}"
                                    Background="{Binding EmptyBrush}"
                                    CornerRadius="3"
                                    IsVisible="{Binding IsEmpty}" />
                          </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DayLabel}"
                                   IsVisible="{Binding ShowLabel}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </Grid>

        </Grid>

        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border IsVisible="{Binding IsVerificationPopupOpen}"
            Background="{DynamicResource OverlayScrimBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360">
          <StackPanel Spacing="12">
            <TextBlock Text="{infra:LocalizedString Key=Backups.Verification.Title}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding VerificationPopupMessage}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="{infra:LocalizedString Key=Backups.Verification.Keep}"
                      MinWidth="100"
                      Command="{Binding CloseVerificationPopupCommand}" />
              <Button Content="{infra:LocalizedString Key=Backups.Verification.Delete}"
                      MinWidth="110"
                      Command="{Binding DeleteFailedBackupCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

  </Grid>
</UserControl>
