<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VaultSync.UI.ViewModels"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             x:Class="VaultSync.UI.Views.BackupsView"
             x:DataType="vm:BackupsViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <!-- Remove OS-style blue selection highlight for list boxes in this view -->
    <Style Selector="ListBox > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Per-project backups list: card container + selected tint -->
    <Style Selector="#PerProjectList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,4,0,4"
                  CornerRadius="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="16">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="#PerProjectList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Global backup history list: card container + selected tint -->
    <Style Selector="#HistoryList ListBoxItem">
      <Setter Property="Template">
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="CardBorder"
                  Margin="0,4,0,4"
                  CornerRadius="16"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Padding="12">
            <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="#HistoryList ListBoxItem:selected /template/ Border#CardBorder">
      <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
    </Style>

    <!-- Tag pill style for snapshot type/status -->
    <Style Selector="Border.backup-tag">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small icon circle (for per-project list) -->
    <Style Selector="Border.project-icon-circle">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Card-style expander for backup history groups -->
    <Style Selector="Expander.backup-group">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Expander">
          <Border CornerRadius="18"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1">
            <StackPanel Margin="{TemplateBinding Padding}">
              <!-- Header row -->
              <ToggleButton x:Name="PART_Header"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Focusable="False"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  HorizontalAlignment="Stretch" />
              </ToggleButton>

              <!-- Content -->
              <ContentPresenter x:Name="PART_ContentHost"
                                Margin="0,8,0,0"
                                Content="{TemplateBinding Content}"
                                IsVisible="{TemplateBinding IsExpanded}" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Remove accent/selection visuals from backup-group headers -->
    <Style Selector="Expander.backup-group ToggleButton#PART_Header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <ContentPresenter
              Content="{TemplateBinding Content}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Margin="0" />
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Expander.backup-group ToggleButton#PART_Header:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Expander.backup-group ToggleButton#PART_Header:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Chevron text for backup-group expanders -->
    <Style Selector="Expander.backup-group TextBlock.chevron">
      <Setter Property="Text" Value="⌄" />
    </Style>
    <Style Selector="Expander.backup-group:expanded TextBlock.chevron">
      <Setter Property="Text" Value="⌃" />
    </Style>


  </UserControl.Styles>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24"
                  Spacing="16">

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="12">
          <StackPanel>
            <TextBlock Text="Backups"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="View backup history and per-project backup status."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right"
                      Margin="16,0,0,0">
            <Button Content="Back up all projects"
                    HorizontalAlignment="Left"
                    Classes="primary-button"
                    Command="{Binding CreateBackupCommand}"/>
          </StackPanel>
        </StackPanel>

        <!-- NOTIFICATION BANNER -->
        <controls:NotificationCard DataContext="{Binding Notification}" />


        <!-- SUMMARY CARDS -->
        <Grid ColumnDefinitions="*,*,*"
              ColumnSpacing="12">

          <!-- Total snapshots -->
          <Border Classes="card"
                  Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="Backups"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding TotalSnapshots}"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Margin="0,4,0,4" />
              <TextBlock Grid.Row="2"
                         Text="{Binding SnapshotsSummaryLine}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>

          <!-- Last backup -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="1">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="Last backup"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding LastBackupDisplay}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,4,0,2" />
              <TextBlock Grid.Row="2"
                         Text="{Binding LastBackupRelative}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>

          <!-- Total backup size -->
          <Border Classes="card"
                  Padding="16"
                  Grid.Column="2">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0"
                         Text="Total stored"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Row="1"
                         Text="{Binding TotalBackupSizeFormatted}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,4,0,2" />
              <TextBlock Grid.Row="2"
                         Text="{Binding SnapshotActivitySummary}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
          </Border>
        </Grid>

        <!-- MINI BACKUP STORAGE CARD (Backups page) -->
        <Border Classes="card"
                Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="Backup storage"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- Used percent + free/total summary -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding BackupDiskUsedPercent, StringFormat='{}{0:0}% used'}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="•"
                         Margin="4,0"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding BackupDiskFreeText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Usage bar -->
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding BackupDiskUsedPercent}"
                         Height="4"
                         CornerRadius="2" />

            <!-- Threshold / warning info -->
            <TextBlock Text="{Binding BackupDiskThresholdText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <TextBlock Text="Warning: backup disk is below reserve threshold"
                       FontSize="11"
                       Foreground="#FF6B6B"
                       IsVisible="{Binding BackupDiskIsBelowThreshold}" />
          </StackPanel>
        </Border>

        <!-- RUNNING BACKUPS CARD (inline, below summary cards) -->
        <Expander Classes="backup-group"
                  IsExpanded="True"
                  IsVisible="{Binding IsBusy}">
          <Expander.Header>
            <!-- Header row matching history expanders -->
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="6">
                <TextBlock Text="Active backups"
                           FontSize="14"
                           FontWeight="SemiBold" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveBackups.Count, StringFormat=' • {0} active'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!-- Chevron indicator styled like other backup-group expanders -->
                <TextBlock Classes="chevron"
                           Margin="8,0,0,0"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Expander.Header>

          <Border Margin="0,6,0,0"
                  Padding="0,8,0,0"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
              <!-- Per-project progress cards -->
              <ItemsControl x:Name="ActiveBackupsList" ItemsSource="{Binding ActiveBackups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               ItemWidth="260" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,4,12,4"
                            Padding="10"
                            CornerRadius="12"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                      <StackPanel Spacing="4">
                        <!-- Project name + percentage -->
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="6">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding ProjectName}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />

                          <TextBlock Grid.Column="1"
                                     Text="{Binding Progress, StringFormat='{}{0:0}%'}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Margin="0,0,4,0" />

                          <Button Grid.Column="2"
                                  Content="Cancel"
                                  Command="{Binding CancelCommand}"
                                  Classes="small-button"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Padding="8,2"
                                  MinWidth="0"
                                  IsEnabled="{Binding CanCancel}"
                                  IsVisible="{Binding CanCancel}" />
                        </Grid>

                        <!-- Progress bar -->
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Height="4"
                                     CornerRadius="2" />

                        <!-- Current file path -->
                        <TextBlock Classes="progress-detail"
                                   Text="{Binding CurrentFile}"
                                   FontSize="11"
                                   MaxWidth="340"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <!-- ETA / speed -->
                        <TextBlock Classes="progress-detail"
                                   Text="{Binding EtaText}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsVisible="{Binding ShowEta}" />

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Fallback text if something is busy but no detailed progress items -->
              <TextBlock Text="Please wait… the backup will appear in history once completed. Do not close the app."
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Expander>

        <!-- MAIN AREA: per-project (left) + history (right) -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="16">

          <!-- PER-PROJECT BACKUPS -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="18"
                  MinWidth="360"
                  MaxWidth="520"
                  Grid.Column="0">

            <StackPanel Spacing="10">

              <!-- Section header -->
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="Per-project backups"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Back up single projects and check their status."
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </StackPanel>

              <!-- Per-project list -->
              <ListBox x:Name="PerProjectList"
                       ItemsSource="{Binding ProjectBackups}"
                       SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                       SelectionMode="Single"
                       BorderThickness="0"
                       Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="4"
                          ColumnSpacing="12">

                      <!-- Icon -->
                      <Border Grid.RowSpan="3"
                              Grid.Column="0"
                              Classes="project-icon-circle">
                        <TextBlock Text="{Binding Name[0]}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Border>

                      <!-- Row 0: project name + actions -->
                      <Grid Grid.Row="0"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <Button Content="Back up"
                                  Classes="small-button"
                                  Command="{Binding DataContext.BackupProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                          <Button Content="History"
                                  Classes="small-button"
                                  Command="{Binding DataContext.ShowProjectHistoryCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>

                      <!-- Row 1: last backup info -->
                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="6">
                        <TextBlock Text="Last backup:"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastBackupDisplay}"
                                   FontSize="11" />
                      </StackPanel>

                      <!-- Row 2: stats -->
                      <StackPanel Grid.Row="2"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="8">
                        <TextBlock Text="{Binding SnapshotCount}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="backups"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="•"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="{Binding TotalSizeFormatted}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="stored"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>

                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </StackPanel>
          </Border>

          <!-- GLOBAL HISTORY + MINI-CHART -->
          <Border Classes="card"
                  CornerRadius="18"
                  Padding="18"
                  MinWidth="360"
                  Grid.Column="1">

            <StackPanel Spacing="10">

              <!-- History header + filters -->
              <Grid ColumnDefinitions="*,Auto"
                    Margin="0,0,0,4">

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Backup history"
                             FontSize="14"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding HistoryFilterProjectLabel}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Type filter buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right">
                  <Button Content="All"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="All" />
                  <Button Content="Auto"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="Auto" />
                  <Button Content="Manual"
                          Classes="small-pill"
                          Command="{Binding FilterSnapshotsCommand}"
                          CommandParameter="Manual" />
                </StackPanel>
              </Grid>

              <!-- Separator under header -->
              <Border BorderBrush="{DynamicResource CardBorderBrush}"
                      BorderThickness="0,1,0,0"
                      Margin="0,4,0,0" />

              <!-- History grouped by project -->
              <ItemsControl ItemsSource="{Binding SnapshotGroups}"
                            Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander Classes="backup-group"
                              IsExpanded="True"
                              HorizontalAlignment="Stretch">
                      <Expander.Header>
                        <!-- Project header -->
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0"
                                      Spacing="2">
                            <!-- First row: project name + TOTAL size (top-left) -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                              <TextBlock Text="{Binding ProjectName}"
                                         FontSize="13"
                                         FontWeight="SemiBold" />
                              <TextBlock Text="{Binding TotalSizeFormatted}"
                                         FontSize="12"
                                         FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Second row: summary line -->
                            <TextBlock Text="{Binding Summary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>

                          <!-- Chevron indicator -->
                          <TextBlock Grid.Column="1"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="10"
                                     Classes="chevron"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                      </Expander.Header>

                      <!-- Backups inside this project -->
                      <Border Margin="0,6,0,0"
                              Padding="0,8,0,0"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              BorderThickness="0,1,0,0">
                        <StackPanel Spacing="4">
                          <ItemsControl ItemsSource="{Binding Snapshots}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="3"
                                      Margin="0,2,0,2">

                                  <!-- Row 0 left: label + type pill -->
                                  <StackPanel Grid.Row="0"
                                              Grid.Column="0"
                                              Orientation="Horizontal"
                                              Spacing="6">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Classes="backup-tag"
                                            Background="{Binding TagBackground}">
                                      <TextBlock Text="{Binding Type}"
                                                 FontSize="11" />
                                    </Border>
                                  </StackPanel>

                                  <!-- Row 0 right: size -->
                                  <TextBlock Grid.Row="0"
                                             Grid.Column="1"
                                             Text="{Binding SizeFormatted}"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             HorizontalAlignment="Right" />

                                  <!-- Row 1 left: timestamp -->
                                  <TextBlock Grid.Row="1"
                                             Grid.Column="0"
                                             Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />

                                  <!-- Row 1 right: actions -->
                                  <StackPanel Grid.Row="1"
                                              Grid.Column="1"
                                              Orientation="Horizontal"
                                              HorizontalAlignment="Right"
                                              Spacing="6">
                                    <Button Content="Restore"
                                            Classes="small-button"
                                            Command="{Binding DataContext.RestoreBackupCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete"
                                            Classes="small-button"
                                            Command="{Binding DataContext.DeleteBackupCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                  </StackPanel>

                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Weekly mini-activity chart -->
              <StackPanel Margin="0,4,0,0">
                <TextBlock Text="Backups per day (last 7 days)"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Spacing="4"
                            Margin="0,4,0,0">
                  <ItemsControl ItemsSource="{Binding SnapshotActivity}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Spacing="2">
                          <Border Width="8"
                                  Height="{Binding BarHeight}"
                                  Background="{Binding BarBrush}"
                                  CornerRadius="4" />
                          <TextBlock Text="{Binding DayLabel}"
                                     FontSize="10"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </Border>

        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- VERIFICATION POPUP OVERLAY -->
    <Border IsVisible="{Binding IsVerificationPopupOpen}"
            Background="#80000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360">
          <StackPanel Spacing="12">
            <TextBlock Text="Backup verification failed"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding VerificationPopupMessage}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="Keep backup"
                      MinWidth="100"
                      Command="{Binding CloseVerificationPopupCommand}" />
              <Button Content="Delete backup"
                      MinWidth="110"
                      Command="{Binding DeleteFailedBackupCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

  </Grid>
</UserControl>