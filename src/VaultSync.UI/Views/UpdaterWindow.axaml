<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    x:Class="VaultSync.UI.Views.UpdaterWindow"
    x:DataType="vm:UpdaterViewModel"
    Title="VaultSync Updater"
    Width="720"
    Height="440"
    MinWidth="600"
    MinHeight="360"
    WindowStartupLocation="CenterScreen"
    Closing="OnWindowClosing"
    Opened="OnWindowOpened">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <Border Classes="card" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding Status}"
                    Foreground="{DynamicResource TextSecondary}"
                    TextWrapping="Wrap"
                    Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="1" Height="6" Margin="0,8,0,8" IsIndeterminate="{Binding IsBusy}" />

        <Border Classes="card" Grid.Row="2" Padding="0">
            <TextBox
                Name="LogTextBox"
                Text="{Binding LogText}"
                FontFamily="Consolas"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                TextChanged="OnLogTextChanged"
                Background="Transparent"
                BorderThickness="0"
                Margin="8" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button
                Content="{Binding CloseButtonText}"
                Command="{Binding CloseCommand}"
                IsEnabled="{Binding CanClose}"
                MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
