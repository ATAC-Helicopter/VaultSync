<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
        x:Class="VaultSync.UI.Views.UpdaterWindow"
        x:DataType="vm:UpdaterViewModel"
        Title="{Binding Title}"
        Width="780"
        Height="500"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Closing="OnWindowClosing"
        Opened="OnWindowOpened">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource WindowBackground}">
    <Border Grid.Row="0"
            Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="0,0,0,1"
            Padding="26,20">
      <StackPanel Spacing="5">
        <TextBlock Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding Status}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ProgressBar Grid.Row="1"
                 Height="4"
                 IsIndeterminate="{Binding IsBusy}"
                 CornerRadius="0" />

    <Border Grid.Row="2"
            Margin="26,20"
            Background="{DynamicResource Surface0}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="14,11" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="{Binding Title}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
        </Border>
        <TextBox x:Name="LogTextBox"
                 Grid.Row="1"
                 Text="{Binding LogText}"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 TextChanged="OnLogTextChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="14" />
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="0,1,0,0"
            Padding="20,15">
      <Button Content="{Binding CloseButtonText}"
              Classes="action-primary"
              Command="{Binding CloseCommand}"
              IsEnabled="{Binding CanClose}"
              MinWidth="112"
              HorizontalAlignment="Right" />
    </Border>
  </Grid>
</Window>
