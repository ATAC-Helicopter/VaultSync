<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.MetadataSyncReviewWindow"
    x:DataType="vm:MetadataSyncReviewViewModel"
    Title="{infra:LocalizedString Key=MetadataSync.Review.Title}"
    Width="520"
    Height="420"
    MinWidth="480"
    MinHeight="360"
    WindowStartupLocation="CenterOwner"
    Opened="OnWindowOpened"
    Closing="OnWindowClosing">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,10,0,0">
            <Border Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="4" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.SourceLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.RootPath}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.StoreLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.DatabasePath}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.AddProjects}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.NewProjects}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.LinkProjects}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.LinkedProjects}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.AddSnapshots}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preview.NewSnapshots}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.AddBackups}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.NewBackups}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{infra:LocalizedString Key=MetadataSync.Review.DeleteBackups}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Preview.DeletedBackups}" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding WarningDeletesText}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       IsVisible="{Binding HasDeletes}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
            <Button Content="{infra:LocalizedString Key=MetadataSync.Review.Cancel}"
                    Command="{Binding CancelCommand}"
                    MinWidth="96" />
            <Button Content="{infra:LocalizedString Key=MetadataSync.Review.Confirm}"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
