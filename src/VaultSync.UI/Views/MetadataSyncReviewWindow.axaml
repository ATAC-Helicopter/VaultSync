<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:VaultSync.UI.ViewModels"
    xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
    x:Class="VaultSync.UI.Views.MetadataSyncReviewWindow"
    x:DataType="vm:MetadataSyncReviewViewModel"
    Title="{infra:LocalizedString Key=MetadataSync.Review.Title}"
    Width="680"
    Height="560"
    MinWidth="560"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Opened="OnWindowOpened"
    Closing="OnWindowClosing">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource WindowBackground}">
    <Border Grid.Row="0"
            Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="0,0,0,1"
            Padding="28,22">
      <StackPanel Spacing="5">
        <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.Title}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding SourceLabel}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,22" Spacing="20">
        <StackPanel Spacing="10">
          <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.SourceLabel}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <Border Background="{DynamicResource Surface1}"
                  BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16">
            <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="132,*" RowSpacing="12" ColumnSpacing="14">
              <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.SourceProjectsRoot}"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Preview.RootPath}"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimary}" />
              <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DividerBrush}" />
              <TextBlock Grid.Row="2"
                         Text="{infra:LocalizedString Key=MetadataSync.Review.StoreLabel}"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Grid.Row="2" Grid.Column="1"
                         Text="{Binding Preview.DatabasePath}"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimary}" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.Title}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <Border Background="{DynamicResource Surface1}"
                  BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="6">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
              <Border Padding="14,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Preview.NewProjects}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.AddProjects}" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Preview.LinkedProjects}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.LinkProjects}" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Padding="14,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Preview.NewSnapshots}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.AddSnapshots}" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Padding="14,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Preview.NewBackups}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.AddBackups}" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{infra:LocalizedString Key=MetadataSync.Review.DeleteBackups}"
                             Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="1" Text="{Binding Preview.DeletedBackups}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource DangerTextBrush}" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                IsVisible="{Binding HasDeletes}">
          <TextBlock Text="{Binding WarningDeletesText}"
                     Foreground="{DynamicResource DangerTextBrush}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface1}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="0,1,0,0"
            Padding="20,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="{infra:LocalizedString Key=MetadataSync.Review.Cancel}"
                Classes="action-ghost"
                Command="{Binding CancelCommand}"
                MinWidth="108" />
        <Button Content="{infra:LocalizedString Key=MetadataSync.Review.Confirm}"
                Classes="action-primary"
                Command="{Binding ConfirmCommand}"
                MinWidth="108" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
