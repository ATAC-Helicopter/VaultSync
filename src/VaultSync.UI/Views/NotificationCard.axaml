<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultSync.UI.ViewModels.Notifications"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             x:Class="VaultSync.UI.Views.Controls.NotificationCard"
             x:DataType="vm:NotificationState">
  <UserControl.Resources>
    <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    <controls:NotificationSeverityAccentConverter x:Key="NotificationSeverityAccentConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Card look -->
    <Style Selector="Border.notification-card">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="{DynamicResource CardPaddingMedium}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Severity pill -->
    <Style Selector="Border.notification-pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.notification-repeat">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="TextBlock.notification-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.notification-message">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Dismiss button -->
    <Style Selector="Button.notification-dismiss">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- Optional action button -->
    <Style Selector="Button.notification-action">
      <Setter Property="Padding" Value="{DynamicResource ButtonTightPadding}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="notification-card"
          IsVisible="{Binding IsVisible}">
    <Grid ColumnDefinitions="4,*,Auto"
          ColumnSpacing="12">
      <Border Grid.Column="0"
              CornerRadius="999"
              Background="{Binding Severity, Converter={StaticResource NotificationSeverityAccentConverter}}" />

      <StackPanel Grid.Column="1"
                  Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
          <Border Classes="notification-pill"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Severity}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>

          <TextBlock Grid.Column="1"
                     Classes="notification-title"
                     Text="{Binding Title}"
                     IsVisible="{Binding Title, Converter={StaticResource StringNotEmptyConverter}}"
                     />

          <Border Grid.Column="2"
                  Classes="notification-repeat"
                  IsVisible="{Binding HasRepeatCount}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding RepeatCountLabel}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextOnPillBrush}" />
          </Border>
        </Grid>

        <TextBlock Text="{Binding Message}"
                   Classes="notification-message" />

        <Button Classes="notification-action"
                Command="{Binding ActionCommand}"
                Content="{Binding ActionLabel}"
                IsVisible="{Binding HasAction}"
                HorizontalAlignment="Left" />
      </StackPanel>

      <Button Grid.Column="2"
              Classes="notification-dismiss"
              Command="{Binding DismissCommand}"
              Content="×"
              HorizontalAlignment="Right"
              VerticalAlignment="Top" />
    </Grid>
  </Border>
</UserControl>
