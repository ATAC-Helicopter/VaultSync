<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VaultSync.UI.ViewModels.Notifications"
             xmlns:infra="clr-namespace:VaultSync.UI.Infrastructure"
             xmlns:controls="clr-namespace:VaultSync.UI.Views.Controls"
             x:Class="VaultSync.UI.Views.Controls.NotificationCard"
             x:DataType="vm:NotificationState">
  <UserControl.Resources>
    <controls:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Card look -->
    <Style Selector="Border.notification-card">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
      <!-- Use app card background to stay on-theme -->
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Severity pill -->
    <Style Selector="Border.notification-pill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <!-- Subtle, on-theme pill instead of custom dark/blue -->
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <!-- Dismiss button -->
    <Style Selector="Button.notification-dismiss">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <!-- Optional action button -->
    <Style Selector="Button.notification-action">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Surface1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="notification-card"
          IsVisible="{Binding IsVisible}">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="12"
          VerticalAlignment="Center">

      <!-- Severity pill -->
      <Border Classes="notification-pill"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding Severity}"
                   FontSize="11"
                   FontWeight="SemiBold" />
      </Border>

      <!-- Message -->
      <StackPanel Grid.Column="1"
                  Spacing="4"
                  VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   IsVisible="{Binding Title, Converter={StaticResource StringNotEmptyConverter}}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}"
                   FontSize="12"
                   LineHeight="16"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Optional action button -->
      <Button Grid.Column="2"
              Classes="notification-action"
              Command="{Binding ActionCommand}"
              Content="{Binding ActionLabel}"
              IsVisible="{Binding HasAction}"
              VerticalAlignment="Center" />

      <!-- Dismiss button -->
      <Button Grid.Column="3"
              Classes="notification-dismiss"
              Command="{Binding DismissCommand}"
              Content="{infra:LocalizedString Key=Notifications.DismissGlyph}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
