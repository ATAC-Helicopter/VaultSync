<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <!-- DARK THEME COLORS -->
    <ResourceDictionary x:Key="Dark">
      <!-- Backgrounds -->
      <Color x:Key="VsBackgroundColor">#101218</Color>
      <Color x:Key="VsCardColor">#181B24</Color>
      <Color x:Key="VsCardHighlightColor">#222635</Color>

      <!-- Text -->
      <Color x:Key="VsTextPrimaryColor">#FFFFFF</Color>
      <Color x:Key="VsTextSecondaryColor">#B3B8C7</Color>
      <Color x:Key="VsTextMutedColor">#949BB3</Color>

      <!-- Accents -->
      <Color x:Key="VsAccentColor">#4F8DFF</Color>
      <Color x:Key="VsAccentSoftColor">#334F8DFF</Color>
      <Color x:Key="VsTextOnAccentColor">#11131A</Color>

      <!-- Status / semantic (BRIGHTER) -->
      <Color x:Key="VsSuccessColor">#4FF2B6</Color>
      <Color x:Key="VsWarningColor">#FFC766</Color>
      <Color x:Key="VsDangerColor">#FF7676</Color>
      <Color x:Key="VsSuccessSoftColor">#334FF2B6</Color>
      <Color x:Key="VsWarningSoftColor">#33FFC766</Color>
      <Color x:Key="VsDangerSoftColor">#33FF7676</Color>

      <!-- Input + borders -->
      <Color x:Key="VsInputBackgroundColor">#1F2230</Color>
      <Color x:Key="VsInputBorderColor">#353A4C</Color>
      <Color x:Key="VsInputBorderFocusedColor">#4F8DFF</Color>
      <Color x:Key="VsDividerColor">#303548</Color>
      <Color x:Key="VsShellBrandStartColor">#10203A</Color>
      <Color x:Key="VsShellBrandEndColor">#22335A</Color>
      <Color x:Key="VsShellBrandTextColor">#FFFFFF</Color>
    </ResourceDictionary>

    <!-- LIGHT THEME COLORS -->
    <ResourceDictionary x:Key="Light">
      <!-- Backgrounds -->
      <Color x:Key="VsBackgroundColor">#F4F5F9</Color>
      <Color x:Key="VsCardColor">#FFFFFF</Color>
      <Color x:Key="VsCardHighlightColor">#E6E9F2</Color>

      <!-- Text -->
      <Color x:Key="VsTextPrimaryColor">#11131A</Color>
      <Color x:Key="VsTextSecondaryColor">#5C6275</Color>
      <Color x:Key="VsTextMutedColor">#626A80</Color>

      <!-- Accents -->
      <Color x:Key="VsAccentColor">#2663FF</Color>
      <Color x:Key="VsAccentSoftColor">#1A2663FF</Color>
      <Color x:Key="VsTextOnAccentColor">#FFFFFF</Color>

      <!-- Status / semantic (BRIGHTER) -->
      <Color x:Key="VsSuccessColor">#087F5B</Color>
      <Color x:Key="VsWarningColor">#996000</Color>
      <Color x:Key="VsDangerColor">#C22D40</Color>
      <Color x:Key="VsSuccessSoftColor">#2432DFA0</Color>
      <Color x:Key="VsWarningSoftColor">#24FFBF5F</Color>
      <Color x:Key="VsDangerSoftColor">#24FF6A6A</Color>

      <!-- Input + borders -->
      <Color x:Key="VsInputBackgroundColor">#F5F6FB</Color>
      <Color x:Key="VsInputBorderColor">#D0D4E2</Color>
      <Color x:Key="VsInputBorderFocusedColor">#2663FF</Color>
      <Color x:Key="VsDividerColor">#D9DCE8</Color>
      <Color x:Key="VsShellBrandStartColor">#E3E7FF</Color>
      <Color x:Key="VsShellBrandEndColor">#CCD4E9</Color>
      <Color x:Key="VsShellBrandTextColor">#11131A</Color>
      <Color x:Key="VsShellHeaderColor">#FFFFFF</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Background surfaces -->
  <SolidColorBrush x:Key="VsBackgroundBrush" Color="{DynamicResource VsBackgroundColor}" />
  <SolidColorBrush x:Key="VsCardBrush" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="VsCardHighlightBrush" Color="{DynamicResource VsCardHighlightColor}" />

  <!-- Text brushes -->
  <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource VsTextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource VsTextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource VsTextMutedColor}" />

  <SolidColorBrush x:Key="ShellBrandStartBrush" Color="{DynamicResource VsShellBrandStartColor}" />
  <SolidColorBrush x:Key="ShellBrandEndBrush" Color="{DynamicResource VsShellBrandEndColor}" />

  <!-- Accent brushes -->
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource VsAccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource VsAccentSoftColor}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{DynamicResource VsAccentSoftColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource VsTextOnAccentColor}" />

  <!-- Status / semantic brushes -->
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource VsSuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource VsWarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource VsDangerColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{DynamicResource VsSuccessSoftColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource VsWarningSoftColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource VsDangerSoftColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{DynamicResource VsDangerColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource VsWarningColor}" />

  <!-- Input + borders -->
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource VsInputBackgroundColor}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource VsInputBorderColor}" />
  <SolidColorBrush x:Key="InputBorderFocusedBrush" Color="{DynamicResource VsInputBorderFocusedColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource VsDividerColor}" />

  <!-- Scrims + shadows -->
  <SolidColorBrush x:Key="OverlayScrimBrush" Color="#80000000" />
  <SolidColorBrush x:Key="ShadowSoftBrush" Color="#20000000" />
  <SolidColorBrush x:Key="ShadowStrongBrush" Color="#CC000000" />

  <!-- Window background -->
  <SolidColorBrush x:Key="WindowBackground" Color="{DynamicResource VsBackgroundColor}" />
  <SolidColorBrush x:Key="ShellNavigationBrush" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="ShellToolbarBrush" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="GlassFloatingBrush" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="GlassControlBrush" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="GlassRimBrush" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="GlassRimSoftBrush" Color="{DynamicResource VsDividerColor}" />
  <SolidColorBrush x:Key="GlassReflectionBrush" Color="Transparent" />
  <SolidColorBrush x:Key="GlassAmbientGlowBrush" Color="Transparent" />

  <!-- Surfaces: sidebar/header/card stacks -->
  <SolidColorBrush x:Key="Surface0" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="Surface1" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="Surface2" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="Surface3" Color="{DynamicResource VsCardHighlightColor}" />

  <!-- Soft border for cards + separators -->
  <SolidColorBrush x:Key="BorderSoft" Color="{DynamicResource VsCardHighlightColor}" />

  <!-- Text alias brushes used throughout views -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource VsTextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource VsTextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource VsTextMutedColor}" />

  <SolidColorBrush x:Key="ShellHeaderTextBrush" Color="{DynamicResource VsShellBrandTextColor}" />
  <SolidColorBrush x:Key="ShellBrandTextBrush" Color="{DynamicResource VsShellBrandTextColor}" />

  <!-- Card + surface aliases -->
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="CardSelectedBrush" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="{DynamicResource VsCardHighlightColor}" />
  <SolidColorBrush x:Key="SurfaceCardBrush" Color="{DynamicResource VsCardColor}" />
  <SolidColorBrush x:Key="ItemBg" Color="{DynamicResource VsCardColor}" />

  <!-- Buttons / pills -->
  <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{DynamicResource VsTextOnAccentColor}" />
  <SolidColorBrush x:Key="PillBackgroundBrush" Color="{DynamicResource VsSuccessColor}" />
  <!-- New: no visible outline, but available if ever needed -->
  <SolidColorBrush x:Key="PillBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="TextOnPillBrush" Color="{DynamicResource VsTextOnAccentColor}" />

  <!-- Charts and subtle lines -->
  <SolidColorBrush x:Key="SubtleAxisBrush" Color="{DynamicResource VsDividerColor}" />

  <!-- Legends -->
  <SolidColorBrush x:Key="LegendIncreaseBrush" Color="{DynamicResource VsDangerColor}" />
  <SolidColorBrush x:Key="LegendDecreaseBrush" Color="{DynamicResource VsSuccessColor}" />
  <SolidColorBrush x:Key="LegendUnchangedBrush" Color="{DynamicResource VsTextSecondaryColor}" />

</ResourceDictionary>
