<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The binary protocol has no localized UI and must start on minimal offline media. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VaultSync.Core\VaultSync.Core.csproj">
      <!-- Match the desktop's explicit Core target negotiation during RID publish. -->
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>TargetFramework=net10.0</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
