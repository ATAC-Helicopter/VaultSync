<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core storage and platform APIs -->
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />

    <!-- CLI -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />

    <!-- Avalonia UI -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />

    <!-- Text and rendering native assets -->
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.157.0" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0.200" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.200" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.4.0.200" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0.200" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.4.0.200" />

    <!-- Windows-only UI integrations -->
    <PackageVersion Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <!-- Overrides the toolkit's vulnerable legacy transitive version. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.15" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.analyzers" Version="2.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
