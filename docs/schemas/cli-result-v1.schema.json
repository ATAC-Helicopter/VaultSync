{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VaultSync CLI result v1",
  "type": "object",
  "required": ["schemaVersion", "operation", "status", "data", "error", "exitCode"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "error"]},
    "data": {"type": ["object", "null"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["code", "message"], "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }}
      ]
    },
    "exitCode": {"type": "integer", "minimum": 0}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "success"}}},
    "then": {"properties": {"data": {"type": "object"}, "error": {"type": "null"}, "exitCode": {"const": 0}}},
    "else": {"properties": {"data": {"type": "null"}, "error": {"type": "object"}, "exitCode": {"minimum": 1}}}
  }]
}
