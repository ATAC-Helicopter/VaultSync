<Project>
  <PropertyGroup>
    <!-- Self-contained releases must resolve at least this security-serviced runtime. -->
    <VaultSyncMinimumRuntimeVersion>10.0.11</VaultSyncMinimumRuntimeVersion>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent generated build artifacts under per-project artifacts/ from being compiled as source -->
    <Compile Remove="**/artifacts/**/*.cs" />
    <EmbeddedResource Remove="**/artifacts/**/*.resx" />
    <None Remove="**/artifacts/tmpobj/**" />
    <Content Remove="**/artifacts/tmpobj/**" />
  </ItemGroup>
</Project>
