<Project>
  <PropertyGroup>
    <!-- Pin ASP.NET Core runtime packs to a patched servicing release for self-contained RID restores. -->
    <MicrosoftAspNetCoreAppRuntimePackageVersion>10.0.9</MicrosoftAspNetCoreAppRuntimePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent generated build artifacts under per-project artifacts/ from being compiled as source -->
    <Compile Remove="**/artifacts/**/*.cs" />
    <EmbeddedResource Remove="**/artifacts/**/*.resx" />
    <None Remove="**/artifacts/tmpobj/**" />
    <Content Remove="**/artifacts/tmpobj/**" />
  </ItemGroup>
</Project>
